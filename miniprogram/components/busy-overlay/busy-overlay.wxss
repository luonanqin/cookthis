.busy-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(252, 249, 242, 0.55);
  pointer-events: auto;
}

.busy-overlay__panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
}

.busy-overlay__gif {
  width: 160rpx;
  height: 160rpx;
}

.busy-overlay__tip {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  line-height: 1.4;
  text-align: center;
}
