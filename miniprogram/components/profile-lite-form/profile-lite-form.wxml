<block wx:if="{{showCity}}">
  <view class="sheet-title">所在城市</view>
  <picker mode="region" level="city" value="{{region}}" bindchange="onRegionChange">
    <view class="picker-row">{{city || '点此选择城市匹配当地食材'}}</view>
  </picker>
</block>

<view class="sheet-title {{showCity ? 'sheet-title-follow' : ''}}">{{title}}</view>

<view class="chip-row">
  <view
    wx:if="{{showNoneAvoids}}"
    class="chip {{noneAvoidChecked ? 'chip-on' : ''}}"
    data-id="none"
    bindtap="onAvoidToggle"
  >无</view>
  <view
    wx:for="{{liteAvoidOptions}}"
    wx:key="id"
    class="chip {{liteAvoidChecked[item.id] ? 'chip-on' : ''}}"
    data-id="{{item.id}}"
    bindtap="onAvoidToggle"
  >{{item.label}}</view>
</view>

<view class="lite-actions">
  <button class="lite-btn" bindtap="onSkip">{{secondaryText}}</button>
  <button class="lite-btn lite-btn-primary" bindtap="onSave">{{primaryText}}</button>
</view>
