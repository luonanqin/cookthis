.sheet-title {
  font-weight: 600;
  font-size: var(--fs-title);
  color: var(--color-text);
}

.sheet-title-follow {
  margin-top: 28rpx;
}

.picker-row {
  margin-top: 12rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  font-size: var(--fs-body);
  color: var(--color-text);
  box-sizing: border-box;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.chip {
  padding: 12rpx 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: var(--fs-sm);
  color: var(--color-text);
  box-sizing: border-box;
}

.chip-on {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

/* 系统弹窗式底栏：跳过 | 保存 横排均分 */
.lite-actions {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  margin: 28rpx -28rpx -28rpx;
  border-top: 1rpx solid var(--color-border);
}

.lite-btn {
  flex: 1;
  margin: 0 !important;
  padding: 0 !important;
  height: 96rpx;
  line-height: 96rpx;
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--color-text);
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
}

.lite-btn::after {
  border: none !important;
}

.lite-btn + .lite-btn {
  border-left: 1rpx solid var(--color-border) !important;
}

.lite-btn-primary {
  color: var(--color-primary) !important;
  font-weight: 600;
}

.lite-btn.button-hover {
  background: var(--color-bg) !important;
}
