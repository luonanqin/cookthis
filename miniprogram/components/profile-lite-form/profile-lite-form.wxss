.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.chip {
  padding: 12rpx 22rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: var(--fs-sm);
  color: var(--color-text);
}

.chip-on {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.link {
  color: var(--color-primary);
  font-size: var(--fs-body);
}

.lite-more {
  margin-top: 8rpx;
  font-size: var(--fs-sm);
}

.none-avoids {
  margin-top: 16rpx;
  font-size: var(--fs-body);
}

.field-label {
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.lite-love-label {
  margin-top: 24rpx;
  margin-bottom: 8rpx;
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
}
