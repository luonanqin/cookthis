page {
  /* Design System tokens (暖奶油 + 菜场绿) */
  --ds-color-canvas: #fcf9f2;
  --ds-color-header: #fefcf7;
  --ds-color-surface: #fffefa;
  --ds-color-surface-soft: #f7f4ec;
  --ds-color-forest: #0a2b26;
  --ds-color-text: #27332e;
  --ds-color-text-secondary: #748078;
  --ds-color-text-muted: #a1afaa;
  --ds-color-primary: #527f55;
  --ds-color-primary-pressed: #426b47;
  --ds-color-selected: #edf5e3;
  --ds-color-coral: #ec947d;
  --ds-color-coral-soft: #fbe6e1;
  --ds-color-border: #e7e5dc;
  --ds-color-mask: rgba(20, 37, 31, 0.42);

  --ds-radius-control: 8rpx;
  --ds-radius-chip: 16rpx;
  --ds-radius-tile: 18rpx;
  --ds-radius-card: 24rpx;
  --ds-radius-dialog: 28rpx;
  --ds-radius-pill: 999rpx;

  /* Legacy aliases → DS（页面继续用 --color-* 不致全量改名） */
  --color-primary: var(--ds-color-primary);
  --color-primary-pressed: var(--ds-color-primary-pressed);
  --color-primary-soft: var(--ds-color-selected);
  --color-bg: var(--ds-color-canvas);
  --color-header: var(--ds-color-header);
  --color-surface: var(--ds-color-surface);
  --color-surface-soft: var(--ds-color-surface-soft);
  --color-forest: var(--ds-color-forest);
  --color-text: var(--ds-color-text);
  --color-text-secondary: var(--ds-color-text-secondary);
  --color-text-muted: var(--ds-color-text-muted);
  --color-coral: var(--ds-color-coral);
  --color-coral-soft: var(--ds-color-coral-soft);
  --color-border: var(--ds-color-border);
  --color-mask: var(--ds-color-mask);

  --radius-btn: 20rpx;
  --radius-sheet: var(--ds-radius-dialog);
  --radius-card: var(--ds-radius-card);
  --radius-chip: var(--ds-radius-chip);
  --radius-tile: var(--ds-radius-tile);
  --radius-pill: var(--ds-radius-pill);
  --radius-control: var(--ds-radius-control);

  /* Type scale (normal) */
  --fs-xxs: 20rpx;
  --fs-xs: 22rpx;
  --fs-sm: 24rpx;
  --fs-md: 26rpx;
  --fs-body: 28rpx;
  --fs-btn: 30rpx;
  --fs-title: 32rpx;
  --fs-lead: 36rpx;
  --fs-brand: 52rpx;
  --fs-page-title: 48rpx;
  --fs-caption: var(--fs-sm);

  background: var(--color-bg);
  color: var(--color-text);
  font-size: var(--fs-body);
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', sans-serif;
}

/* Large type: put class on page root wrapper (inherits to descendants) */
.large-text {
  --fs-xxs: 24rpx;
  --fs-xs: 28rpx;
  --fs-sm: 30rpx;
  --fs-md: 34rpx;
  --fs-body: 36rpx;
  --fs-btn: 38rpx;
  --fs-title: 40rpx;
  --fs-lead: 44rpx;
  --fs-brand: 64rpx;
  --fs-page-title: 56rpx;
  font-size: var(--fs-body);
}

.large-text button[size='mini'] {
  padding: 0 28rpx;
  line-height: 2.15;
}

/* Shared primary / outline buttons */
button {
  font-size: var(--fs-btn);
  border-radius: var(--radius-btn) !important;
  font-weight: 500;
}

button[type='primary'] {
  background: var(--color-primary) !important;
  color: #fff !important;
  border: none !important;
}

button[type='primary']::after {
  border: none !important;
}

button.btn-outline {
  background: var(--color-surface) !important;
  color: var(--color-primary) !important;
  border: 2rpx solid var(--color-primary) !important;
}

button.btn-outline::after {
  border: none !important;
}

button.btn-coral {
  background: var(--color-coral) !important;
  color: #fff !important;
  border: none !important;
}

button.btn-coral::after {
  border: none !important;
}

button.btn-coral.button-hover {
  background: #d9826c !important;
}

button[size='mini'] {
  font-size: var(--fs-sm);
  padding: 0 24rpx;
  line-height: 2;
}

/* Press feedback: WeChat default hover-class is button-hover */
button.button-hover {
  background-color: #e8ebe9 !important;
  opacity: 1 !important;
}

button[type='primary'].button-hover {
  background: var(--color-primary-pressed) !important;
}

button.btn-outline.button-hover {
  background: var(--color-primary-soft) !important;
}

/* view / text tap targets: set hover-class="tap-hover" */
.tap-hover {
  opacity: 0.72 !important;
}

/* Shared bottom sheet */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--color-mask);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

/* 居中窄弹窗（如「食材不够出菜了」） */
.mask.mask-center {
  align-items: center;
  justify-content: center;
  padding: 48rpx 120rpx;
  box-sizing: border-box;
  z-index: 30;
}

.dialog {
  width: 100%;
  max-width: 400rpx;
  background: var(--color-surface);
  border-radius: var(--radius-sheet);
  padding: 0;
  box-sizing: border-box;
  overflow: hidden;
}

/* 居中表单浮层（忌口轻量补全等） */
.mask.mask-lite {
  padding: 48rpx 40rpx;
}

.lite-dialog {
  width: 100%;
  max-width: 640rpx;
  background: var(--color-surface);
  border-radius: var(--radius-sheet);
  padding: 32rpx 28rpx 28rpx;
  box-sizing: border-box;
  max-height: 80vh;
  overflow-y: auto;
}

.dialog-title {
  text-align: center;
  font-weight: 600;
  font-size: var(--fs-title);
  color: var(--color-text);
  line-height: 1.4;
  padding: 40rpx 28rpx 36rpx;
}

.dialog-actions {
  margin-top: 0;
  display: flex;
  justify-content: stretch;
  border-top: 1rpx solid var(--color-border);
}

.dialog-btn {
  margin: 0 !important;
  width: 100% !important;
  min-width: 0 !important;
  padding: 0 !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: var(--fs-btn) !important;
  font-weight: 500;
  color: var(--color-primary) !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  display: block !important;
}

.dialog-btn::after {
  border: none !important;
}

.dialog-btn.button-hover {
  background: var(--color-primary-soft) !important;
}

.sheet {
  width: 100%;
  background: var(--color-surface);
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 70vh;
  overflow-y: auto;
}

.sheet-title {
  font-weight: 600;
  font-size: var(--fs-title);
  color: var(--color-text);
}

.sheet-hint,
.transcript {
  color: var(--color-text-secondary);
  font-size: var(--fs-sm);
  margin: 10rpx 0 16rpx;
}

.sheet-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.sheet-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: var(--fs-body);
  color: var(--color-text);
}

.sheet-row.on {
  color: var(--color-primary);
}

.sheet-row .check {
  width: 40rpx;
  margin-right: 12rpx;
  color: var(--color-primary);
}

/* 内页主体：页眉下内容区通用间距 */
.page-body {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 内页底栏主按钮：对齐「我的偏好」（居中 360rpx）；mini 多按钮底栏除外 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
}

.footer > button:not([size='mini']) {
  margin: 0 !important;
  width: 360rpx !important;
  height: 88rpx !important;
  padding: 0 !important;
  line-height: 1.2 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
}

.surface-card {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(39, 51, 46, 0.05);
}

/* Shared image icon utilities */
.ui-icon {
  display: block;
  flex-shrink: 0;
}

.ui-icon--xs { width: 30rpx; height: 30rpx; }
.ui-icon--sm { width: 40rpx; height: 40rpx; }
.ui-icon--md { width: 52rpx; height: 52rpx; }
.ui-icon--lg { width: 64rpx; height: 64rpx; }
