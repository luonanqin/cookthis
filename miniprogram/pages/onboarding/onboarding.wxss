.page {
  padding: 32rpx 28rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

.progress {
  color: var(--color-text-secondary);
  font-size: var(--fs-sm);
  margin-bottom: 24rpx;
}

.title {
  font-size: var(--fs-lead);
  font-weight: 600;
  margin-bottom: 8rpx;
  color: var(--color-text);
}

.hint,
.sub {
  color: var(--color-text-secondary);
  font-size: var(--fs-sm);
  margin: 16rpx 0 12rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: var(--fs-sm);
  color: var(--color-text);
}

.chip.on {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.chip-hover {
  opacity: 0.85;
}

.input {
  background: var(--color-surface);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid var(--color-border);
}

.combo {
  display: flex;
  gap: 12rpx;
}

.picker-row,
.picker-cell {
  background: var(--color-surface);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: var(--fs-body);
  margin-bottom: 12rpx;
}

.picker-cell {
  flex: 1;
  text-align: center;
  margin-bottom: 0;
}

.combo picker {
  flex: 1;
}

.large-text .picker-row,
.large-text .picker-cell {
  min-height: 96rpx;
  padding: 24rpx 24rpx;
  font-size: var(--fs-title);
  box-sizing: border-box;
}

.form-row {
  margin-bottom: 16rpx;
}

.form-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
}

.actions {
  margin-top: 48rpx;
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  flex-wrap: wrap;
}
.skip-hint {
  margin-top: 16rpx;
  font-size: var(--fs-xs);
  color: #999;
  text-align: right;
}
