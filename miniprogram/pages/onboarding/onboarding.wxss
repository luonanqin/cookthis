.page {
  padding: 32rpx 28rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f7f7;
}
.progress {
  color: #888;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.hint,
.sub {
  color: #666;
  font-size: 24rpx;
  margin: 16rpx 0 12rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  padding: 12rpx 20rpx;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 24rpx;
}
.chip.on {
  border-color: #2e7d32;
  color: #2e7d32;
  background: #e8f5e9;
}
.input {
  background: #fff;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}
.combo {
  display: flex;
  gap: 12rpx;
}
.small {
  flex: 1;
  background: #fff;
  padding: 16rpx;
  border-radius: 8rpx;
}
.form-row {
  margin-bottom: 16rpx;
}
.form-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}
.actions {
  margin-top: 48rpx;
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
