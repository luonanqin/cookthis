/* 与 pages/mine/mine.wxss 偏好区视觉对齐；家庭成员步另含页内展开/收起 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
}

.wrap {
  padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 24rpx;
  box-sizing: border-box;
  background: var(--color-bg);
}

.progress {
  color: var(--color-text-secondary);
  font-size: var(--fs-sm);
}

.section {
  margin-top: 12rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: var(--fs-lead);
  font-weight: 600;
  margin-bottom: 0;
  color: var(--color-forest);
  flex-shrink: 0;
}

.section-aside {
  flex: 1;
  min-width: 0;
  margin-top: 4rpx;
  text-align: right;
  font-size: var(--fs-caption);
  line-height: 1.35;
  color: var(--color-text-secondary, #888);
}

.hint,
.sub {
  color: var(--color-text-secondary, #888);
  font-size: var(--fs-caption);
  margin: 8rpx 0 12rpx;
}

.household {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: var(--fs-sm);
  color: var(--color-text);
}

.chip.on {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.chip.on-avoid {
  border-color: #e54d42;
  color: #e54d42;
  background: #fdecea;
}

.chip-mini {
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-size: var(--fs-caption);
  line-height: 1.3;
}

.editor-input-box {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 6rpx;
  margin: 12rpx 0 16rpx;
  padding: 8rpx 12rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.editor-input-field {
  flex: 0 0 72rpx;
  width: 72rpx;
  max-width: 72rpx;
  min-width: 0;
  overflow: hidden;
}

.editor-input-inner {
  display: block;
  width: 72rpx;
  max-width: 72rpx;
  height: 44rpx;
  padding: 0;
  margin: 0;
  font-size: var(--fs-body);
  color: var(--color-text);
}

.editor-input-quicks {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
}

.form-label {
  display: block;
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.chips + .form-label {
  margin-top: 16rpx;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.form-name {
  flex: 0 0 88rpx;
  width: 88rpx;
  font-size: var(--fs-md);
  color: var(--color-text);
  line-height: 1.3;
}

.form-radios {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.form-radio {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--fs-sm);
  color: var(--color-text);
  min-width: 0;
}

.form-radio radio {
  transform: scale(0.82);
  margin-right: 0;
}

.picker-row {
  background: var(--color-surface);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: var(--fs-body);
}

.combo-row {
  display: flex;
  gap: 12rpx;
}

.combo-row picker {
  flex: 1;
}

.picker-cell {
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 12rpx;
  text-align: center;
  background: var(--color-surface);
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  font-size: var(--fs-body);
  color: var(--color-text);
  box-sizing: border-box;
}

.large-text .picker-row {
  min-height: 96rpx;
  padding: 24rpx 24rpx;
  font-size: var(--fs-title);
  box-sizing: border-box;
}

/* —— 家庭成员：收起摘要（对齐「我的」） / 展开表单 —— */
.member-block {
  margin-bottom: 8rpx;
}

.member-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.member-main {
  flex: 1;
  min-width: 0;
}

.member-name {
  display: block;
  font-size: var(--fs-body);
  color: var(--color-text);
  font-weight: 500;
}

.member-meta {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
}

.member-del {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  padding: 8rpx 12rpx;
}

.member-editor {
  padding: 16rpx 0 20rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.member-editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.member-editor-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text);
}

.title-warn {
  color: #e54d42 !important;
}

.title-pulse {
  display: inline-block;
  animation: title-flash 0.45s ease 2;
}

@keyframes title-flash {
  0%,
  100% {
    transform: scale(1);
  }
  35% {
    transform: scale(0.88);
  }
  65% {
    transform: scale(1.06);
  }
}

.link-inline {
  margin-top: 12rpx;
  font-size: var(--fs-body);
  color: var(--color-primary);
}

/* 引导底栏：多按钮均分宽度，高度与全站一致；单按钮时居中 */
.footer {
  justify-content: center;
  gap: 12rpx;
  flex-wrap: nowrap;
}

.footer > button {
  margin: 0 !important;
  flex: 1 1 0 !important;
  width: 0 !important;
  min-width: 0 !important;
  max-width: none !important;
  height: 88rpx !important;
  padding: 0 12rpx !important;
  line-height: 1.2 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
  font-size: var(--fs-body) !important;
  font-weight: 600 !important;
  border-radius: var(--radius-btn) !important;
}

.footer-primary {
  flex: 1.15 1 0 !important;
}

/* 仅「下一步」时与其他页单主按钮同宽 */
.footer > button:only-child {
  flex: 0 0 360rpx !important;
  width: 360rpx !important;
}
