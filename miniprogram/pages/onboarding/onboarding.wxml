<view class="page {{typeScaleClass}}">
  <page-header title="开始设置" subtitle="先记下家里几口人、忌口和口味" show-back="{{false}}" />
  <view class="wrap">
  <view class="progress">步骤 {{step + 1}} / {{steps.length}} · {{steps[step]}}</view>

  <block wx:if="{{step === 0}}">
    <view class="section">
      <view class="section-title">家庭成员</view>
      <view class="household">{{householdPreview}}</view>

      <view class="member-block" wx:for="{{draftMembers}}" wx:key="key">
        <!-- 收起：同「我的」摘要行 -->
        <view
          wx:if="{{expandedKey !== item.key}}"
          class="member-card"
          data-key="{{item.key}}"
          bindtap="onExpandMember"
        >
          <view class="member-main">
            <text class="member-name">{{item.title}}</text>
            <text class="member-meta">{{item.ageLabel}} · {{item.tasteLabel}} · 忌口{{item.avoidLabel}}</text>
          </view>
          <text
            class="member-del"
            wx:if="{{draftMembers.length > 1}}"
            data-key="{{item.key}}"
            catchtap="onRemoveMember"
          >删</text>
        </view>

        <!-- 展开：完整表单，无确定按钮 -->
        <view wx:else class="member-editor">
          <view class="member-editor-head">
            <text class="member-editor-title">{{item.title}}</text>
            <text
              class="member-del"
              wx:if="{{draftMembers.length > 1}}"
              data-key="{{item.key}}"
              catchtap="onRemoveMember"
            >删</text>
          </view>
          <text
            class="form-label {{item.warnFields.name ? 'title-warn' : ''}} {{item.warnFields.name && item.warnPulse ? 'title-pulse' : ''}}"
          >称呼</text>
          <view class="editor-input-box">
            <view class="editor-input-field">
              <input
                class="editor-input-inner"
                style="width: 72rpx;"
                placeholder="称呼"
                value="{{item.name}}"
                data-key="{{item.key}}"
                bindinput="onMemberName"
              />
            </view>
            <view class="editor-input-quicks">
              <view
                class="chip chip-mini"
                wx:for="{{item.nameQuickOptions}}"
                wx:for-item="qn"
                wx:key="*this"
                data-key="{{item.key}}"
                data-name="{{qn}}"
                bindtap="onPickQuickName"
              >{{qn}}</view>
            </view>
          </view>
          <text
            class="form-label {{item.warnFields.age ? 'title-warn' : ''}} {{item.warnFields.age && item.warnPulse ? 'title-pulse' : ''}}"
          >年龄段</text>
          <view class="chips">
            <view
              class="chip {{item.ageBand === ab.id ? 'on' : ''}}"
              wx:for="{{ageBands}}"
              wx:for-item="ab"
              wx:key="id"
              data-key="{{item.key}}"
              data-id="{{ab.id}}"
              bindtap="onPickAge"
            >{{ab.label}}</view>
          </view>
          <text class="form-label">口味</text>
          <view class="chips">
            <view
              class="chip {{item.taste === tb.id ? 'on' : ''}}"
              wx:for="{{tastes}}"
              wx:for-item="tb"
              wx:key="id"
              data-key="{{item.key}}"
              data-id="{{tb.id}}"
              bindtap="onPickTaste"
            >{{tb.label}}</view>
          </view>
          <text
            class="form-label {{item.warnFields.avoids ? 'title-warn' : ''}} {{item.warnFields.avoids && item.warnPulse ? 'title-pulse' : ''}}"
          >个人忌口</text>
          <view class="chips">
            <view
              class="chip {{item.avoidsNone ? 'on' : ''}}"
              data-key="{{item.key}}"
              data-id="none"
              bindtap="onToggleMemberAvoid"
            >无</view>
            <view
              class="chip {{item.avoidChecked[ao.id] ? 'on' : ''}}"
              wx:for="{{avoidOptions}}"
              wx:for-item="ao"
              wx:key="id"
              data-key="{{item.key}}"
              data-id="{{ao.id}}"
              bindtap="onToggleMemberAvoid"
            >{{ao.label}}</view>
          </view>
        </view>
      </view>

      <view class="link-inline" bindtap="onAddMember">＋ 添加家庭成员</view>
    </view>
  </block>

  <block wx:elif="{{step === 1}}">
    <view class="section">
      <view class="section-title">日常搭配</view>
      <view class="household">{{householdPreview}}</view>
      <view class="combo-row">
        <picker mode="selector" range="{{comboRange}}" value="{{meatIndex}}" data-field="meat" bindchange="onComboPick">
          <view class="picker-cell">荤 {{meat}}</view>
        </picker>
        <picker mode="selector" range="{{comboRange}}" value="{{vegIndex}}" data-field="veg" bindchange="onComboPick">
          <view class="picker-cell">素 {{veg}}</view>
        </picker>
        <picker mode="selector" range="{{comboRange}}" value="{{soupIndex}}" data-field="soup" bindchange="onComboPick">
          <view class="picker-cell">汤 {{soup}}</view>
        </picker>
      </view>
    </view>
  </block>

  <block wx:elif="{{step === 2}}">
    <view class="section">
      <view class="section-title">家庭忌口</view>
      <view class="chips">
        <view
          class="chip {{noneAvoidChecked ? 'on' : ''}}"
          data-id="none"
          bindtap="onToggleFamilyAvoid"
        >无</view>
        <view
          class="chip {{familyAvoidChecked[item.id] ? 'on' : ''}}"
          wx:for="{{avoidOptions}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onToggleFamilyAvoid"
        >{{item.label}}</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{step === 3}}">
    <view class="section">
      <view class="section-title">所在城市</view>
      <view class="hint">仅用于匹配当地常见食材</view>
      <picker mode="region" level="city" value="{{region}}" bindchange="onRegionChange">
        <view class="picker-row">{{city || '点此选择城市匹配当地食材'}}</view>
      </picker>
    </view>
  </block>

  <block wx:elif="{{step === 4}}">
    <view class="section">
      <view class="section-title">哪些菜你做得来？</view>
      <view class="hint">做过的，或没做过但觉得简单的，都勾上就行</view>
      <block wx:for="{{probeGroups}}" wx:key="id">
        <view class="sub">{{item.title}}</view>
        <view class="chips">
          <view
            class="chip {{probeChecked[dish.id] ? 'on' : ''}}"
            wx:for="{{item.dishes}}"
            wx:for-item="dish"
            wx:key="id"
            data-id="{{dish.id}}"
            bindtap="onToggleProbeDish"
          >{{dish.name}}</view>
        </view>
      </block>
    </view>
  </block>

  <block wx:elif="{{step === 5}}">
    <view class="section">
      <view class="section-title">菜系偏好</view>
      <view class="chips">
        <view
          class="chip {{cuisineOkChecked ? 'on' : ''}}"
          bindtap="onToggleCuisineOk"
        >都还行</view>
      </view>
      <view class="sub">喜欢</view>
      <view class="chips">
        <view
          class="chip {{cuisinePrefs[item.id] === 'prefer' ? 'on' : ''}}"
          wx:for="{{cuisineOptions}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onCuisinePrefer"
        >{{item.label}}</view>
      </view>
      <view class="sub">不喜欢</view>
      <view class="chips">
        <view
          class="chip {{cuisinePrefs[item.id] === 'avoid' ? 'on-avoid' : ''}}"
          wx:for="{{cuisineOptions}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onCuisineAvoid"
        >{{item.label}}</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="section">
      <view class="section-title">菜式偏好</view>
      <view class="form-row" wx:for="{{formOptions}}" wx:key="id">
        <text class="form-name">{{item.label}}</text>
        <radio-group
          class="form-radios"
          data-tag="{{item.id}}"
          bindchange="onFormPrefRadio"
        >
          <label
            class="form-radio"
            wx:for="{{formValues}}"
            wx:for-item="v"
            wx:key="id"
          >
            <radio
              value="{{v.id}}"
              checked="{{dishFormPrefs[item.id] === v.id}}"
              color="#3a8a5f"
            />
            <text>{{v.label}}</text>
          </label>
        </radio-group>
      </view>
    </view>
  </block>

  <view class="footer">
    <button
      wx:if="{{step > 0}}"
      class="btn-outline footer-secondary"
      disabled="{{busy}}"
      bindtap="onSkip"
    >跳过</button>
    <button
      wx:if="{{step > 0}}"
      class="btn-outline footer-secondary"
      bindtap="onBackStep"
    >上一步</button>
    <button
      type="primary"
      class="footer-primary"
      loading="{{busy}}"
      disabled="{{busy}}"
      bindtap="onNext"
    >{{step >= steps.length - 1 ? '完成' : '下一步'}}</button>
  </view>
  </view>
</view>
