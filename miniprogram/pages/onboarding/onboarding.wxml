<view class="page {{typeScaleClass}}">
  <view class="progress">步骤 {{step + 1}} / 5 · {{steps[step]}}</view>

  <block wx:if="{{step === 0}}">
    <view class="title">家里有什么忌口？</view>
    <view class="hint">会硬排除相关菜（可跳过）</view>
    <view class="chips">
      <view
        class="chip {{familyAvoidChecked[item.id] ? 'on' : ''}}"
        wx:for="{{avoidOptions}}"
        wx:key="id"
        data-avoid-id="{{item.id}}"
        hover-class="chip-hover"
        catchtap="onToggleFamilyAvoid"
      >{{item.label}}</view>
    </view>
  </block>

  <block wx:elif="{{step === 1}}">
    <view class="title">喜欢火锅 / 面 / 饺吗？</view>
    <view class="hint">选「喜欢」时推荐可能多出一套</view>
    <view class="form-row" wx:for="{{formOptions}}" wx:key="id">
      <text class="form-label">{{item.label}}</text>
      <view class="chips">
        <view
          class="chip {{dishFormPrefs[item.id] === v.id ? 'on' : ''}}"
          wx:for="{{formValues}}"
          wx:for-item="v"
          wx:key="id"
          data-tag="{{item.id}}"
          data-value="{{v.id}}"
          bindtap="onFormPref"
        >{{v.label}}</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{step === 2}}">
    <view class="title">菜系偏好</view>
    <view class="hint">先选喜欢，再选不爱吃的（可跳过）</view>
    <view class="sub">喜欢（出菜更偏向）</view>
    <view class="chips">
      <view
        class="chip {{cuisinePrefs[item.id] === 'prefer' ? 'on' : ''}}"
        wx:for="{{cuisineOptions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCuisinePrefer"
      >{{item.label}}</view>
    </view>
    <view class="sub">不太想吃（相关菜不推）</view>
    <view class="chips">
      <view
        class="chip {{cuisinePrefs[item.id] === 'avoid' ? 'on' : ''}}"
        wx:for="{{cuisineOptions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCuisineAvoid"
      >{{item.label}}</view>
    </view>
  </block>

  <block wx:elif="{{step === 3}}">
    <view class="title">先添本人</view>
    <input class="input" value="{{selfName}}" bindinput="onSelfName" placeholder="称呼" />
    <view class="sub">年龄段</view>
    <view class="chips">
      <view
        class="chip {{selfAgeBand === item.id ? 'on' : ''}}"
        wx:for="{{ageBands}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onPickAge"
      >{{item.label}}</view>
    </view>
    <view class="sub">口味</view>
    <view class="chips">
      <view
        class="chip {{selfTaste === item.id ? 'on' : ''}}"
        wx:for="{{tastes}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onPickTaste"
      >{{item.label}}</view>
    </view>
    <view class="sub">个人忌口（只降权，不硬排除）</view>
    <view class="chips">
      <view
        class="chip {{selfAvoidChecked[item.id] ? 'on' : ''}}"
        wx:for="{{avoidOptions}}"
        wx:key="id"
        data-avoid-id="{{item.id}}"
        hover-class="chip-hover"
        catchtap="onToggleSelfAvoid"
      >{{item.label}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="title">日常默认</view>
    <view class="sub">人数（由家人派生，可在「我的」增减）</view>
    <view class="picker-row">{{householdPreview}}</view>
    <view class="sub">荤 / 素 / 汤（道数）</view>
    <view class="combo">
      <picker mode="selector" range="{{comboRange}}" value="{{meatIndex}}" bindchange="onMeatPick">
        <view class="picker-cell">荤 {{meat}}</view>
      </picker>
      <picker mode="selector" range="{{comboRange}}" value="{{vegIndex}}" bindchange="onVegPick">
        <view class="picker-cell">素 {{veg}}</view>
      </picker>
      <picker mode="selector" range="{{comboRange}}" value="{{soupIndex}}" bindchange="onSoupPick">
        <view class="picker-cell">汤 {{soup}}</view>
      </picker>
    </view>
    <view class="sub">城市（可选，选到市）</view>
    <view class="hint">仅用于匹配当地常见食材</view>
    <picker mode="region" level="city" value="{{region}}" bindchange="onRegionChange">
      <view class="picker-row">{{city || '点此选择省市'}}</view>
    </picker>
  </block>

  <view class="actions">
    <button size="mini" disabled="{{busy}}" bindtap="onSkip">暂时跳过</button>
    <button size="mini" wx:if="{{step > 0}}" bindtap="onBackStep">上一步</button>
    <button type="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="onNext">
      {{step >= 4 ? '完成' : '下一步'}}
    </button>
  </view>
  <view class="skip-hint">点验 Slice 1～4 时可点「暂时跳过」，家庭设置稍后在「我的」改。</view>
</view>
