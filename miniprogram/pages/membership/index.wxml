<view class="page {{typeScaleClass}}">
  <page-header title="会员中心" subtitle="买菜搭配，更自由" />
  <view wx:if="{{pageReady}}" class="page-body membership-body">
    <view class="status-card">
      <view class="status-main">
        <view class="status-copy">
          <text class="status-text">{{statusText}}</text>
          <text wx:if="{{payUnavailable}}" class="pay-banner">请将微信更新至最新版后再支付</text>
        </view>
        <view
          class="status-refresh"
          hover-class="tap-hover"
          hover-stay-time="80"
          bindtap="onRefresh"
        >刷新会员状态</view>
      </view>
    </view>

    <view class="benefit-card">
      <view class="benefit-head">
        <image
          class="benefit-vip-mark"
          src="/assets/images/icons/vip-entry.png"
          mode="aspectFit"
          aria-hidden="true"
        />
        <view class="benefit-head-copy">
          <text class="benefit-title">会员权益</text>
          <text class="benefit-sub">让每日买菜省心一点</text>
        </view>
      </view>
      <view class="benefit-table">
        <view class="benefit-table-row head">
          <view class="benefit-dim">权益项目</view>
          <view class="benefit-col benefit-col--member head-label">会员</view>
          <view class="benefit-col benefit-col--free head-label">免费</view>
        </view>
        <view
          class="benefit-table-row {{highlightBenefit === item.id ? 'is-highlight' : ''}}"
          wx:for="{{benefitRows}}"
          wx:key="id"
        >
          <view class="benefit-dim">{{item.dim}}</view>
          <view class="benefit-col benefit-col--member">{{item.member}}</view>
          <view class="benefit-col benefit-col--free">{{item.free}}</view>
        </view>
      </view>
    </view>

    <view class="offers">
      <view class="section-head">
        <text class="section-title">选择套餐</text>
        <view
          class="section-note section-note-link"
          hover-class="tap-hover"
          hover-stay-time="80"
          bindtap="onOpenNotice"
        >购买须知</view>
      </view>
      <view class="offers-row">
        <view
          wx:for="{{offers}}"
          wx:key="sku"
          class="offer-card {{selectedSku === item.sku ? 'on' : ''}}"
          data-sku="{{item.sku}}"
          hover-class="tap-hover"
          bindtap="onSelectSku"
        >
          <text wx:if="{{item.isFirstPurchase}}" class="offer-badge">首购</text>
          <text class="offer-title">{{item.title}}</text>
          <text class="pay-price">¥{{item.labelYuan}}</text>
          <text wx:if="{{item.showList}}" class="list-price">原价 ¥{{item.listYuan}}</text>
          <text class="offer-hint">{{item.hint}}</text>
          <view
            class="offer-radio {{selectedSku === item.sku ? 'on' : ''}}"
            aria-hidden="true"
          ></view>
        </view>
      </view>
    </view>

    <view wx:if="{{orders.length}}" class="orders">
      <view class="section-head">
        <text class="section-title">最近订单</text>
      </view>
      <view class="order-card">
        <view
          wx:for="{{orders}}"
          wx:key="orderId"
          class="order-row"
        >
          <view class="order-main">
            <text class="order-name">{{item.title}} · ¥{{item.labelYuan}}</text>
            <text wx:if="{{item.statusLabel}}" class="order-pending">{{item.statusLabel}}{{item.remainLabel ? ' · 剩余 ' + item.remainLabel : ''}}</text>
          </view>
          <view class="order-right">
            <view wx:if="{{item.canPay}}" class="order-actions">
              <view
                class="order-action ghost"
                data-order-id="{{item.orderId}}"
                hover-class="tap-hover"
                bindtap="onCancelOrder"
              >取消</view>
              <view
                class="order-action primary"
                data-order-id="{{item.orderId}}"
                hover-class="tap-hover"
                bindtap="onPayOrder"
              >去支付</view>
            </view>
            <text wx:if="{{item.timeLabel}}" class="order-date">{{item.timeLabel}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{showDevTools}}" class="dev-tools">
      <view class="dev-tools-title">调试（仅开发/体验版）</view>
      <view class="dev-tools-row">
        <view
          class="dev-btn"
          data-sku="month"
          hover-class="tap-hover"
          bindtap="onDevGrant"
        >开月卡</view>
        <view
          class="dev-btn"
          data-sku="quarter"
          hover-class="tap-hover"
          bindtap="onDevGrant"
        >开季卡</view>
        <view
          class="dev-btn"
          data-sku="year"
          hover-class="tap-hover"
          bindtap="onDevGrant"
        >开年卡</view>
      </view>
      <view class="dev-tools-row">
        <view class="dev-btn" hover-class="tap-hover" bindtap="onDevClear">清会员</view>
        <view
          class="dev-btn"
          hover-class="tap-hover"
          bindtap="onDevExpireSoon"
        >约1天后到期</view>
        <view
          class="dev-btn"
          hover-class="tap-hover"
          bindtap="onDevResetFirstPurchase"
        >重置首购</view>
      </view>
      <view class="dev-tools-row">
        <view
          class="dev-btn"
          hover-class="tap-hover"
          bindtap="onDevCreatePending"
        >待支付20s</view>
        <view
          class="dev-btn"
          hover-class="tap-hover"
          bindtap="onDevClearOrders"
        >清历史订单</view>
      </view>
    </view>
  </view>

  <view wx:if="{{pageReady}}" class="footer">
    <button
      wx:if="{{!isMember}}"
      type="primary"
      disabled="{{busy}}"
      bindtap="onPay"
    >立即开通</button>
    <button
      wx:else
      type="primary"
      disabled="{{busy}}"
      bindtap="onPay"
    >续费/再买</button>
  </view>

  <view
    wx:if="{{showNotice}}"
    class="mask"
    catchtouchmove="noop"
    bindtap="onCloseNotice"
  >
    <view class="sheet notice-sheet" catchtap="noop">
      <view class="sheet-title">购买须知</view>
      <view class="notice-list">
        <view class="notice-item" wx:for="{{noticeItems}}" wx:key="*this">
          <text class="notice-idx">{{index + 1}}.</text>
          <text class="notice-copy">{{item}}</text>
        </view>
      </view>
      <view class="sheet-actions" wx:if="{{!noticeAcked}}">
        <button type="primary" size="mini" bindtap="onAckNotice">已知晓</button>
      </view>
    </view>
  </view>

  <busy-overlay show="{{busy}}" />
</view>
