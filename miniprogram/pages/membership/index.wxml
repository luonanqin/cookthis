<view class="page {{typeScaleClass}}">
  <page-header title="会员" subtitle="买一次算一次，不自动续费" />
  <view wx:if="{{pageReady}}" class="page-body membership-body">
    <view class="status-card">
      <text class="status-text">{{statusText}}</text>
      <text wx:if="{{payUnavailable}}" class="pay-banner">请将微信更新至最新版后再支付</text>
    </view>

    <view class="surface-card benefits">
      <view class="section-label">会员权益</view>
      <view class="benefit-table">
        <view class="benefit-table-row head">
          <text class="benefit-dim"></text>
          <text class="benefit-col benefit-col--member head-label">会员</text>
          <text class="benefit-col benefit-col--free head-label">免费</text>
        </view>
        <view
          class="benefit-table-row"
          wx:for="{{benefitRows}}"
          wx:key="id"
        >
          <text class="benefit-dim">{{item.dim}}</text>
          <text class="benefit-col benefit-col--member">{{item.member}}</text>
          <text class="benefit-col benefit-col--free">{{item.free}}</text>
        </view>
      </view>
    </view>

    <view class="surface-card usage">
      <view class="section-label">今日换菜</view>
      <text class="usage-text">{{usageText}}</text>
    </view>

    <view wx:if="{{!isMember || buyExpanded}}" class="offers">
      <view class="section-label offers-label">选择套餐</view>
      <view class="offers-row">
        <view
          wx:for="{{offers}}"
          wx:key="sku"
          class="offer-card {{selectedSku === item.sku ? 'on' : ''}}"
          data-sku="{{item.sku}}"
          hover-class="tap-hover"
          bindtap="onSelectSku"
        >
          <text wx:if="{{item.isFirstPurchase}}" class="offer-badge">首购</text>
          <text class="offer-title">{{item.title}}</text>
          <text class="pay-price">¥{{item.labelYuan}}</text>
          <text wx:if="{{item.showList}}" class="list-price">¥{{item.listYuan}}</text>
          <text class="offer-hint">{{item.hint}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{orders.length}}" class="surface-card orders">
      <view class="section-label">订单</view>
      <view
        wx:for="{{orders}}"
        wx:key="orderId"
        class="order-row"
      >
        <view class="order-main">
          <view class="order-title-row">
            <text class="order-title">{{item.title}}</text>
            <text class="order-status">{{item.statusLabel}}</text>
          </view>
          <text class="order-meta">¥{{item.labelYuan}}{{item.canPay && item.remainLabel ? ' · 剩余 ' + item.remainLabel : ''}}</text>
        </view>
        <view wx:if="{{item.canPay}}" class="order-actions">
          <view
            class="order-action ghost"
            data-order-id="{{item.orderId}}"
            hover-class="tap-hover"
            bindtap="onCancelOrder"
          >取消</view>
          <view
            class="order-action primary"
            data-order-id="{{item.orderId}}"
            hover-class="tap-hover"
            bindtap="onPayOrder"
          >去支付</view>
        </view>
      </view>
    </view>

    <view wx:if="{{isMember}}" class="surface-card member-info">
      <view class="section-label">会员信息</view>
      <view class="info-row">
        <text class="info-k">档位</text>
        <text class="info-v">{{tierLabel || '会员'}}</text>
      </view>
      <view class="info-row">
        <text class="info-k">到期日</text>
        <text class="info-v">{{expiresLabel || '—'}}</text>
      </view>
      <view
        class="link-btn"
        hover-class="tap-hover"
        bindtap="onRefresh"
      >刷新会员状态</view>
      <view
        wx:if="{{!buyExpanded}}"
        class="link-btn fold-buy"
        hover-class="tap-hover"
        bindtap="onExpandBuy"
      >续费/再买</view>
    </view>
    <view
      wx:else
      class="link-btn refresh-entry"
      hover-class="tap-hover"
      bindtap="onRefresh"
    >刷新会员状态</view>

    <view
      class="notice-entry"
      hover-class="tap-hover"
      bindtap="onOpenNotice"
    >购买须知</view>

    <view wx:if="{{showDevTools}}" class="dev-tools">
      <view class="dev-tools-title">调试（仅开发/体验版）</view>
      <view class="dev-tools-row">
        <view
          class="dev-btn"
          data-sku="month"
          hover-class="tap-hover"
          bindtap="onDevGrant"
        >开月卡</view>
        <view
          class="dev-btn"
          data-sku="quarter"
          hover-class="tap-hover"
          bindtap="onDevGrant"
        >开季卡</view>
        <view
          class="dev-btn"
          data-sku="year"
          hover-class="tap-hover"
          bindtap="onDevGrant"
        >开年卡</view>
      </view>
      <view class="dev-tools-row">
        <view class="dev-btn" hover-class="tap-hover" bindtap="onDevClear">清会员</view>
        <view
          class="dev-btn"
          hover-class="tap-hover"
          bindtap="onDevExpireSoon"
        >约1天后到期</view>
        <view
          class="dev-btn"
          hover-class="tap-hover"
          bindtap="onDevResetFirstPurchase"
        >重置首购</view>
      </view>
    </view>
  </view>

  <view wx:if="{{pageReady && (!isMember || buyExpanded)}}" class="footer">
    <button
      wx:if="{{!isMember}}"
      type="primary"
      disabled="{{busy}}"
      bindtap="onPay"
    >立即开通</button>
    <button
      wx:else
      type="primary"
      disabled="{{busy}}"
      bindtap="onPay"
    >续费/再买</button>
  </view>

  <view
    wx:if="{{showNotice}}"
    class="mask"
    catchtouchmove="noop"
    bindtap="onCloseNotice"
  >
    <view class="sheet notice-sheet" catchtap="noop">
      <view class="sheet-title">购买须知</view>
      <view class="notice-list">
        <view class="notice-item" wx:for="{{noticeItems}}" wx:key="*this">
          <text class="notice-idx">{{index + 1}}.</text>
          <text class="notice-copy">{{item}}</text>
        </view>
      </view>
      <view class="sheet-actions">
        <button
          wx:if="{{!noticeAcked}}"
          type="primary"
          size="mini"
          bindtap="onAckNotice"
        >已知晓</button>
        <button
          wx:else
          class="btn-outline"
          size="mini"
          bindtap="onCloseNotice"
        >关闭</button>
      </view>
    </view>
  </view>

  <busy-overlay show="{{busy}}" />
</view>
