.page {
  min-height: 100vh;
  background: var(--color-bg);
}

.membership-body {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.status-card {
  background: var(--color-primary-soft);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.status-text {
  font-size: var(--fs-title);
  font-weight: var(--fw-semibold);
  color: var(--color-forest);
  line-height: 1.4;
}

.pay-banner {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.section-label {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.benefit-table {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.benefit-table-row {
  display: flex;
  align-items: stretch;
  gap: 8rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.benefit-table-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.benefit-table-row.head {
  padding-top: 0;
  padding-bottom: 10rpx;
}

.benefit-dim {
  width: 140rpx;
  flex-shrink: 0;
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  line-height: 1.35;
  display: flex;
  align-items: center;
}

.benefit-col {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: var(--fs-sm);
  line-height: 1.35;
  padding: 10rpx 8rpx;
  border-radius: var(--radius-chip);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.benefit-col--member {
  font-weight: var(--fw-semibold);
  color: var(--color-forest);
  background: var(--color-primary-soft);
}

.benefit-col--free {
  color: var(--color-text-secondary);
  background: transparent;
}

.head-label {
  font-weight: var(--fw-semibold);
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.benefit-table-row.head .benefit-col--member {
  color: var(--color-primary);
}

.benefit-table-row.head .benefit-col--free {
  color: var(--color-text-secondary);
  background: transparent;
  font-weight: var(--fw-medium);
}

.usage-text {
  font-size: var(--fs-body);
  font-weight: var(--fw-medium);
  color: var(--color-text);
}

.offers-label {
  margin: 4rpx 8rpx 8rpx;
}

.offers-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.offer-card {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 6rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 20rpx 10rpx 22rpx;
  box-sizing: border-box;
  text-align: center;
  position: relative;
}

.offer-card.on {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.offer-title {
  font-size: var(--fs-body);
  font-weight: var(--fw-semibold);
  color: var(--color-forest);
  margin-top: 8rpx;
}

.offer-badge {
  position: absolute;
  top: 0;
  right: 0;
  font-size: var(--fs-xxs);
  font-weight: var(--fw-semibold);
  color: var(--color-coral);
  background: var(--color-coral-soft);
  border-radius: 0 var(--radius-card) 0 var(--radius-chip);
  padding: 2rpx 10rpx;
}

.offer-hint {
  font-size: var(--fs-xxs);
  color: var(--color-text-secondary);
  line-height: 1.35;
  margin-top: 4rpx;
  white-space: pre-line;
}

.pay-price {
  font-size: var(--fs-title);
  font-weight: var(--fw-bold);
  color: var(--color-primary);
  line-height: 1.2;
  margin-top: 4rpx;
}

.list-price {
  font-size: var(--fs-xxs);
  color: var(--color-text-muted);
  text-decoration: line-through;
}

.order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.order-row:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.order-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.order-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-title {
  font-size: var(--fs-body);
  font-weight: var(--fw-semibold);
  color: var(--color-text);
}

.order-status {
  font-size: var(--fs-xs);
  color: var(--color-text-secondary);
}

.order-meta {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
}

.order-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-action {
  font-size: var(--fs-sm);
  font-weight: var(--fw-medium);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-chip);
}

.order-action.ghost {
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
}

.order-action.primary {
  color: #fff;
  background: var(--color-primary);
}

.info-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 0;
}

.info-k {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
}

.info-v {
  font-size: var(--fs-body);
  font-weight: var(--fw-medium);
  color: var(--color-text);
}

.link-btn {
  margin-top: 16rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--color-primary);
}

.fold-buy {
  margin-top: 0;
}

.refresh-entry {
  margin-top: 0;
  padding: 8rpx;
}

.notice-entry {
  padding: 24rpx 8rpx 8rpx;
  text-align: center;
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
}

.dev-tools {
  margin-top: 32rpx;
  padding: 20rpx 8rpx 8rpx;
  border-top: 1rpx dashed var(--color-border, rgba(0, 0, 0, 0.12));
}

.dev-tools-title {
  margin-bottom: 12rpx;
  font-size: var(--fs-sm, 22rpx);
  color: var(--color-text-secondary);
}

.dev-tools-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.dev-btn {
  padding: 10rpx 18rpx;
  font-size: var(--fs-sm, 22rpx);
  color: var(--color-text-secondary);
  background: rgba(0, 0, 0, 0.04);
  border-radius: 8rpx;
}

.notice-list {
  margin: 16rpx 0 8rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding: 10rpx 0;
  font-size: var(--fs-body);
  color: var(--color-text);
  line-height: 1.5;
}

.notice-idx {
  flex-shrink: 0;
  color: var(--color-text-secondary);
}

.notice-copy {
  min-width: 0;
}

.notice-sheet .sheet-actions {
  justify-content: flex-end;
}
