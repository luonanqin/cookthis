<view class="wrap">
  <image class="avatar" src="{{avatarSrc}}" mode="aspectFill" />
  <text class="nickname">{{nickname}}</text>

  <view class="section">
    <view class="section-title">家人</view>
    <view class="household">{{householdLabel}}</view>
    <view class="member-card" wx:for="{{members}}" wx:key="memberId">
      <view class="member-main" data-id="{{item.memberId}}" bindtap="openEditMember">
        <text class="member-name">{{item.name}}</text>
        <text class="member-meta">{{item.ageLabel}} · {{item.tasteLabel}} · 忌口{{item.avoidLabel}}</text>
      </view>
      <text class="member-del" data-id="{{item.memberId}}" catchtap="removeMember">删</text>
    </view>
    <view class="link-inline" bindtap="openAddMember">＋ 添加家人</view>
  </view>

  <view class="section">
    <view class="section-title">家庭忌口</view>
    <view class="chips">
      <view
        class="chip {{familyAvoidChecked[item.id] ? 'on' : ''}}"
        wx:for="{{avoidOptions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onToggleAvoid"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">菜式偏好（喜欢时可能出非常规方案）</view>
    <view class="form-row" wx:for="{{formOptions}}" wx:key="id">
      <text class="form-label">{{item.label}}</text>
      <view class="chips">
        <view
          class="chip {{dishFormPrefs[item.id] === v.id ? 'on' : ''}}"
          wx:for="{{formValues}}"
          wx:for-item="v"
          wx:key="id"
          data-tag="{{item.id}}"
          data-value="{{v.id}}"
          bindtap="onFormPref"
        >{{v.label}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">菜系偏好</view>
    <view class="hint">先选喜欢，再选不爱吃的（可跳过）</view>
    <view class="sub">喜欢（出菜更偏向）</view>
    <view class="chips">
      <view
        class="chip {{cuisinePrefs[item.id] === 'prefer' ? 'on' : ''}}"
        wx:for="{{cuisineOptions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCuisinePrefer"
      >{{item.label}}</view>
    </view>
    <view class="sub">不太想吃（相关菜不推）</view>
    <view class="chips">
      <view
        class="chip {{cuisinePrefs[item.id] === 'avoid' ? 'on' : ''}}"
        wx:for="{{cuisineOptions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCuisineAvoid"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">城市（选到市）</view>
    <view class="hint">仅用于匹配当地常见食材</view>
    <picker mode="region" level="city" value="{{region}}" bindchange="onRegionChange">
      <view class="picker-row">{{city || '点此选择省市'}}</view>
    </picker>
  </view>

  <button type="primary" disabled="{{busy}}" bindtap="onSave">保存</button>
  <view class="link" hover-class="tap-hover" hover-stay-time="80" bindtap="goOnboarding">重新走一遍家庭引导</view>

  <view wx:if="{{showMemberEditor}}" class="editor-mask" catchtouchmove="true">
    <view class="editor-panel">
      <view class="section-title">{{editingMemberId ? '编辑家人' : '添加家人'}}</view>
      <input class="editor-input" placeholder="称呼" value="{{editName}}" bindinput="onEditName" />
      <text class="form-label">年龄段</text>
      <view class="chips">
        <view
          class="chip {{editAgeBand === item.id ? 'on' : ''}}"
          wx:for="{{ageBandOptions}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onEditAge"
        >{{item.label}}</view>
      </view>
      <text class="form-label">口味</text>
      <view class="chips">
        <view
          class="chip {{editTaste === item.id ? 'on' : ''}}"
          wx:for="{{tasteOptions}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onEditTaste"
        >{{item.label}}</view>
      </view>
      <text class="form-label">个人忌口</text>
      <view class="chips">
        <view
          class="chip {{editAvoidChecked[item.id] ? 'on' : ''}}"
          wx:for="{{avoidOptions}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onEditAvoid"
        >{{item.label}}</view>
      </view>
      <view class="editor-actions">
        <button size="mini" bindtap="closeMemberEditor">取消</button>
        <button size="mini" type="primary" bindtap="saveMember">确定</button>
      </view>
    </view>
  </view>
</view>
