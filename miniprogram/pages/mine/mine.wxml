<view class="page {{typeScaleClass}}">
  <page-header
    title="我的偏好"
    subtitle="完整偏好可以更准确地推荐好菜"
  />
  <view class="wrap">
  <view class="profile-row">
    <image class="avatar" src="{{avatarSrc}}" mode="aspectFill" />
    <text class="nickname">{{nickname}}</text>
  </view>

  <view class="section" id="secMembers">
    <view class="section-head">
      <view class="section-title section-title-row {{gapMembersOpen ? 'section-title-gap' : ''}}"><image class="ui-icon ui-icon--sm" src="/assets/images/icons/group-people.png" mode="aspectFit" aria-hidden="true"/><text>家庭成员</text></view>
      <text class="section-aside">{{householdLabel}}</text>
    </view>
    <view class="member-card" wx:for="{{members}}" wx:key="memberId">
      <view class="member-main" data-id="{{item.memberId}}" bindtap="openEditMember">
        <text class="member-name">{{item.name}}</text>
        <text class="member-sep" aria-hidden="true">|</text>
        <text class="member-cell">{{item.ageLabel}}</text>
        <text class="member-sep" aria-hidden="true">|</text>
        <text class="member-cell">{{item.tasteLabel}}</text>
        <text class="member-sep" aria-hidden="true">|</text>
        <text class="member-cell member-cell--avoid">{{item.avoidLabel}}</text>
      </view>
      <text class="member-del" data-id="{{item.memberId}}" catchtap="removeMember">删</text>
    </view>
    <view class="link-inline member-add" bindtap="openAddMember">＋ 添加家庭成员</view>
  </view>

  <view class="section" id="secCombo">
    <view class="section-head">
      <view class="section-title section-title-row"><image class="ui-icon ui-icon--sm" src="/assets/images/icons/soup-bowl.png" mode="aspectFit" aria-hidden="true"/><text>日常搭配</text></view>
      <text class="section-aside">每餐基础搭配，推荐更合适</text>
    </view>
    <view class="combo-row">
      <picker mode="selector" range="{{comboRange}}" value="{{meatIndex}}" data-field="meat" bindchange="onComboPick">
        <view class="picker-cell">荤 {{defaultCombo.meat}}</view>
      </picker>
      <picker mode="selector" range="{{comboRange}}" value="{{vegIndex}}" data-field="veg" bindchange="onComboPick">
        <view class="picker-cell">素 {{defaultCombo.veg}}</view>
      </picker>
      <picker mode="selector" range="{{comboRange}}" value="{{soupIndex}}" data-field="soup" bindchange="onComboPick">
        <view class="picker-cell">汤 {{defaultCombo.soup}}</view>
      </picker>
    </view>
  </view>

  <view class="section" id="secAvoids">
    <view class="section-head">
      <view class="section-title section-title-row {{gapAvoidsOpen ? 'section-title-gap' : ''}}"><image class="ui-icon ui-icon--sm" src="/assets/images/icons/leafy-vegetables.png" mode="aspectFit" aria-hidden="true"/><text>家庭忌口</text></view>
      <text class="section-aside">选择后将避开相关食材</text>
    </view>
    <view class="chips">
      <view
        class="chip {{noneAvoidChecked ? 'on' : ''}}"
        data-id="none"
        bindtap="onToggleAvoid"
      >无忌口</view>
      <view
        class="chip {{familyAvoidChecked[item.id] ? 'on' : ''}}"
        wx:for="{{avoidOptions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onToggleAvoid"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="section" id="secCity">
    <view class="section-head">
      <view class="section-title section-title-row {{gapCityOpen ? 'section-title-gap' : ''}}"><image class="ui-icon ui-icon--sm" src="/assets/images/icons/location-pin-green.png" mode="aspectFit" aria-hidden="true"/><text>所在城市</text></view>
      <text class="section-aside">用于匹配当地常见食材</text>
    </view>
    <picker mode="region" level="city" value="{{region}}" bindchange="onRegionChange">
      <view class="picker-row">{{city || '点此选择城市'}}</view>
    </picker>
  </view>

  <view class="section" id="secCuisine">
    <view class="section-head">
      <view class="section-title section-title-row {{gapCuisineOpen ? 'section-title-gap' : ''}}"><image class="ui-icon ui-icon--sm" src="/assets/images/icons/soup-bowl.png" mode="aspectFit" aria-hidden="true"/><text>菜系偏好</text></view>
      <text class="section-aside">选择喜欢的菜系更合口味</text>
    </view>
    <view class="chips">
      <view
        class="chip {{cuisineOkChecked ? 'on' : ''}}"
        bindtap="onToggleCuisineOk"
      >都还行</view>
    </view>
    <view class="sub">喜欢</view>
    <view class="chips">
      <view
        class="chip {{cuisinePrefs[item.id] === 'prefer' ? 'on' : ''}}"
        wx:for="{{cuisineOptions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCuisinePrefer"
      >{{item.label}}</view>
    </view>
    <view class="sub">不喜欢</view>
    <view class="chips">
      <view
        class="chip {{cuisinePrefs[item.id] === 'avoid' ? 'on-avoid' : ''}}"
        wx:for="{{cuisineOptions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCuisineAvoid"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title section-title-row"><image class="ui-icon ui-icon--sm" src="/assets/images/icons/notebook-green.png" mode="aspectFit" aria-hidden="true"/><text>菜式偏好</text></view>
      <text class="section-aside">按菜式再细化口味</text>
    </view>
    <view class="form-row" wx:for="{{formOptions}}" wx:key="id">
      <text class="form-name">{{item.label}}</text>
      <radio-group
        class="form-radios"
        data-tag="{{item.id}}"
        bindchange="onFormPrefRadio"
      >
        <label
          class="form-radio"
          wx:for="{{formValues}}"
          wx:for-item="v"
          wx:key="id"
        >
          <radio
            value="{{v.id}}"
            checked="{{dishFormPrefs[item.id] === v.id}}"
            color="#527F55"
          />
          <text>{{v.label}}</text>
        </label>
      </radio-group>
    </view>
  </view>

  <view class="link reset-link" hover-class="tap-hover" hover-stay-time="80" bindtap="goOnboarding">重新设置偏好</view>

  <view class="footer">
    <button type="primary" disabled="{{busy}}" bindtap="onSave">保存</button>
  </view>

  <view
    wx:if="{{showMemberEditor}}"
    class="editor-mask"
    catchtouchmove="true"
    bindtap="closeMemberEditor"
  >
    <view class="editor-panel" catchtap="noop">
      <view class="section-title">{{editingMemberId ? '编辑家庭成员' : '添加家庭成员'}}</view>
      <view class="editor-input-box">
        <view class="editor-input-field">
          <input
            class="editor-input-inner"
            style="width: 72rpx;"
            placeholder="称呼"
            value="{{editName}}"
            bindinput="onEditName"
          />
        </view>
        <view class="editor-input-quicks">
          <view
            class="chip chip-mini"
            wx:for="{{nameQuickOptions}}"
            wx:key="*this"
            data-name="{{item}}"
            bindtap="onPickQuickName"
          >{{item}}</view>
        </view>
      </view>
      <text class="form-label">年龄段</text>
      <view class="chips">
        <view
          class="chip {{editAgeBand === item.id ? 'on' : ''}}"
          wx:for="{{ageBandOptions}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onEditAge"
        >{{item.label}}</view>
      </view>
      <text class="form-label">口味</text>
      <view class="chips">
        <view
          class="chip {{editTaste === item.id ? 'on' : ''}}"
          wx:for="{{tasteOptions}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onEditTaste"
        >{{item.label}}</view>
      </view>
      <text class="form-label">个人忌口</text>
      <view class="chips">
        <view
          class="chip {{editAvoidsNone ? 'on' : ''}}"
          data-id="none"
          bindtap="onEditAvoid"
        >无忌口</view>
        <view
          class="chip {{editAvoidChecked[item.id] ? 'on' : ''}}"
          wx:for="{{avoidOptions}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onEditAvoid"
        >{{item.label}}</view>
      </view>
      <view class="editor-actions">
        <button size="mini" class="btn-outline" bindtap="closeMemberEditor">取消</button>
        <button size="mini" type="primary" bindtap="saveMember">确定</button>
      </view>
    </view>
  </view>
  </view>
</view>
