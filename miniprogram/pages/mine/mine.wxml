<view class="wrap">
  <image class="avatar" src="{{avatarSrc}}" mode="aspectFill" />
  <text class="nickname">{{nickname}}</text>

  <view class="section">
    <view class="section-title">家庭忌口</view>
    <view class="chips">
      <view
        class="chip {{familyAvoidChecked[item.id] ? 'on' : ''}}"
        wx:for="{{avoidOptions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onToggleAvoid"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">菜式偏好（喜欢时可能出非常规方案）</view>
    <view class="form-row" wx:for="{{formOptions}}" wx:key="id">
      <text class="form-label">{{item.label}}</text>
      <view class="chips">
        <view
          class="chip {{dishFormPrefs[item.id] === v.id ? 'on' : ''}}"
          wx:for="{{formValues}}"
          wx:for-item="v"
          wx:key="id"
          data-tag="{{item.id}}"
          data-value="{{v.id}}"
          bindtap="onFormPref"
        >{{v.label}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">日常默认人数</view>
    <picker mode="selector" range="{{peopleRange}}" value="{{peopleIndex}}" bindchange="onPeoplePick">
      <view class="picker-row">{{defaultPeopleCount}} 人</view>
    </picker>
  </view>

  <view class="section">
    <view class="section-title">城市（选到市）</view>
    <picker mode="region" level="city" value="{{region}}" bindchange="onRegionChange">
      <view class="picker-row">{{city || '点此选择省市'}}</view>
    </picker>
  </view>

  <view class="link" bindtap="goAcceptedPlans">已选方案</view>
  <view class="link" bindtap="goRecord">已吃记录</view>
  <button type="primary" disabled="{{busy}}" bindtap="onSave">保存</button>
  <view class="link" bindtap="goOnboarding">重新走一遍家庭引导</view>
</view>
