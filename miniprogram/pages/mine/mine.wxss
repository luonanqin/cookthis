.page {
  min-height: 100vh;
  background: var(--color-bg);
}

.wrap {
  /* 底部留足空间：不被固定「保存」挡住，且「重新设置」可滑到可视区再点 */
  padding: 24rpx 32rpx calc(220rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 24rpx;
  box-sizing: border-box;
  background: var(--color-bg);
}

.section {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(39, 51, 46, 0.05);
}

.profile-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 0 8rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  flex-shrink: 0;
}

.nickname {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--color-text);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: var(--fs-lead);
  font-weight: 600;
  margin-bottom: 0;
  color: var(--color-forest);
  flex-shrink: 0;
}

.section-aside {
  flex: 1;
  min-width: 0;
  margin-top: 4rpx;
  text-align: right;
  font-size: var(--fs-caption);
  line-height: 1.35;
  color: var(--color-text-secondary, #888);
}

.section-title-gap {
  color: #e54d42;
}

.hint,
.sub {
  color: var(--color-text-secondary, #888);
  font-size: var(--fs-caption);
  margin: 8rpx 0 12rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 14rpx 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-chip);
  font-size: var(--fs-sm);
  color: var(--color-text);
}

.chip.on {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.chip.on-avoid {
  border-color: #e54d42;
  color: #e54d42;
  background: #fdecea;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.form-name {
  flex: 0 0 88rpx;
  width: 88rpx;
  font-size: var(--fs-md);
  color: var(--color-text);
  line-height: 1.3;
}

.form-radios {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.form-radio {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--fs-sm);
  color: var(--color-text);
  min-width: 0;
}

.form-radio radio {
  transform: scale(0.82);
  margin-right: 0;
}

.form-label {
  display: block;
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.picker-row {
  background: var(--color-surface);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: var(--fs-body);
}

.large-text .picker-row {
  min-height: 96rpx;
  padding: 24rpx 24rpx;
  font-size: var(--fs-title);
  box-sizing: border-box;
}

.combo-row {
  display: flex;
  gap: 12rpx;
}

.combo-row picker {
  flex: 1;
}

.picker-cell {
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 12rpx;
  text-align: center;
  background: var(--color-surface);
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  font-size: var(--fs-body);
  color: var(--color-text);
  box-sizing: border-box;
}

.member-card {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
  padding: 18rpx 16rpx;
  background: var(--color-bg);
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.member-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  flex-wrap: nowrap;
  gap: 0;
  overflow: hidden;
}

.member-name {
  flex: 0 0 auto;
  max-width: 88rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--fs-body);
  color: var(--color-text);
  font-weight: 600;
}

.member-sep {
  flex: 0 0 auto;
  margin: 0 10rpx;
  color: var(--color-border);
  font-size: var(--fs-sm);
  line-height: 1;
}

.member-cell {
  flex: 0 1 auto;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
}

.member-cell--avoid {
  max-width: 200rpx;
}

.member-del {
  flex-shrink: 0;
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  padding: 8rpx 4rpx 8rpx 8rpx;
}

.link-inline {
  margin-top: 4rpx;
  font-size: var(--fs-body);
  color: var(--color-primary);
}

.member-add {
  margin-top: 8rpx;
  padding: 18rpx 16rpx;
  text-align: center;
  background: var(--color-primary-soft);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.editor-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(26, 26, 26, 0.45);
  z-index: 30;
  display: flex;
  align-items: flex-end;
}

.editor-panel {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: var(--color-bg);
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.editor-input-box {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 6rpx;
  margin: 12rpx 0 16rpx;
  padding: 8rpx 12rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.editor-input-field {
  flex: 0 0 72rpx;
  width: 72rpx;
  max-width: 72rpx;
  min-width: 0;
  overflow: hidden;
}

.editor-input-inner {
  display: block;
  width: 72rpx;
  max-width: 72rpx;
  height: 44rpx;
  padding: 0;
  margin: 0;
  font-size: var(--fs-body);
  color: var(--color-text);
}

.editor-input-quicks {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
}

.chip-mini {
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-size: var(--fs-caption);
  line-height: 1.3;
}

.editor-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

.link {
  margin-top: 32rpx;
  text-align: center;
  color: var(--color-text-secondary, #576b95);
  font-size: var(--fs-md);
}

.reset-link {
  margin-top: 48rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
}

/* 底栏样式见 app.wxss .footer */

/* Icon assets */
.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-head .section-title-row {
  margin-bottom: 0;
}
