.wrap {
  /* 底部留足空间：不被固定「保存」挡住，且「重新设置」可滑到可视区再点 */
  padding: 48rpx 32rpx calc(220rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 24rpx;
  box-sizing: border-box;
  background: var(--color-bg);
  min-height: 100vh;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  align-self: center;
}

.nickname {
  font-size: var(--fs-lead);
  font-weight: 500;
  color: var(--color-text);
  text-align: center;
}

.section {
  margin-top: 12rpx;
}

.section-title {
  font-size: var(--fs-body);
  font-weight: 600;
  margin-bottom: 12rpx;
  color: var(--color-text);
}

.section-title-gap {
  color: #e54d42;
}

.hint,
.sub {
  color: var(--color-text-secondary, #888);
  font-size: var(--fs-caption);
  margin: 8rpx 0 12rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: var(--fs-sm);
  color: var(--color-text);
}

.chip.on {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.chip.on-avoid {
  border-color: #e54d42;
  color: #e54d42;
  background: #fdecea;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.form-name {
  flex: 0 0 88rpx;
  width: 88rpx;
  font-size: var(--fs-md);
  color: var(--color-text);
  line-height: 1.3;
}

.form-radios {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.form-radio {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--fs-sm);
  color: var(--color-text);
  min-width: 0;
}

.form-radio radio {
  transform: scale(0.82);
  margin-right: 0;
}

.form-label {
  display: block;
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.picker-row {
  background: var(--color-surface);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: var(--fs-body);
}

.large-text .picker-row {
  min-height: 96rpx;
  padding: 24rpx 24rpx;
  font-size: var(--fs-title);
  box-sizing: border-box;
}

.combo-row {
  display: flex;
  gap: 12rpx;
}

.combo-row picker {
  flex: 1;
}

.picker-cell {
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 12rpx;
  text-align: center;
  background: var(--color-surface);
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  font-size: var(--fs-body);
  color: var(--color-text);
  box-sizing: border-box;
}

.household {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.member-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.member-main {
  flex: 1;
  min-width: 0;
}

.member-name {
  display: block;
  font-size: var(--fs-body);
  color: var(--color-text);
  font-weight: 500;
}

.member-meta {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
}

.member-del {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  padding: 8rpx 12rpx;
}

.link-inline {
  margin-top: 12rpx;
  font-size: var(--fs-body);
  color: var(--color-primary);
}

.editor-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(26, 26, 26, 0.45);
  z-index: 30;
  display: flex;
  align-items: flex-end;
}

.editor-panel {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: var(--color-bg);
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.editor-input-box {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 6rpx;
  margin: 12rpx 0 16rpx;
  padding: 8rpx 12rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.editor-input-field {
  flex: 0 0 72rpx;
  width: 72rpx;
  max-width: 72rpx;
  min-width: 0;
  overflow: hidden;
}

.editor-input-inner {
  display: block;
  width: 72rpx;
  max-width: 72rpx;
  height: 44rpx;
  padding: 0;
  margin: 0;
  font-size: var(--fs-body);
  color: var(--color-text);
}

.editor-input-quicks {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
}

.chip-mini {
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-size: var(--fs-caption);
  line-height: 1.3;
}

.editor-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

.link {
  margin-top: 32rpx;
  text-align: center;
  color: var(--color-text-secondary, #576b95);
  font-size: var(--fs-md);
}

.reset-link {
  margin-top: 48rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
  box-sizing: border-box;
  display: flex;
  justify-content: center;
}

.footer button {
  margin: 0;
  width: 360rpx;
}
