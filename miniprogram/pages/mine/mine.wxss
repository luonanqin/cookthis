.wrap {
  padding: 48rpx 32rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 24rpx;
  box-sizing: border-box;
  background: var(--color-bg);
  min-height: 100vh;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  align-self: center;
}

.nickname {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--color-text);
  text-align: center;
}

.section {
  margin-top: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: var(--color-text);
}

.hint,
.sub {
  color: var(--color-text-secondary, #888);
  font-size: 24rpx;
  margin: 8rpx 0 12rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--color-text);
}

.chip.on {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.form-row {
  margin-bottom: 16rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.picker-row {
  background: var(--color-surface);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: 28rpx;
}

.link {
  margin-top: 32rpx;
  text-align: center;
  color: var(--color-text-secondary, #576b95);
  font-size: 26rpx;
}

.link + .link {
  margin-top: 16rpx;
}
