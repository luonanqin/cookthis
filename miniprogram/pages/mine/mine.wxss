.wrap {
  padding: 48rpx 32rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 24rpx;
  box-sizing: border-box;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: #e8e8e8;
  align-self: center;
}

.nickname {
  font-size: 36rpx;
  font-weight: 500;
  color: #111;
  text-align: center;
}

.section {
  margin-top: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 20rpx;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #333;
}

.chip.on {
  border-color: #2e7d32;
  color: #2e7d32;
  background: #e8f5e9;
}

.form-row {
  margin-bottom: 16rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.people {
  background: #fff;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
}
