.root {
  min-height: 100vh;
  background: var(--color-bg);
}

.home {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.home-hero {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-header);
  /* 750×730 近方形 widthFix 图片自然撑开约 730rpx；整图显示不裁切 */
}

.home-hero__img {
  position: relative;
  display: block;
  width: 100%;
  height: auto;
  vertical-align: top;
  z-index: 0;
}

.home-hero__wave {
  position: absolute;
  left: -8%;
  right: -8%;
  bottom: -2rpx;
  height: 56rpx;
  background: var(--color-bg);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  z-index: 3;
  pointer-events: none;
}

.home-body {
  flex: 1;
  padding: 0 40rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.home-question-image {
  display: block;
  width: 100%;
  height: 150rpx;
  margin: 0 auto;
  object-fit: contain;
}

.home-sub {
  margin-top: 8rpx;
  margin-bottom: 72rpx;
  /* 比主按钮 --fs-title 小一档 */
  font-size: var(--fs-btn);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.5;
}

.home-cta-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.home-cta-side {
  flex: 1;
  margin: 0 !important;
  height: 96rpx !important;
  border-radius: var(--radius-pill) !important;
}

.btn-main {
  font-weight: var(--fw-semibold) !important;
  font-size: var(--fs-title) !important;
}

.home-nav {
  display: flex;
  gap: 16rpx;
}

.home-type-scale {
  margin-top: 20rpx;
  align-self: flex-end;
  width: 64rpx;
  height: 64rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 2rpx solid var(--color-primary);
  background: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(39, 51, 46, 0.06);
}

.home-type-scale__glyph {
  font-size: var(--fs-body);
  font-weight: var(--fw-bold);
  color: var(--color-primary);
  line-height: 1;
}

.home-nav-card {
  position: relative;
  flex: 1;
  min-height: 148rpx;
  padding: 16rpx 12rpx 18rpx;
  box-sizing: border-box;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(39, 51, 46, 0.04);
}

.home-nav-title {
  font-size: var(--fs-md);
  font-weight: var(--fw-semibold);
  color: var(--color-text);
  text-align: center;
  line-height: 1.3;
}

.link-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #e54d42;
  color: #fff;
  font-size: var(--fs-xxs);
  line-height: 28rpx;
  text-align: center;
  font-weight: var(--fw-semibold);
}

.link-dot {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e54d42;
}

.link-dev {
  margin-top: 20rpx;
  padding: 24rpx 16rpx;
  box-sizing: border-box;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
}

.dev-scale-panel {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--color-border);
}

.dev-scale-title {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.dev-scale-status {
  font-size: var(--fs-xs);
  line-height: 1.5;
  color: var(--color-text-muted);
  white-space: pre-wrap;
}

.dev-scale-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 28rpx;
  margin-top: 4rpx;
}

.dev-scale-actions .link-dev {
  margin-top: 0;
  padding: 24rpx 8rpx;
  justify-content: flex-start;
}

/* 进场确认：独立半屏弹层 */
.sheet-confirm {
  width: 100%;
  max-height: 60vh;
  background: var(--color-surface);
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sheet-confirm-hd {
  flex-shrink: 0;
  padding: 32rpx 28rpx 0;
}

.sheet-confirm-hd .sheet-hint {
  margin-bottom: 8rpx;
}

.sheet-confirm-list-wrap {
  position: relative;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.sheet-confirm-list-wrap.peek {
  height: 292rpx;
}

.sheet-confirm-list {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

/* 两列均分：避免 calc(50%-n) 在部分机型失效变单列；列宽随屏宽自适应 */
.sheet-confirm-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding: 4rpx 0 32rpx;
  box-sizing: border-box;
}

.sheet-chip {
  width: auto;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 16rpx 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-chip);
  font-size: var(--fs-md);
  color: var(--color-text);
  background: var(--color-bg);
}

.sheet-chip.on {
  color: var(--color-primary);
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.sheet-chip .check {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-control);
  text-align: center;
  line-height: 28rpx;
  color: var(--color-primary);
  font-size: var(--fs-xs);
  background: var(--color-surface);
}

.sheet-chip.on .check {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.sheet-chip-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-confirm-ft {
  flex-shrink: 0;
  margin-top: 0;
  padding: 12rpx 48rpx calc(8rpx + env(safe-area-inset-bottom)) 28rpx;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
  align-items: center;
  justify-content: flex-end;
  gap: 28rpx;
}

.sheet-confirm-ft button.btn-confirm-disabled[disabled] {
  color: var(--color-text-muted) !important;
  border-color: var(--color-border) !important;
  background: var(--color-surface-soft) !important;
  opacity: 1 !important;
}

.sheet-market-scale {
  max-height: 70vh;
}

.scale-cards {
  padding: 8rpx 28rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.scale-card {
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 10rpx 8rpx 10rpx 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-bg);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  overflow: visible;
}

.scale-card.on {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.scale-card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.scale-card-title {
  font-size: var(--fs-title);
  font-weight: var(--fw-semibold);
  color: var(--color-text);
  line-height: 1.3;
}

.scale-card.on .scale-card-title {
  color: var(--color-primary);
}

/* heightFix：高度撑满，宽度按比例变宽；margin-left:auto 贴右 */
.scale-card-icon {
  flex-shrink: 0;
  display: block;
  margin-left: auto;
  height: 100rpx;
  width: auto;
}

.scale-card-icon--small {
  /* 小档接近方形，略收一点宽 */
  height: 100rpx;
}

.scale-card-icon--medium,
.scale-card-icon--large {
  height: 100rpx;
}

.scale-card-desc {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  line-height: 1.35;
}

.scale-actions {
  flex-shrink: 0;
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 28rpx;
  border-top: 1rpx solid var(--color-border);
}

.scale-actions button.btn-confirm-disabled[disabled] {
  color: var(--color-text-muted) !important;
  border-color: var(--color-border) !important;
  background: var(--color-surface-soft) !important;
  opacity: 1 !important;
}

/* Icon assets */
.btn-main,
.home-cta-side {
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  line-height: normal !important;
}

.home-nav-card {
  flex-direction: column;
  gap: 8rpx;
}

.home-cta-icon {
  width: 60rpx;
  height: 60rpx;
}

.home-secondary-icon {
  width: 60rpx;
  height: 60rpx;
}

.home-nav-icon-wrap {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.home-nav-icon-wrap--crate { background: #edf5e3; }
.home-nav-icon-wrap--heart { background: #fbe6e1; }
.home-nav-icon-wrap--chat { background: #eef4eb; }

.home-nav-icon {
  width: 68rpx;
  height: 68rpx;
}

/* —— 首启①→②：蒙层内水平+垂直居中；指南从序号下抽屉展开 —— */
.user-no-ceremony {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 左右留白加大，卡片在屏幕正中 */
  padding: 48rpx 56rpx;
  box-sizing: border-box;
  z-index: 300;
}

.ceremony-stage {
  width: 100%;
  max-width: 640rpx;
  margin: 0 auto;
  flex-shrink: 0;
}

.ceremony-card {
  width: 100%;
  box-sizing: border-box;
  background: var(--color-surface);
  border-radius: var(--radius-sheet);
  overflow: hidden;
}

/* 礼花期间允许溢出，纸屑可从数字处向外散开 */
.ceremony-card.is-confetti {
  overflow: visible;
}

.ceremony-welcome {
  padding: 48rpx 40rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

/* 一行：欢迎！第 N 位大厨！；整行水平居中，数字与两侧文字垂直居中 */
.ceremony-line {
  width: auto;
  max-width: 100%;
  margin: 0 auto;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.ceremony-line-text {
  flex-shrink: 0;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--color-text);
  line-height: 1;
}

.ceremony-roll-anchor {
  position: relative;
  flex-shrink: 0;
  margin: 0 4rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.ceremony-roll {
  font-size: var(--fs-brand);
  font-weight: 700;
  line-height: 1;
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
}

/* 抽屉：默认收起；从序号下方向下展开 */
.ceremony-drawer {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition:
    max-height 1.5s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 1s ease;
}

.ceremony-phase-transition .ceremony-drawer,
.ceremony-phase-steps .ceremony-drawer {
  max-height: 900rpx;
  opacity: 1;
}

.ceremony-steps {
  padding: 8rpx 40rpx 40rpx;
  box-sizing: border-box;
  text-align: left;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.ceremony-steps-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  font-size: var(--fs-lead);
  font-weight: 600;
  color: var(--color-text);
  text-align: left;
  line-height: 1.4;
}

.ceremony-steps-mark {
  flex-shrink: 0;
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--color-primary);
}

.ceremony-step-list {
  width: 100%;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
}

.ceremony-step {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}

.ceremony-step-rail {
  flex-shrink: 0;
  width: 56rpx;
  margin-right: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  align-self: stretch;
}

.ceremony-step-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: var(--fs-md);
  font-weight: 700;
  line-height: 56rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}

.ceremony-step-line {
  width: 2rpx;
  flex: 1;
  min-height: 28rpx;
  margin: 8rpx 0;
  background: rgba(82, 127, 85, 0.28);
}

.ceremony-step--last .ceremony-step-rail {
  margin-bottom: 0;
}

.ceremony-step-body {
  flex: 1;
  min-width: 0;
  padding-top: 6rpx;
  padding-bottom: 28rpx;
}

.ceremony-step--last .ceremony-step-body {
  padding-bottom: 4rpx;
}

.ceremony-step-name {
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.4;
  color: var(--color-text);
  text-align: left;
}

.ceremony-step-desc {
  margin-top: 8rpx;
  font-size: var(--fs-body);
  line-height: 1.55;
  color: var(--color-text-secondary);
  text-align: left;
  white-space: nowrap;
}

.ceremony-actions {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 28rpx;
}

.ceremony-btn-primary,
.ceremony-btn-secondary {
  flex: 1;
  margin: 0;
  width: auto;
  min-width: 0;
  padding: 0 12rpx !important;
  box-sizing: border-box;
  white-space: nowrap;
  font-size: var(--fs-btn) !important;
  line-height: 2.2;
}

.ceremony-btn-primary::after,
.ceremony-btn-secondary::after {
  border: none !important;
}

/* 礼花：锚定在数字中心，向左右散开后再开抽屉 */
.ceremony-confetti {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  pointer-events: none;
  z-index: 2;
  overflow: visible;
}

.ceremony-confetti-piece {
  position: absolute;
  left: 0;
  top: 0;
  margin-left: -6rpx;
  margin-top: -8rpx;
  border-radius: 2rpx;
  opacity: 0;
  animation-duration: 1.05s;
  animation-timing-function: cubic-bezier(0.08, 0.65, 0.2, 1);
  animation-fill-mode: forwards;
}

.ceremony-confetti-piece.is-round {
  border-radius: 50%;
}

.ceremony-burst-l0 { animation-name: ceremony-burst-l0; }
.ceremony-burst-l1 { animation-name: ceremony-burst-l1; }
.ceremony-burst-l2 { animation-name: ceremony-burst-l2; }
.ceremony-burst-l3 { animation-name: ceremony-burst-l3; }
.ceremony-burst-l4 { animation-name: ceremony-burst-l4; }
.ceremony-burst-l5 { animation-name: ceremony-burst-l5; }
.ceremony-burst-l6 { animation-name: ceremony-burst-l6; }
.ceremony-burst-l7 { animation-name: ceremony-burst-l7; }
.ceremony-burst-r0 { animation-name: ceremony-burst-r0; }
.ceremony-burst-r1 { animation-name: ceremony-burst-r1; }
.ceremony-burst-r2 { animation-name: ceremony-burst-r2; }
.ceremony-burst-r3 { animation-name: ceremony-burst-r3; }
.ceremony-burst-r4 { animation-name: ceremony-burst-r4; }
.ceremony-burst-r5 { animation-name: ceremony-burst-r5; }
.ceremony-burst-r6 { animation-name: ceremony-burst-r6; }
.ceremony-burst-r7 { animation-name: ceremony-burst-r7; }

@keyframes ceremony-burst-l0 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(-220rpx, -180rpx, 0) rotate(-220deg); }
}
@keyframes ceremony-burst-l1 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(-300rpx, -80rpx, 0) rotate(-300deg); }
}
@keyframes ceremony-burst-l2 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(-260rpx, 40rpx, 0) rotate(-160deg); }
}
@keyframes ceremony-burst-l3 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(-340rpx, -40rpx, 0) rotate(-400deg); }
}
@keyframes ceremony-burst-l4 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(-180rpx, -240rpx, 0) rotate(-120deg); }
}
@keyframes ceremony-burst-l5 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(-280rpx, 120rpx, 0) rotate(-260deg); }
}
@keyframes ceremony-burst-l6 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(-360rpx, -140rpx, 0) rotate(-340deg); }
}
@keyframes ceremony-burst-l7 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(-200rpx, 90rpx, 0) rotate(-180deg); }
}
@keyframes ceremony-burst-r0 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(220rpx, -180rpx, 0) rotate(220deg); }
}
@keyframes ceremony-burst-r1 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(300rpx, -80rpx, 0) rotate(300deg); }
}
@keyframes ceremony-burst-r2 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(260rpx, 40rpx, 0) rotate(160deg); }
}
@keyframes ceremony-burst-r3 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(340rpx, -40rpx, 0) rotate(400deg); }
}
@keyframes ceremony-burst-r4 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(180rpx, -240rpx, 0) rotate(120deg); }
}
@keyframes ceremony-burst-r5 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(280rpx, 120rpx, 0) rotate(260deg); }
}
@keyframes ceremony-burst-r6 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(360rpx, -140rpx, 0) rotate(340deg); }
}
@keyframes ceremony-burst-r7 {
  0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(200rpx, 90rpx, 0) rotate(180deg); }
}


