.wrap {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 24rpx;
}

.brand {
  font-size: 48rpx;
  font-weight: 600;
  text-align: center;
  margin: 80rpx 0 48rpx;
  color: #111;
}

.link {
  margin-top: 32rpx;
  text-align: center;
  color: #576b95;
  font-size: 30rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 70vh;
  overflow-y: auto;
}

.sheet-title {
  font-weight: 600;
  font-size: 32rpx;
}

.sheet-hint {
  color: #888;
  font-size: 24rpx;
  margin: 8rpx 0 16rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 28rpx;
}

.row.on {
  color: #2e7d32;
}

.check {
  width: 40rpx;
  margin-right: 12rpx;
  color: #2e7d32;
}

.sheet-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}
