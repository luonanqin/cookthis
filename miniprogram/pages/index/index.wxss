.root {
  min-height: 100vh;
  background: var(--color-bg);
}

.wrap {
  min-height: 100vh;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  background: var(--color-bg);
}

.btn-type-scale {
  margin-top: 12rpx;
  margin-bottom: 0;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 96rpx 0 72rpx;
}

.pot {
  width: 120rpx;
  height: 110rpx;
  position: relative;
  margin-bottom: 28rpx;
  display: flex;
  justify-content: center;
  gap: 10rpx;
}

.steam {
  width: 4rpx;
  height: 28rpx;
  background: var(--color-text);
  border-radius: 4rpx;
  margin-top: 4rpx;
  opacity: 0.85;
}

.steam.mid {
  height: 36rpx;
  margin-top: 0;
}

.pot-body {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 0;
  height: 56rpx;
  border: 4rpx solid var(--color-text);
  border-radius: 0 0 12rpx 12rpx;
  border-top: 6rpx solid var(--color-text);
  box-sizing: border-box;
}

.pot-body::after {
  content: '';
  position: absolute;
  right: -18rpx;
  bottom: 10rpx;
  width: 22rpx;
  height: 14rpx;
  border: 3rpx solid var(--color-primary);
  border-left: none;
  border-radius: 0 10rpx 10rpx 0;
}

.brand {
  font-size: var(--fs-brand);
  font-weight: 650;
  letter-spacing: 2rpx;
  color: var(--color-text);
  text-align: center;
}

.rule {
  width: 64rpx;
  height: 2rpx;
  background: var(--color-border);
  margin-top: 28rpx;
  position: relative;
}

.rule::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  margin: -4rpx 0 0 -4rpx;
  border-radius: 50%;
  background: var(--color-border);
}

.btn-main {
  margin-bottom: 20rpx;
}

.btn-outline {
  margin-bottom: 8rpx;
}

.link-row {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
  gap: 48rpx;
}

.link {
  text-align: center;
  color: var(--color-primary);
  font-size: var(--fs-body);
}

/* 进场确认：独立半屏弹层（不套 .sheet，避免 overflow 把按钮顶飞） */
.sheet-confirm {
  width: 100%;
  max-height: 60vh;
  background: var(--color-surface);
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sheet-confirm-hd {
  flex-shrink: 0;
  padding: 32rpx 28rpx 0;
}

.sheet-confirm-hd .sheet-hint {
  margin-bottom: 8rpx;
}

/* 两列 chip；需滚动时完整露出 3 行，并裁切半行提示可滑 */
.sheet-confirm-list-wrap {
  position: relative;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.sheet-confirm-list-wrap.peek {
  /* 3×76 + 2×12 gap + 半行约 40 ≈ 完整 3 行 + 漏出一点 */
  height: 292rpx;
}

.sheet-confirm-list {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.sheet-confirm-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  /* 滑到底时最后一行完整露出，并与底部分隔 */
  padding: 4rpx 0 32rpx;
  box-sizing: border-box;
}

.sheet-chip {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 16rpx 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: var(--fs-md);
  color: var(--color-text);
  background: var(--color-bg);
}

.sheet-chip.on {
  color: var(--color-primary);
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.sheet-chip .check {
  width: 28rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
  color: var(--color-primary);
  font-size: var(--fs-sm);
}

.sheet-chip-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-confirm-ft {
  flex-shrink: 0;
  margin-top: 0;
  /* 仍靠右，右侧多留边距避免贴边难点 */
  padding: 12rpx 48rpx calc(8rpx + env(safe-area-inset-bottom)) 28rpx;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
  align-items: center;
  justify-content: flex-end;
  gap: 28rpx;
}

/* mini 按钮默认 line-height:2 易让字显偏上，这里垂直居中 */
.sheet-confirm-ft button[size='mini'] {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  margin: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
