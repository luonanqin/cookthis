.root {
  min-height: 100vh;
  background: var(--color-bg);
}

.home {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.home-hero {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-header);
  /* 750×730 近方形 widthFix 图片自然撑开约 730rpx；整图显示不裁切 */
}

.home-hero__img {
  position: relative;
  display: block;
  width: 100%;
  height: auto;
  vertical-align: top;
  z-index: 0;
}

.home-hero__wave {
  position: absolute;
  left: -8%;
  right: -8%;
  bottom: -2rpx;
  height: 56rpx;
  background: var(--color-bg);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  z-index: 3;
  pointer-events: none;
}

.home-body {
  flex: 1;
  padding: 0 40rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.home-question-image {
  display: block;
  width: 100%;
  height: 150rpx;
  margin: 0 auto;
  object-fit: contain;
}

.home-sub {
  margin-top: 8rpx;
  margin-bottom: 72rpx;
  /* 比主按钮 --fs-title 小一档 */
  font-size: var(--fs-btn);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.5;
}

.home-cta-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.home-cta-side {
  flex: 1;
  margin: 0 !important;
  height: 96rpx !important;
  border-radius: var(--radius-pill) !important;
}

.btn-main {
  font-weight: 600 !important;
  font-size: var(--fs-title) !important;
}

.home-nav {
  display: flex;
  gap: 16rpx;
}

.home-type-scale {
  margin-top: 20rpx;
  align-self: flex-end;
  width: 64rpx;
  height: 64rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 2rpx solid var(--color-primary);
  background: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(39, 51, 46, 0.06);
}

.home-type-scale__glyph {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1;
}

.home-nav-card {
  position: relative;
  flex: 1;
  min-height: 148rpx;
  padding: 16rpx 12rpx 18rpx;
  box-sizing: border-box;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(39, 51, 46, 0.04);
}

.home-nav-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--color-text);
  text-align: center;
  line-height: 1.3;
}

.link-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #e54d42;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  font-weight: 600;
}

.link-dot {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e54d42;
}

.link-dev {
  margin-top: 20rpx;
  padding: 24rpx 16rpx;
  box-sizing: border-box;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
}

.dev-scale-panel {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--color-border);
}

.dev-scale-title {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.dev-scale-status {
  font-size: var(--fs-xs);
  line-height: 1.5;
  color: var(--color-text-muted);
  white-space: pre-wrap;
}

.dev-scale-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 28rpx;
  margin-top: 4rpx;
}

.dev-scale-actions .link-dev {
  margin-top: 0;
  padding: 24rpx 8rpx;
  justify-content: flex-start;
}

/* 进场确认：独立半屏弹层 */
.sheet-confirm {
  width: 100%;
  max-height: 60vh;
  background: var(--color-surface);
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sheet-confirm-hd {
  flex-shrink: 0;
  padding: 32rpx 28rpx 0;
}

.sheet-confirm-hd .sheet-hint {
  margin-bottom: 8rpx;
}

.sheet-confirm-list-wrap {
  position: relative;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.sheet-confirm-list-wrap.peek {
  height: 292rpx;
}

.sheet-confirm-list {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.sheet-confirm-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 4rpx 0 32rpx;
  box-sizing: border-box;
}

.sheet-chip {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 16rpx 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-chip);
  font-size: var(--fs-md);
  color: var(--color-text);
  background: var(--color-bg);
}

.sheet-chip.on {
  color: var(--color-primary);
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.sheet-chip .check {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-control);
  text-align: center;
  line-height: 28rpx;
  color: var(--color-primary);
  font-size: var(--fs-xs);
  background: var(--color-surface);
}

.sheet-chip.on .check {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.sheet-chip-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-confirm-ft {
  flex-shrink: 0;
  margin-top: 0;
  padding: 12rpx 48rpx calc(8rpx + env(safe-area-inset-bottom)) 28rpx;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
  align-items: center;
  justify-content: flex-end;
  gap: 28rpx;
}

.sheet-confirm-ft button[size='mini'] {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  margin: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.sheet-confirm-ft button.btn-confirm-disabled[disabled] {
  color: var(--color-text-muted) !important;
  border-color: var(--color-border) !important;
  background: var(--color-surface-soft) !important;
  opacity: 1 !important;
}

.sheet-market-scale {
  max-height: 70vh;
}

.scale-cards {
  padding: 8rpx 28rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.scale-card {
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.scale-card.on {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.scale-card-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.3;
}

.scale-card.on .scale-card-title {
  color: var(--color-primary);
}

.scale-card-desc {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  line-height: 1.35;
}

.scale-default-wrap {
  flex-shrink: 0;
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  align-items: center;
}

.scale-default-wrap .scale-default-btn {
  margin: 0;
  min-width: 240rpx;
}

.scale-default-wrap .scale-default-btn.on {
  background: var(--color-primary-soft) !important;
}

/* Icon assets */
.btn-main,
.home-cta-side {
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  line-height: normal !important;
}

.home-nav-card {
  flex-direction: column;
  gap: 8rpx;
}

.home-cta-icon {
  width: 60rpx;
  height: 60rpx;
}

.home-secondary-icon {
  width: 60rpx;
  height: 60rpx;
}

.home-nav-icon-wrap {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.home-nav-icon-wrap--crate { background: #edf5e3; }
.home-nav-icon-wrap--heart { background: #fbe6e1; }
.home-nav-icon-wrap--chat { background: #eef4eb; }

.home-nav-icon {
  width: 68rpx;
  height: 68rpx;
}


