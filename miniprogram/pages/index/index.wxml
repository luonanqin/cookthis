<view class="root {{typeScaleClass}}">
  <view class="home">
    <!-- 主视觉贴顶：整图等比缩放不裁切；底部波浪做过渡 -->
    <view class="home-hero">
      <image
        class="home-hero__img"
        src="/assets/images/home-market-hero.jpg"
        mode="widthFix"
        aria-label="买菜没烦恼，从菜场到餐桌让每天吃饭更简单"
      />
      <view class="home-hero__wave" aria-hidden="true"></view>
    </view>

    <view class="home-body">
      <image class="home-question-image" src="/assets/images/home-question-title.webp" mode="aspectFit" aria-label="不知道今天买什么菜？" />
      <view class="home-sub">选好食材，回家做饭</view>

      <view class="home-cta-row">
        <button class="btn-outline home-cta-side" bindtap="goRecord"><image class="ui-icon home-secondary-icon" src="/assets/images/icons/home-notebook-green.png" mode="aspectFit" aria-hidden="true"/><text>记一下</text></button>
        <button
          class="btn-main home-cta-side"
          type="primary"
          disabled="{{busy}}"
          bindtap="goMarket"
        ><image class="ui-icon home-cta-icon" src="/assets/images/icons/home-basket-white.png" mode="aspectFit" aria-hidden="true"/><text>今日菜场</text></button>
      </view>

      <view class="home-nav">
        <view class="home-nav-card" hover-class="tap-hover" hover-stay-time="80" bindtap="goAcceptedPlans">
          <view class="home-nav-icon-wrap home-nav-icon-wrap--crate"><image class="ui-icon home-nav-icon" src="/assets/images/icons/home-vegetable-crate.png" mode="aspectFit" aria-hidden="true"/></view><view class="home-nav-title">已选菜品</view>
        </view>
        <view class="home-nav-card home-nav-mine" hover-class="tap-hover" hover-stay-time="80" bindtap="goMine">
          <view class="home-nav-icon-wrap home-nav-icon-wrap--heart"><image class="ui-icon home-nav-icon" src="/assets/images/icons/home-heart-coral.png" mode="aspectFit" aria-hidden="true"/></view><view class="home-nav-title">我的偏好</view>
          <view wx:if="{{profileGapCount > 0}}" class="link-badge">{{profileGapCount}}</view>
        </view>
        <view class="home-nav-card home-nav-feedback" hover-class="tap-hover" hover-stay-time="80" bindtap="goFeedback">
          <view class="home-nav-icon-wrap home-nav-icon-wrap--chat"><image class="ui-icon home-nav-icon" src="/assets/images/icons/feedback-other.png" mode="aspectFit" aria-hidden="true"/></view><view class="home-nav-title">建议反馈</view>
          <view wx:if="{{feedbackHasUnread}}" class="link-dot"></view>
        </view>
      </view>

      <view
        class="home-type-scale"
        hover-class="tap-hover"
        hover-stay-time="80"
        bindtap="onToggleTypeScale"
        aria-role="button"
        aria-label="{{largeText ? '切换为小字' : '切换为大字'}}"
      >
        <text class="home-type-scale__glyph">{{typeScaleLabel}}</text>
      </view>

      <!-- 首页底部测试区暂隐；需要时把 showHomeDevTools 设为 true -->
      <block wx:if="{{showHomeDevTools}}">
        <view
          class="link link-dev"
          hover-class="tap-hover"
          hover-stay-time="80"
          bindtap="onResetPreferenceTest"
        >重置偏好（测试）</view>

        <view wx:if="{{showMarketScaleDebug}}" class="dev-scale-panel">
          <view class="dev-scale-title">菜场规模（测试）</view>
          <view class="dev-scale-status">{{marketScaleDebugStatus}}</view>
          <view class="dev-scale-actions">
            <view
              class="link link-dev"
              hover-class="tap-hover"
              hover-stay-time="80"
              bindtap="onDebugMarketScaleClear"
            >清规模状态</view>
            <view
              class="link link-dev"
              hover-class="tap-hover"
              hover-stay-time="80"
              bindtap="onDebugMarketScaleReadyRelocate"
            >设为可再弹</view>
            <view
              class="link link-dev"
              hover-class="tap-hover"
              hover-stay-time="80"
              bindtap="onDebugMarketScaleClearSession"
            >清会话已弹</view>
            <view
              class="link link-dev"
              hover-class="tap-hover"
              hover-stay-time="80"
              bindtap="onDebugToggleForceNoLocation"
            >{{debugForceNoLocationLabel}}</view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="mask" wx:if="{{showConfirm}}" catchtouchmove="true">
    <view class="sheet-confirm">
      <view class="sheet-confirm-hd">
        <view class="sheet-title">最近有吃过这些吗？</view>
      </view>
      <view class="sheet-confirm-list-wrap {{candidatesPeek ? 'peek' : ''}}">
        <scroll-view wx:if="{{candidatesPeek}}" class="sheet-confirm-list" scroll-y>
          <view class="sheet-confirm-grid">
            <view
              class="sheet-chip {{selected[item] ? 'on' : ''}}"
              wx:for="{{candidates}}"
              wx:key="*this"
              data-name="{{item}}"
              bindtap="onToggleDish"
            >
              <view class="check">{{selected[item] ? '✓' : ''}}</view>
              <text class="sheet-chip-text">{{item}}</text>
            </view>
          </view>
        </scroll-view>
        <view wx:else class="sheet-confirm-grid">
          <view
            class="sheet-chip {{selected[item] ? 'on' : ''}}"
            wx:for="{{candidates}}"
            wx:key="*this"
            data-name="{{item}}"
            bindtap="onToggleDish"
          >
            <view class="check">{{selected[item] ? '✓' : ''}}</view>
            <text class="sheet-chip-text">{{item}}</text>
          </view>
        </view>
      </view>
      <view class="sheet-confirm-ft sheet-actions">
        <button size="mini" class="btn-outline" bindtap="onSelectAll">{{selectAllLabel}}</button>
        <button
          size="mini"
          class="{{hasSelected ? '' : 'btn-outline btn-confirm-disabled'}}"
          type="{{hasSelected ? 'primary' : 'default'}}"
          disabled="{{busy || !hasSelected}}"
          bindtap="onConfirmSubmit"
        >确认</button>
        <button size="mini" class="btn-outline" bindtap="onConfirmSkip">跳过</button>
      </view>
    </view>
  </view>

  <!-- 规模半屏：仅在进场确认关闭之后；遮罩不关层；与进场确认禁止同屏 -->
  <view
    class="mask"
    wx:if="{{showMarketScale}}"
    catchtouchmove="true"
    catchtap="noop"
  >
    <view class="sheet-confirm sheet-market-scale">
      <view class="sheet-confirm-hd">
        <view class="sheet-title">{{marketScaleTitle}}</view>
        <view class="sheet-hint">{{marketScaleHint}}</view>
      </view>
      <view class="scale-cards">
        <view
          class="scale-card {{marketScaleHighlight === 'small' ? 'on' : ''}}"
          hover-class="tap-hover"
          hover-stay-time="80"
          data-choice="small"
          bindtap="onMarketScaleSelect"
        >
          <view class="scale-card-title">小菜场</view>
          <view class="scale-card-desc">小门面、路边摊位</view>
        </view>
        <view
          class="scale-card {{marketScaleHighlight === 'medium' ? 'on' : ''}}"
          hover-class="tap-hover"
          hover-stay-time="80"
          data-choice="medium"
          bindtap="onMarketScaleSelect"
        >
          <view class="scale-card-title">中菜场</view>
          <view class="scale-card-desc">普通超市、连着几个门面</view>
        </view>
        <view
          class="scale-card {{marketScaleHighlight === 'large' ? 'on' : ''}}"
          hover-class="tap-hover"
          hover-stay-time="80"
          data-choice="large"
          bindtap="onMarketScaleSelect"
        >
          <view class="scale-card-title">大菜场</view>
          <view class="scale-card-desc">集贸市场、大超市、很多摊位</view>
        </view>
      </view>
      <view class="scale-default-wrap">
        <button
          size="mini"
          class="btn-outline scale-default-btn {{marketScaleDefaultOn ? 'on' : ''}}"
          data-choice="default_medium"
          disabled="{{busy}}"
          bindtap="onMarketScaleSelect"
        >默认中菜场</button>
      </view>
    </view>
  </view>
</view>
