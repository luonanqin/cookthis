<view class="root {{typeScaleClass}}">
  <view class="wrap">
    <view class="hero">
      <view class="pot" aria-hidden="true">
        <view class="steam"></view>
        <view class="steam mid"></view>
        <view class="steam"></view>
        <view class="pot-body"></view>
      </view>
      <view class="brand">买菜做什么</view>
      <view class="rule"></view>
    </view>

    <button
      class="btn-main"
      type="primary"
      disabled="{{busy}}"
      bindtap="goMarket"
    >今天菜场有什么</button>
    <button class="btn-outline" bindtap="goRecord">记一下吃了什么</button>
    <button class="btn-outline btn-type-scale" bindtap="onToggleTypeScale">{{typeScaleLabel}}</button>
    <view class="link-row">
      <view class="link" hover-class="tap-hover" hover-stay-time="80" bindtap="goAcceptedPlans">已选菜品</view>
      <view class="link link-mine" hover-class="tap-hover" hover-stay-time="80" bindtap="goMine">
        <text>我的偏好</text>
        <view wx:if="{{profileGapCount > 0}}" class="link-badge">{{profileGapCount}}</view>
      </view>
      <view class="link link-feedback" hover-class="tap-hover" hover-stay-time="80" bindtap="goFeedback">
        <text>建议反馈</text>
        <view wx:if="{{feedbackHasUnread}}" class="link-dot"></view>
      </view>
    </view>
    <view
      class="link link-dev"
      hover-class="tap-hover"
      hover-stay-time="80"
      bindtap="onResetPreferenceTest"
    >重置偏好（测试）</view>
  </view>

  <view class="mask" wx:if="{{showConfirm}}" catchtouchmove="true">
    <view class="sheet-confirm">
      <view class="sheet-confirm-hd">
        <view class="sheet-title">最近有吃过这些吗？</view>
      </view>
      <view class="sheet-confirm-list-wrap {{candidatesPeek ? 'peek' : ''}}">
        <scroll-view wx:if="{{candidatesPeek}}" class="sheet-confirm-list" scroll-y>
          <view class="sheet-confirm-grid">
            <view
              class="sheet-chip {{selected[item] ? 'on' : ''}}"
              wx:for="{{candidates}}"
              wx:key="*this"
              data-name="{{item}}"
              bindtap="onToggleDish"
            >
              <view class="check">{{selected[item] ? '✓' : ''}}</view>
              <text class="sheet-chip-text">{{item}}</text>
            </view>
          </view>
        </scroll-view>
        <view wx:else class="sheet-confirm-grid">
          <view
            class="sheet-chip {{selected[item] ? 'on' : ''}}"
            wx:for="{{candidates}}"
            wx:key="*this"
            data-name="{{item}}"
            bindtap="onToggleDish"
          >
            <view class="check">{{selected[item] ? '✓' : ''}}</view>
            <text class="sheet-chip-text">{{item}}</text>
          </view>
        </view>
      </view>
      <view class="sheet-confirm-ft sheet-actions">
        <button size="mini" class="btn-outline" bindtap="onSelectAll">{{selectAllLabel}}</button>
        <button
          size="mini"
          class="{{hasSelected ? '' : 'btn-outline btn-confirm-disabled'}}"
          type="{{hasSelected ? 'primary' : 'default'}}"
          disabled="{{busy || !hasSelected}}"
          bindtap="onConfirmSubmit"
        >确认</button>
        <button size="mini" class="btn-outline" bindtap="onConfirmSkip">跳过</button>
      </view>
    </view>
  </view>

  <!-- 规模半屏：仅在进场确认关闭之后；遮罩不关层；与进场确认禁止同屏 -->
  <view
    class="mask"
    wx:if="{{showMarketScale}}"
    catchtouchmove="true"
    catchtap="noop"
  >
    <view class="sheet-confirm sheet-market-scale">
      <view class="sheet-confirm-hd">
        <view class="sheet-title">{{marketScaleTitle}}</view>
        <view class="sheet-hint">{{marketScaleHint}}</view>
      </view>
      <view class="scale-cards">
        <view
          class="scale-card"
          hover-class="tap-hover"
          hover-stay-time="80"
          data-choice="small"
          bindtap="onMarketScaleSelect"
        >
          <view class="scale-card-title">小菜场</view>
          <view class="scale-card-desc">小门面、路边摊位</view>
        </view>
        <view
          class="scale-card"
          hover-class="tap-hover"
          hover-stay-time="80"
          data-choice="medium"
          bindtap="onMarketScaleSelect"
        >
          <view class="scale-card-title">中菜场</view>
          <view class="scale-card-desc">小超市、连着几个门面</view>
        </view>
        <view
          class="scale-card"
          hover-class="tap-hover"
          hover-stay-time="80"
          data-choice="large"
          bindtap="onMarketScaleSelect"
        >
          <view class="scale-card-title">大菜场</view>
          <view class="scale-card-desc">集贸市场、大超市、很多摊位</view>
        </view>
      </view>
      <view class="scale-default-wrap">
        <button
          size="mini"
          class="btn-outline scale-default-btn"
          data-choice="default_medium"
          disabled="{{busy}}"
          bindtap="onMarketScaleSelect"
        >默认中菜场</button>
      </view>
    </view>
  </view>
</view>
