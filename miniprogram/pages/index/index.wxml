<view class="root {{typeScaleClass}}">
  <view class="home">
    <!-- 主视觉贴顶：整图等比缩放不裁切；底部波浪做过渡 -->
    <view class="home-hero">
      <image
        class="home-hero__img"
        src="/assets/images/home-market-hero.jpg"
        mode="widthFix"
        aria-label="买菜没烦恼"
      />
      <view class="home-hero__wave" aria-hidden="true"></view>
    </view>

    <view class="home-body">
      <image class="home-question-image" src="/assets/images/home-question-title.jpg" mode="aspectFit" aria-label="让买菜变成一件容易的事。" />
      <view class="home-sub">选好食材，回家做饭</view>

      <view class="home-cta-row">
        <button class="btn-outline home-cta-side" bindtap="goRecord"><image class="ui-icon home-secondary-icon" src="/assets/images/icons/home-notebook-green.png" mode="aspectFit" aria-hidden="true"/><text>记一下</text></button>
        <button
          class="btn-main home-cta-side"
          type="primary"
          disabled="{{busy}}"
          bindtap="goMarket"
        ><image class="ui-icon home-cta-icon" src="/assets/images/icons/home-basket-white.png" mode="aspectFit" aria-hidden="true"/><text>今日菜场</text></button>
      </view>

      <view class="home-nav">
        <view class="home-nav-card" hover-class="tap-hover" hover-stay-time="80" bindtap="goAcceptedPlans">
          <view class="home-nav-icon-wrap home-nav-icon-wrap--crate"><image class="ui-icon home-nav-icon" src="/assets/images/icons/home-vegetable-crate.png" mode="aspectFit" aria-hidden="true"/></view><view class="home-nav-title">已选菜品</view>
        </view>
        <view class="home-nav-card home-nav-mine" hover-class="tap-hover" hover-stay-time="80" bindtap="goMine">
          <view class="home-nav-icon-wrap home-nav-icon-wrap--heart"><image class="ui-icon home-nav-icon" src="/assets/images/icons/home-heart-coral.png" mode="aspectFit" aria-hidden="true"/></view><view class="home-nav-title">我的偏好</view>
          <view wx:if="{{profileGapCount > 0}}" class="link-badge">{{profileGapCount}}</view>
        </view>
        <view class="home-nav-card home-nav-feedback" hover-class="tap-hover" hover-stay-time="80" bindtap="goFeedback">
          <view class="home-nav-icon-wrap home-nav-icon-wrap--chat"><image class="ui-icon home-nav-icon" src="/assets/images/icons/feedback-other.png" mode="aspectFit" aria-hidden="true"/></view><view class="home-nav-title">建议反馈</view>
          <view wx:if="{{feedbackHasUnread}}" class="link-dot"></view>
        </view>
      </view>

      <view class="home-top-tools">
        <view
          wx:if="{{membershipEnabled}}"
          class="home-vip-entry"
          hover-class="tap-hover"
          hover-stay-time="80"
          bindtap="goMembership"
          aria-role="button"
          aria-label="会员"
        >
          <image
            class="home-vip-entry__img"
            src="/assets/images/membership-vip-spark.png"
            mode="aspectFit"
          />
        </view>
        <view
          class="home-type-scale"
          hover-class="tap-hover"
          hover-stay-time="80"
          bindtap="onToggleTypeScale"
          aria-role="button"
          aria-label="{{largeText ? '切换为小字' : '切换为大字'}}"
        >
          <text class="home-type-scale__glyph">{{typeScaleLabel}}</text>
        </view>
      </view>

      <!-- 开发/体验可见测试入口 -->
      <block wx:if="{{showHomeDevTools}}">
        <view
          class="link link-dev"
          hover-class="tap-hover"
          hover-stay-time="80"
          bindtap="onDebugReplayUserNoCeremony"
        >重播首启仪式 · 100000（测试）</view>
        <view
          class="link link-dev"
          hover-class="tap-hover"
          hover-stay-time="80"
          bindtap="onResetPreferenceTest"
        >重置偏好（测试）</view>
        <view
          class="link link-dev"
          hover-class="tap-hover"
          hover-stay-time="80"
          bindtap="onDebugClearDailyMealAdUnlock"
        >清除「更多餐」广告解锁（测试）</view>

        <view wx:if="{{showMarketScaleDebug}}" class="dev-scale-panel">
          <view class="dev-scale-title">菜场规模（测试）</view>
          <view class="dev-scale-status">{{marketScaleDebugStatus}}</view>
          <view class="dev-scale-actions">
            <view
              class="link link-dev"
              hover-class="tap-hover"
              hover-stay-time="80"
              bindtap="onDebugMarketScaleClear"
            >清规模状态</view>
            <view
              class="link link-dev"
              hover-class="tap-hover"
              hover-stay-time="80"
              bindtap="onDebugMarketScaleReadyRelocate"
            >设为可再弹</view>
            <view
              class="link link-dev"
              hover-class="tap-hover"
              hover-stay-time="80"
              bindtap="onDebugMarketScaleClearSession"
            >清会话已弹</view>
            <view
              class="link link-dev"
              hover-class="tap-hover"
              hover-stay-time="80"
              bindtap="onDebugToggleForceNoLocation"
            >{{debugForceNoLocationLabel}}</view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="mask" wx:if="{{showConfirm}}" catchtouchmove="true">
    <view class="sheet-confirm">
      <view class="sheet-confirm-hd">
        <view class="sheet-title">最近有吃过这些吗？</view>
      </view>
      <view class="sheet-confirm-list-wrap {{candidatesPeek ? 'peek' : ''}}">
        <scroll-view wx:if="{{candidatesPeek}}" class="sheet-confirm-list" scroll-y>
          <view class="sheet-confirm-grid">
            <view
              class="sheet-chip {{selected[item] ? 'on' : ''}}"
              wx:for="{{candidates}}"
              wx:key="*this"
              data-name="{{item}}"
              bindtap="onToggleDish"
            >
              <view class="check">{{selected[item] ? '✓' : ''}}</view>
              <text class="sheet-chip-text">{{item}}</text>
            </view>
          </view>
        </scroll-view>
        <view wx:else class="sheet-confirm-grid">
          <view
            class="sheet-chip {{selected[item] ? 'on' : ''}}"
            wx:for="{{candidates}}"
            wx:key="*this"
            data-name="{{item}}"
            bindtap="onToggleDish"
          >
            <view class="check">{{selected[item] ? '✓' : ''}}</view>
            <text class="sheet-chip-text">{{item}}</text>
          </view>
        </view>
      </view>
      <view class="sheet-confirm-ft sheet-actions">
        <button size="mini" class="btn-outline" bindtap="onSelectAll">{{selectAllLabel}}</button>
        <button
          size="mini"
          class="{{hasSelected ? '' : 'btn-outline btn-confirm-disabled'}}"
          type="{{hasSelected ? 'primary' : 'default'}}"
          disabled="{{busy || !hasSelected}}"
          bindtap="onConfirmSubmit"
        >确 认</button>
        <button size="mini" class="btn-outline" bindtap="onConfirmSkip">跳 过</button>
      </view>
    </view>
  </view>

  <!-- 规模半屏：仅在进场确认关闭之后；遮罩不关层；与进场确认禁止同屏 -->
  <view
    class="mask"
    wx:if="{{showMarketScale}}"
    catchtouchmove="true"
    catchtap="noop"
  >
    <view class="sheet-confirm sheet-market-scale">
      <view class="sheet-confirm-hd">
        <view class="sheet-title">{{marketScaleTitle}}</view>
        <view class="sheet-hint">{{marketScaleHint}}</view>
      </view>
      <view class="scale-cards">
        <view
          class="scale-card {{marketScaleHighlight === 'small' ? 'on' : ''}}"
          hover-class="tap-hover"
          hover-stay-time="80"
          data-choice="small"
          bindtap="onMarketScalePick"
        >
          <view class="scale-card-main">
            <view class="scale-card-title">小菜场</view>
            <view class="scale-card-desc">小门面、路边摊位</view>
          </view>
          <image
            class="scale-card-icon scale-card-icon--small"
            src="/assets/images/icons/market-scale-small.png"
            mode="heightFix"
            aria-hidden="true"
          />
        </view>
        <view
          class="scale-card {{marketScaleHighlight === 'medium' ? 'on' : ''}}"
          hover-class="tap-hover"
          hover-stay-time="80"
          data-choice="medium"
          bindtap="onMarketScalePick"
        >
          <view class="scale-card-main">
            <view class="scale-card-title">中菜场</view>
            <view class="scale-card-desc">普通超市、连着几个门面</view>
          </view>
          <image
            class="scale-card-icon scale-card-icon--medium"
            src="/assets/images/icons/market-scale-medium.png"
            mode="heightFix"
            aria-hidden="true"
          />
        </view>
        <view
          class="scale-card {{marketScaleHighlight === 'large' ? 'on' : ''}}"
          hover-class="tap-hover"
          hover-stay-time="80"
          data-choice="large"
          bindtap="onMarketScalePick"
        >
          <view class="scale-card-main">
            <view class="scale-card-title">大菜场</view>
            <view class="scale-card-desc">集贸市场、大超市、很多摊位</view>
          </view>
          <image
            class="scale-card-icon scale-card-icon--large"
            src="/assets/images/icons/market-scale-large.png"
            mode="heightFix"
            aria-hidden="true"
          />
        </view>
      </view>
      <view class="scale-actions">
        <button
          size="mini"
          class="btn-outline"
          disabled="{{busy}}"
          bindtap="onMarketScaleSkip"
        >跳 过</button>
        <button
          size="mini"
          type="{{marketScaleHighlight ? 'primary' : 'default'}}"
          class="{{marketScaleHighlight ? '' : 'btn-outline btn-confirm-disabled'}}"
          disabled="{{busy || !marketScaleHighlight}}"
          bindtap="onMarketScaleConfirm"
        >确 认</button>
      </view>
    </view>
  </view>

  <!-- 首启①→②：同一蒙层；点遮罩不关；优先于进场确认/规模 -->
  <view
    class="mask user-no-ceremony"
    wx:if="{{showUserNoCeremony}}"
    catchtouchmove="true"
    catchtap="noop"
  >
    <view class="ceremony-stage ceremony-phase-{{ceremonyPhase}}">
      <view class="ceremony-card {{showCeremonyConfetti ? 'is-confetti' : ''}}">
        <view class="ceremony-welcome">
          <view class="ceremony-line">
            <view class="ceremony-line-text">欢迎！第</view>
            <view class="ceremony-roll-anchor">
              <view class="ceremony-roll">{{revealDisplay}}</view>
              <view
                class="ceremony-confetti"
                wx:if="{{showCeremonyConfetti}}"
                aria-hidden="true"
              >
                <view
                  wx:for="{{ceremonyConfetti}}"
                  wx:key="id"
                  class="ceremony-confetti-piece ceremony-burst-{{item.burst}} {{item.round ? 'is-round' : ''}}"
                  style="width: {{item.w}}rpx; height: {{item.h}}rpx; background: {{item.color}}; animation-delay: {{item.delay}}ms;"
                />
              </view>
            </view>
            <view class="ceremony-line-text">位大厨！</view>
          </view>
        </view>
        <!-- 抽屉：序号不关，整卡上移后从序号下方向下展开 -->
        <view class="ceremony-drawer">
          <view class="ceremony-steps">
            <view class="ceremony-steps-title">
              <view class="ceremony-steps-mark" aria-hidden="true"></view>
              <text>使用说明</text>
            </view>
            <view class="ceremony-step-list">
              <view class="ceremony-step">
                <view class="ceremony-step-rail">
                  <view class="ceremony-step-index">01</view>
                  <view class="ceremony-step-line" aria-hidden="true"></view>
                </view>
                <view class="ceremony-step-body">
                  <view class="ceremony-step-name">确认今日可选食材</view>
                  <view class="ceremony-step-desc">看看菜场时令与常见菜，可补充</view>
                </view>
              </view>
              <view class="ceremony-step">
                <view class="ceremony-step-rail">
                  <view class="ceremony-step-index">02</view>
                  <view class="ceremony-step-line" aria-hidden="true"></view>
                </view>
                <view class="ceremony-step-body">
                  <view class="ceremony-step-name">生成完整菜品搭配</view>
                  <view class="ceremony-step-desc">结合口味和近期食用，不喜可换</view>
                </view>
              </view>
              <view class="ceremony-step ceremony-step--last">
                <view class="ceremony-step-rail">
                  <view class="ceremony-step-index">03</view>
                </view>
                <view class="ceremony-step-body">
                  <view class="ceremony-step-name">按清单采购回家做</view>
                  <view class="ceremony-step-desc">明确食材不费脑，轻松购买</view>
                </view>
              </view>
            </view>
          </view>
          <view class="ceremony-actions">
            <button class="btn-outline ceremony-btn-secondary" bindtap="onCeremonyBrowseFirst"
              >先逛逛</button>
            <button
              class="btn-main ceremony-btn-primary"
              type="primary"
              bindtap="onCeremonyGoOnboarding"
            >完善偏好</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <busy-overlay show="{{busy}}" />
</view>
