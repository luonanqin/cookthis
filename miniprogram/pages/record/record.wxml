<view class="page {{typeScaleClass}}">
  <view class="label">吃过的菜（逗号或换行分隔）</view>
  <textarea
    class="input"
    value="{{input}}"
    placeholder="例如：红烧茄子，紫菜蛋花汤"
    maxlength="200"
    bindinput="onInput"
  />
  <button type="primary" disabled="{{busy}}" bindtap="onSubmit">记下</button>

  <view class="section-title">近期记录</view>
  <view wx:if="{{loading && empty}}" class="empty">加载中…</view>
  <view wx:elif="{{empty}}" class="empty">暂无记录</view>
  <block wx:else>
    <view class="item" wx:for="{{items}}" wx:key="logId">
      <view class="item-main">
        <view class="meta">{{item.date}} · {{item.source}}</view>
        <view class="dishes">{{item.dishesText}}</view>
      </view>
      <view
        class="item-del"
        data-log-id="{{item.logId}}"
        data-source="{{item.source}}"
        hover-class="tap-hover"
        hover-stay-time="80"
        bindtap="onDelete"
      >删除</view>
    </view>
    <view wx:if="{{loadingMore}}" class="empty">加载更多…</view>
    <view wx:elif="{{!nextCursor && items.length}}" class="empty">没有更多了</view>
  </block>

  <view class="footer">
    <button class="btn-outline" hover-class="button-hover" bindtap="onBack">返回</button>
  </view>
</view>
