.page {
  padding: 24rpx 24rpx 200rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: #f7f7f7;
}
.label {
  font-size: var(--fs-md);
  color: #666;
  margin-bottom: 12rpx;
}
.input {
  width: 100%;
  min-height: 160rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  font-size: var(--fs-body);
}
.section-title {
  margin: 40rpx 0 16rpx;
  font-weight: 600;
}
.empty {
  color: #999;
  font-size: var(--fs-md);
}
.item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}
.item-main {
  flex: 1;
  min-width: 0;
}
.meta {
  font-size: var(--fs-xs);
  color: #888;
  margin-bottom: 8rpx;
}
.dishes {
  font-size: var(--fs-body);
}
.item-del {
  flex-shrink: 0;
  font-size: var(--fs-md);
  color: #b35c2e;
  padding: 8rpx 4rpx;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
}
