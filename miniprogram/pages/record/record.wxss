.page {
  padding: 24rpx 24rpx 200rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: #f7f7f7;
}
.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.input {
  width: 100%;
  min-height: 160rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}
.btn-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.btn-row button {
  flex: 1;
}
.hint {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 24rpx;
}
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 70vh;
  overflow-y: auto;
}
.sheet-title {
  font-weight: 600;
  font-size: 32rpx;
}
.transcript {
  color: #888;
  font-size: 24rpx;
  margin: 12rpx 0 16rpx;
}
.row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 28rpx;
}
.row.on {
  color: #2e7d32;
}
.check {
  width: 40rpx;
  margin-right: 12rpx;
}
.sheet-actions {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
  margin-top: 24rpx;
}
.section-title {
  margin: 40rpx 0 16rpx;
  font-weight: 600;
}
.empty {
  color: #999;
  font-size: 26rpx;
}
.item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}
.meta {
  font-size: 22rpx;
  color: #888;
  margin-bottom: 8rpx;
}
.dishes {
  font-size: 28rpx;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
}
