.page {
  padding: 0;
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--color-bg);
}

.page-body {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.label {
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  min-height: 160rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  font-size: var(--fs-body);
  color: var(--color-text);
}

.section-title {
  margin: 40rpx 0 16rpx;
  font-weight: 600;
  color: var(--color-forest);
  font-size: var(--fs-lead);
}

.empty {
  color: var(--color-text-muted);
  font-size: var(--fs-md);
}

.item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.meta {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  margin-bottom: 6rpx;
}

.dishes {
  font-size: var(--fs-body);
  color: var(--color-text);
  line-height: 1.45;
}

.item-del {
  flex-shrink: 0;
  color: var(--color-coral);
  font-size: var(--fs-sm);
  padding: 16rpx 8rpx;
}

.footer {
  z-index: 12;
}
