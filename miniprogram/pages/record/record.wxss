.page {
  padding: 24rpx 24rpx 200rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: #f7f7f7;
}
.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.input {
  width: 100%;
  min-height: 160rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}
.section-title {
  margin: 40rpx 0 16rpx;
  font-weight: 600;
}
.empty {
  color: #999;
  font-size: 26rpx;
}
.item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}
.meta {
  font-size: 22rpx;
  color: #888;
  margin-bottom: 8rpx;
}
.dishes {
  font-size: 28rpx;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
}
