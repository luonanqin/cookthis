.page {
  padding: 0 28rpx 80rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--color-bg);
}

/* 顶栏小字长期吸顶；定高，供 meta 精确贴齐，避免缝里露下层 */
.hint-bar {
  position: sticky;
  top: 0;
  z-index: 12;
  margin: 0 -28rpx;
  height: 64rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: var(--color-bg);
}

.hint {
  color: var(--color-text-secondary);
  font-size: var(--fs-sm);
  line-height: 1.3;
}

.empty,
.more {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--fs-body);
}

.more {
  padding: 24rpx;
  font-size: var(--fs-sm);
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 0 24rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-border);
  overflow: visible;
}

/* 方案描述：未滚完本卡菜品时吸顶（贴齐 hint-bar 底边） */
.meta {
  position: sticky;
  top: 64rpx;
  z-index: 8;
  margin: 0 -24rpx 0;
  padding: 16rpx 24rpx 12rpx;
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  line-height: 1.4;
  background: var(--color-surface);
  border-radius: 0;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  position: relative;
  z-index: 1;
  /* 与吸顶 meta 留缝，避免盖住第一行菜边框 */
  padding-top: 8rpx;
}

/* Copied from index sheet-chip (entry confirm), scoped to this page */
.sheet-chip {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 16rpx 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: var(--fs-md);
  color: var(--color-text);
  background: var(--color-bg);
  position: relative;
}

.sheet-chip.on {
  color: var(--color-primary);
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.sheet-chip .check {
  width: 28rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
  color: var(--color-primary);
  font-size: var(--fs-sm);
}

.sheet-chip-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* tips 蒙层：不可点关；仅首菜热区可点 */
.tip-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(26, 26, 26, 0.45);
}

/* 小气泡：首菜右上角，像 tip 不像按钮 */
.tip-bubble {
  position: fixed;
  z-index: 26;
  max-width: 220rpx;
  padding: 6rpx 10rpx;
  background: rgba(26, 26, 26, 0.9);
  border-radius: 6rpx;
  pointer-events: none;
}

.tip-bubble-text {
  color: #fff;
  font-size: var(--fs-xxs);
  line-height: 1.3;
  font-weight: 400;
  white-space: nowrap;
}

.tip-arrow {
  position: absolute;
  left: 18rpx;
  bottom: -6rpx;
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 6rpx solid rgba(26, 26, 26, 0.9);
}

.tip-spot-hit {
  position: fixed !important;
  z-index: 25;
  margin: 0;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.95), 0 8rpx 24rpx rgba(26, 26, 26, 0.2);
}
