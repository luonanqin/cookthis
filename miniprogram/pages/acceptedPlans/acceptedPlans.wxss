.page {
  padding: 0;
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--color-bg);
}

/* 提示条改为 fixed 后，去掉顶 padding，避免与占位叠出空隙 */
.page-body {
  padding-top: 0;
}

/* 提示条固定在页眉下方，避免 sticky 上滑窜位 */
.hint-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 99;
  height: 64rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: var(--color-bg);
}

.hint-bar-spacer {
  height: 64rpx;
}

.hint {
  color: var(--color-text-secondary);
  font-size: var(--fs-sm);
  line-height: 1.3;
}

.empty,
.more {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--fs-body);
}

.more {
  padding: 24rpx;
  font-size: var(--fs-sm);
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 0 24rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-border);
  /* sticky meta 需要 visible；圆角由 meta 顶部自行承接 */
  overflow: visible;
}

.card-shared {
  padding-bottom: 20rpx;
}

/* 方案描述：未滚完本卡菜品时吸顶（贴齐 hint-bar 底边；top 由内联写入） */
.meta {
  position: sticky;
  z-index: 8;
  margin: 0 -24rpx 0;
  padding: 16rpx 24rpx 12rpx;
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  line-height: 1.4;
  background: var(--color-surface);
  /* 盖住卡片顶边时仍保持圆角，避免外框变直角 */
  border-radius: var(--radius-card) var(--radius-card) 0 0;
}

.meta-own,
.meta-shared {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.meta-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meta-time,
.meta-scene {
  display: block;
  line-height: 1.4;
}

.badge {
  flex-shrink: 0;
  align-self: center;
  padding: 2rpx 12rpx;
  font-size: var(--fs-xs);
  line-height: 1.4;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: 8rpx;
}

.card-share {
  flex-shrink: 0;
  align-self: center;
  margin: 0 !important;
  padding: 0 !important;
  width: 64rpx !important;
  height: 64rpx !important;
  min-width: 64rpx !important;
  min-height: 64rpx !important;
  font-weight: 400 !important;
  background: transparent !important;
  border: none !important;
}

.card-share::after {
  border: none !important;
}

.dish-names {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  padding-top: 8rpx;
}

.dish-name-plain {
  font-size: var(--fs-md);
  color: var(--color-text);
  line-height: 1.5;
}

.dish-sep {
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  position: relative;
  z-index: 1;
  /* 与吸顶 meta 留缝，避免盖住第一行菜边框 */
  padding-top: 8rpx;
}

/* Copied from index sheet-chip (entry confirm), scoped to this page */
.sheet-chip {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 16rpx 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: var(--fs-md);
  color: var(--color-text);
  background: var(--color-bg);
  position: relative;
}

.sheet-chip.on {
  color: var(--color-primary);
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.sheet-chip .check {
  width: 28rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
  color: var(--color-primary);
  font-size: var(--fs-sm);
}

.sheet-chip-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ate-tag {
  flex-shrink: 0;
  margin-left: 6rpx;
  font-size: var(--fs-xxs, 20rpx);
  color: var(--color-text-secondary);
  line-height: 1.2;
  font-weight: 400;
}

/* tips 蒙层：不可点关；仅首菜热区可点 */
.tip-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(26, 26, 26, 0.45);
}

/* 小气泡：首菜右上角，像 tip 不像按钮 */
.tip-bubble {
  position: fixed;
  z-index: 26;
  max-width: 220rpx;
  padding: 6rpx 10rpx;
  background: rgba(26, 26, 26, 0.9);
  border-radius: 6rpx;
  pointer-events: none;
}

.tip-bubble-text {
  color: #fff;
  font-size: var(--fs-xxs);
  line-height: 1.3;
  font-weight: 400;
  white-space: nowrap;
}

.tip-arrow {
  position: absolute;
  left: 18rpx;
  bottom: -6rpx;
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 6rpx solid rgba(26, 26, 26, 0.9);
}

.tip-spot-hit {
  position: fixed !important;
  z-index: 25;
  margin: 0;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.95), 0 8rpx 24rpx rgba(26, 26, 26, 0.2);
}

/* Icon assets */
.card-share {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1 !important;
}
