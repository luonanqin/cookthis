.page {
  padding: 0;
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--color-bg);
}

/* 覆盖全局 page-body 顶 padding，避免与 fixed 提示条叠出空隙 */
.page-body {
  padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* 提示条固定在页眉下方；高度随文案，底边由 JS 实测喂给 meta sticky */
.hint-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 99;
  padding: 8rpx 32rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-end;
  background: var(--color-bg);
}

.hint-bar-spacer {
  width: 100%;
  box-sizing: border-box;
  pointer-events: none;
}

.hint {
  color: var(--color-text-secondary);
  font-size: var(--fs-sm);
  line-height: 1.3;
}

.empty,
.more {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--fs-body);
}

.more {
  padding: 24rpx;
  font-size: var(--fs-sm);
}

.card {
  /* 外框拆到 meta / 内容区：吸顶时顶角圆角随 meta，不再被卡片边框裁成直角 */
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  margin-bottom: 20rpx;
  overflow: visible;
}

.card-shared {
  padding-bottom: 0;
}

/* 吸顶壳：未吸顶顶圆角；吸顶后改直角贴 hint，彻底消灭月牙漏字 */
.meta-sticky {
  position: sticky;
  z-index: 8;
  margin: 0;
}

.meta-sticky-shield {
  position: absolute;
  left: 0;
  right: 0;
  top: -12px;
  height: 12px;
  background: var(--color-bg);
  pointer-events: none;
  z-index: 0;
  opacity: 0;
}

.meta-sticky.is-stuck .meta-sticky-shield {
  opacity: 1;
}

.meta {
  position: relative;
  z-index: 1;
  margin: 0;
  padding: 16rpx 24rpx 12rpx;
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  line-height: 1.4;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-bottom: none;
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  box-sizing: border-box;
}

.meta-sticky.is-stuck .meta {
  border-radius: 0;
}

.meta-own,
.meta-shared {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.meta-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meta-time {
  display: block;
  font-size: var(--fs-title);
  font-weight: var(--fw-semibold);
  line-height: 1.35;
  color: var(--color-primary);
}

.meta-scene {
  display: block;
  margin-top: 2rpx;
  line-height: 1.4;
  color: var(--color-text-secondary);
  font-size: var(--fs-sm);
}

.badge {
  flex-shrink: 0;
  align-self: center;
  padding: 2rpx 12rpx;
  font-size: var(--fs-xs);
  line-height: 1.4;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: 8rpx;
}

.card-share {
  flex-shrink: 0;
  align-self: center;
  margin: 0 !important;
  padding: 0 !important;
  width: 64rpx !important;
  height: 64rpx !important;
  min-width: 64rpx !important;
  min-height: 64rpx !important;
  font-weight: var(--fw-regular) !important;
  background: transparent !important;
  border: none !important;
}

.card-share::after {
  border: none !important;
}

.dish-names {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  padding: 8rpx 24rpx 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-top: none;
  border-radius: 0 0 var(--radius-card) var(--radius-card);
  box-sizing: border-box;
}

.dish-name-plain {
  font-size: var(--fs-md);
  color: var(--color-text);
  line-height: 1.5;
}

.dish-sep {
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.chips {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  position: relative;
  z-index: 1;
  padding: 8rpx 24rpx 24rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-top: none;
  border-radius: 0 0 var(--radius-card) var(--radius-card);
  box-sizing: border-box;
}

/* 与首页进场确认同款两列自适应 */
.sheet-chip {
  width: auto;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 16rpx 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: var(--fs-md);
  color: var(--color-text);
  background: var(--color-bg);
  position: relative;
}

.sheet-chip.on {
  color: var(--color-primary);
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.sheet-chip .check {
  width: 28rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
  color: var(--color-primary);
  font-size: var(--fs-sm);
}

.sheet-chip-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ate-tag {
  flex-shrink: 0;
  margin-left: 6rpx;
  font-size: var(--fs-xxs, 20rpx);
  color: var(--color-text-secondary);
  line-height: 1.2;
  font-weight: var(--fw-regular);
}

/* tips 蒙层：不可点关；仅首菜热区可点 */
.tip-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(26, 26, 26, 0.45);
}

/* 小气泡：首菜右上角，像 tip 不像按钮 */
.tip-bubble {
  position: fixed;
  z-index: 26;
  max-width: 220rpx;
  padding: 6rpx 10rpx;
  background: rgba(26, 26, 26, 0.9);
  border-radius: 6rpx;
  pointer-events: none;
}

.tip-bubble-text {
  color: #fff;
  font-size: var(--fs-xxs);
  line-height: 1.3;
  font-weight: var(--fw-regular);
  white-space: nowrap;
}

.tip-arrow {
  position: absolute;
  left: 18rpx;
  bottom: -6rpx;
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 6rpx solid rgba(26, 26, 26, 0.9);
}

.tip-spot-hit {
  position: fixed !important;
  z-index: 25;
  margin: 0;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.95), 0 8rpx 24rpx rgba(26, 26, 26, 0.2);
}

/* Icon assets */
.card-share {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1 !important;
}
