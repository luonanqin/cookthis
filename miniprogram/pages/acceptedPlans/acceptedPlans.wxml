<view class="page {{typeScaleClass}}">
  <view class="hint-bar">
    <view class="hint">{{hint}}</view>
  </view>

  <view wx:if="{{loading && !items.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!items.length}}" class="empty">还没有采纳过方案</view>

  <block wx:for="{{items}}" wx:key="requestId">
    <view class="card">
      <view class="meta">{{item.timeText}} · {{item.sceneSummary}}</view>
      <view class="chips">
        <view
          id="{{index === 0 && dishIndex === 0 ? 'tipSpotChip' : ''}}"
          class="sheet-chip {{d.ate ? 'on' : ''}}"
          wx:for="{{item.dishes}}"
          wx:for-item="d"
          wx:for-index="dishIndex"
          wx:key="name"
          data-request-id="{{item.requestId}}"
          data-recommendation-id="{{item.recommendationId}}"
          data-name="{{d.name}}"
          data-ate="{{d.ate}}"
          bindtap="onToggleDish"
        >
          <text class="check">{{d.ate ? '✓' : ''}}</text>
          <text class="sheet-chip-text">{{d.name}}</text>
        </view>
      </view>
    </view>
  </block>
  <view wx:if="{{loadingMore}}" class="more">加载中…</view>

  <!-- 强制点选首菜：蒙层不可点关，仅热区可点 -->
  <view wx:if="{{showTip && items.length}}" class="tip-mask" catchtouchmove="true" catchtap="noop">
    <view
      wx:if="{{tipSpot}}"
      class="tip-bubble"
      style="top: {{tipBubbleTop}}px; left: {{tipBubbleLeft}}px;"
      catchtap="noop"
    >
      <text class="tip-bubble-text">{{tipText}}</text>
      <view class="tip-arrow"></view>
    </view>
    <view
      wx:if="{{tipSpot}}"
      class="tip-spot-hit sheet-chip {{tipSpot.ate ? 'on' : ''}}"
      style="top: {{tipSpot.top}}px; left: {{tipSpot.left}}px; width: {{tipSpot.width}}px; height: {{tipSpot.height}}px;"
      data-request-id="{{tipSpot.requestId}}"
      data-recommendation-id="{{tipSpot.recommendationId}}"
      data-name="{{tipSpot.name}}"
      data-ate="{{tipSpot.ate}}"
      catchtap="onToggleDish"
    >
      <text class="check">{{tipSpot.ate ? '✓' : ''}}</text>
      <text class="sheet-chip-text">{{tipSpot.name}}</text>
    </view>
  </view>
</view>
