<view class="page {{typeScaleClass}}">
  <view class="hint-bar">
    <view class="hint">{{hint}}</view>
  </view>

  <view wx:if="{{loading && !items.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!items.length}}" class="empty">还没有采纳过方案</view>

  <block wx:for="{{items}}" wx:key="listKey">
    <!-- 收到的：整卡进只读页；无已吃 chip、无分享 -->
    <view
      wx:if="{{item.source === 'shared'}}"
      class="card card-shared"
      hover-class="tap-hover"
      hover-stay-time="80"
      data-share-id="{{item.shareId}}"
      bindtap="onOpenShared"
    >
      <view class="meta meta-shared">
        <text class="meta-text">{{item.timeText}} · {{item.sceneSummary}}</text>
        <text class="badge">{{item.badge || '分享'}}</text>
      </view>
      <view class="dish-names">
        <block wx:for="{{item.dishes}}" wx:for-item="d" wx:for-index="dishIdx" wx:key="name">
          <text wx:if="{{dishIdx > 0}}" class="dish-sep"> · </text>
          <text class="dish-name-plain">{{d.name}}</text>
        </block>
      </view>
    </view>

    <!-- 自产：已吃 chip + 分享 -->
    <view wx:else class="card">
      <view class="meta meta-own">
        <text class="meta-text">{{item.timeText}} · {{item.sceneSummary}}</text>
        <button
          class="card-share btn-outline"
          size="mini"
          open-type="share"
          data-recommendation-id="{{item.recommendationId}}"
          data-entry="accepted"
          hover-class="tap-hover"
        >分享</button>
      </view>
      <view class="chips">
        <view
          id="{{item.listKey === tipOwnListKey && dishIndex === 0 ? 'tipSpotChip' : ''}}"
          class="sheet-chip {{d.ate ? 'on' : ''}}"
          wx:for="{{item.dishes}}"
          wx:for-item="d"
          wx:for-index="dishIndex"
          wx:key="name"
          data-request-id="{{item.requestId}}"
          data-recommendation-id="{{item.recommendationId}}"
          data-name="{{d.name}}"
          data-ate="{{d.ate}}"
          bindtap="onToggleDish"
        >
          <text class="check">{{d.ate ? '✓' : ''}}</text>
          <text class="sheet-chip-text">{{d.name}}</text>
        </view>
      </view>
    </view>
  </block>
  <view wx:if="{{loadingMore}}" class="more">加载中…</view>

  <!-- 强制点选首菜：蒙层不可点关，仅热区可点 -->
  <view wx:if="{{showTip && tipSpot}}" class="tip-mask" catchtouchmove="true" catchtap="noop">
    <view
      class="tip-bubble"
      style="top: {{tipBubbleTop}}px; left: {{tipBubbleLeft}}px;"
      catchtap="noop"
    >
      <text class="tip-bubble-text">{{tipText}}</text>
      <view class="tip-arrow"></view>
    </view>
    <view
      class="tip-spot-hit sheet-chip {{tipSpot.ate ? 'on' : ''}}"
      style="top: {{tipSpot.top}}px; left: {{tipSpot.left}}px; width: {{tipSpot.width}}px; height: {{tipSpot.height}}px;"
      data-request-id="{{tipSpot.requestId}}"
      data-recommendation-id="{{tipSpot.recommendationId}}"
      data-name="{{tipSpot.name}}"
      data-ate="{{tipSpot.ate}}"
      catchtap="onToggleDish"
    >
      <text class="check">{{tipSpot.ate ? '✓' : ''}}</text>
      <text class="sheet-chip-text">{{tipSpot.name}}</text>
    </view>
  </view>
</view>
