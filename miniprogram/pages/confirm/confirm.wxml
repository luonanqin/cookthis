<page-meta page-style="{{showCustomSlots ? 'overflow: hidden;' : ''}}" />
<view class="page {{typeScaleClass}}">
  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{error}}" class="state">{{error}}</view>

  <block wx:else>
    <view class="toolbar">
      <text class="section-title">时令</text>
      <view class="toolbar-actions">
        <text class="link" bindtap="selectAllSeasonal">{{seasonalSelectAllLabel}}</text>
        <text class="link" bindtap="clearSeasonal">清空</text>
      </view>
    </view>

    <view wx:if="{{listEmpty}}" class="empty-tip">暂无食材。请在云开发控制台确认已导入 ingredients，并部署云函数 ingredients。</view>

    <view class="groups">
      <view wx:for="{{seasonalGroups}}" wx:key="category" class="group">
        <view class="group-label">{{item.label}}</view>
        <view class="chip-row">
          <view
            wx:for="{{item.list}}"
            wx:for-item="ing"
            wx:key="id"
            class="chip {{seasonalChecked[ing.id] ? 'chip-on' : ''}}"
            data-id="{{ing.id}}"
            catchtap="toggleSeasonal"
          >{{ing.name}}</view>
        </view>
      </view>
    </view>

    <view class="year-round">
      <view class="fold-bar" bindtap="toggleYearRoundSection">
        <text>四季常见 · 已计入 {{yearRoundCount}} 样</text>
        <text class="fold-icon">{{yearRoundExpanded ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{yearRoundExpanded}}" class="fold-body">
        <view wx:for="{{yearRoundGroups}}" wx:key="category" class="group">
          <view class="group-label">{{item.label}}</view>
          <view class="chip-row">
            <view
              wx:for="{{item.list}}"
              wx:for-item="ing"
              wx:key="id"
              class="chip {{yearRoundChecked[ing.id] ? 'chip-on' : ''}}"
              data-id="{{ing.id}}"
              catchtap="toggleYearRound"
            >{{ing.name}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="manual">
      <view class="section-title">补菜</view>
      <view class="manual-row">
        <input
          class="manual-input"
          placeholder="输入菜名"
          value="{{manualInput}}"
          bindinput="onManualInput"
          confirm-type="done"
          bindconfirm="addManual"
        />
        <button size="mini" type="primary" bindtap="addManual">添加</button>
      </view>
      <view
        wx:for="{{manuals}}"
        wx:key="id"
        class="row manual-item"
      >
        <text class="name">{{item.name}}</text>
        <text class="link" data-id="{{item.id}}" bindtap="removeManual">移除</text>
      </view>
    </view>

    <view class="scene">
      <view class="section-title">场景</view>

      <view class="chip-row">
        <view
          wx:for="{{mealTypeOptions}}"
          wx:key="id"
          class="chip {{mealType === item.id ? 'chip-on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onMealTypeTap"
        >{{item.label}}</view>
      </view>

      <view class="field">
        <view class="field-label-row">
          <text class="field-label">人数</text>
          <text class="field-label-meta">{{householdLabel}}</text>
        </view>
        <view class="combo-row">
          <picker mode="selector" range="{{tierRange}}" value="{{adultIndex}}" data-tier="adult" bindchange="onTierPick">
            <view class="picker-cell">大 {{tierDisplay.adult}}</view>
          </picker>
          <picker mode="selector" range="{{tierRange}}" value="{{childIndex}}" data-tier="child" bindchange="onTierPick">
            <view class="picker-cell">小 {{tierDisplay.child}}</view>
          </picker>
          <picker mode="selector" range="{{tierRange}}" value="{{elderIndex}}" data-tier="elder" bindchange="onTierPick">
            <view class="picker-cell">老 {{tierDisplay.elder}}</view>
          </picker>
        </view>
      </view>

      <view class="field" wx:if="{{isDaily}}">
        <text class="field-label">搭配</text>
        <view class="combo-row">
          <picker mode="selector" range="{{comboRange}}" value="{{meatIndex}}" data-field="meat" bindchange="onComboPick">
            <view class="picker-cell">荤 {{combo.meat}}</view>
          </picker>
          <picker mode="selector" range="{{comboRange}}" value="{{vegIndex}}" data-field="veg" bindchange="onComboPick">
            <view class="picker-cell">素 {{combo.veg}}</view>
          </picker>
          <picker mode="selector" range="{{comboRange}}" value="{{soupIndex}}" data-field="soup" bindchange="onComboPick">
            <view class="picker-cell">汤 {{combo.soup}}</view>
          </picker>
        </view>
      </view>

      <view class="field" wx:if="{{isDaily}}">
        <text class="field-label">几顿</text>
        <view class="chip-row">
          <view
            wx:for="{{dailySlotPresets}}"
            wx:key="id"
            class="chip {{dailySlotMode === 'preset' && dailySlotPresetId === item.id ? 'chip-on' : ''}}"
            data-id="{{item.id}}"
            bindtap="onDailySlotPreset"
          >{{item.label}}</view>
          <view
            class="chip {{dailySlotMode === 'custom' ? 'chip-on' : ''}}"
            bindtap="onOpenCustomSlots"
          >{{customChipLabel}}</view>
        </view>
      </view>

      <view class="field" wx:else>
        <text class="field-label">几顿</text>
        <view class="slot-stepper">
          <text class="step-btn" data-delta="-1" bindtap="bumpPartySlots">−</text>
          <text class="slot-count">{{partySlotCount}}</text>
          <text class="step-btn" data-delta="1" bindtap="bumpPartySlots">+</text>
        </view>
      </view>

      <view class="field" wx:if="{{!isDaily}}">
        <text class="field-label">本场忌口</text>
        <view class="chip-row">
          <view
            wx:for="{{partyAvoidOptions}}"
            wx:key="id"
            class="chip {{partyAvoidChecked[item.id] ? 'chip-on' : ''}}"
            data-id="{{item.id}}"
            bindtap="togglePartyAvoid"
          >{{item.label}}</view>
        </view>
      </view>

      <!-- 节日选择暂时隐藏，后续有需要再做 -->
    </view>

    <view class="footer-spacer"></view>
  </block>

  <view class="footer" wx:if="{{!loading && !error}}">
    <button type="primary" disabled="{{submitting || liteBusy}}" bindtap="onConfirm">
      <block wx:if="{{submitting}}">脑壳飞速运转中</block>
      <block wx:else>确认（已选 {{count}}）</block>
    </button>
  </view>

  <view class="mask" wx:if="{{showProfileLite}}" catchtouchmove="true">
    <view class="sheet">
      <profile-lite-form
        show-none-avoids="{{false}}"
        primary-text="保存并出方案"
        secondary-text="暂时跳过"
        bind:save="onProfileLiteSave"
        bind:skip="onProfileLiteSkip"
      />
    </view>
  </view>

  <view
    class="mask mask-custom-slots"
    wx:if="{{showCustomSlots}}"
    catchtouchmove="true"
    bindtap="onCloseCustomSlots"
  >
    <view class="custom-slots-panel" catchtap="noop" catchtouchmove="true">
      <view class="custom-slots-title">自定义几顿</view>
      <view class="custom-slot-row">
        <text class="custom-slot-name">午饭</text>
        <text class="step-btn" data-which="lunch" data-delta="-1" bindtap="bumpCustomDraft">−</text>
        <text class="slot-count">{{draftLunchCount}}</text>
        <text class="step-btn" data-which="lunch" data-delta="1" bindtap="bumpCustomDraft">+</text>
      </view>
      <view class="custom-slot-row">
        <text class="custom-slot-name">晚饭</text>
        <text class="step-btn" data-which="dinner" data-delta="-1" bindtap="bumpCustomDraft">−</text>
        <text class="slot-count">{{draftDinnerCount}}</text>
        <text class="step-btn" data-which="dinner" data-delta="1" bindtap="bumpCustomDraft">+</text>
      </view>
      <view class="custom-slots-actions">
        <button size="mini" class="btn-outline custom-slots-btn" bindtap="onCloseCustomSlots">取 消</button>
        <button size="mini" type="primary" class="custom-slots-btn" bindtap="onConfirmCustomSlots">确 认</button>
      </view>
    </view>
  </view>

  <view class="mask mask-center" wx:if="{{showEmptyDialog}}" catchtouchmove="true">
    <view class="dialog">
      <view class="dialog-title">食材不够出菜了</view>
      <view class="dialog-actions">
        <button class="dialog-btn" hover-class="button-hover" bindtap="onEmptyDialogOk">好吧</button>
      </view>
    </view>
  </view>
</view>
