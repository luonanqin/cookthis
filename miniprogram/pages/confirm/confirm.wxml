<view class="page">
  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{error}}" class="state">{{error}}</view>

  <block wx:else>
    <view class="toolbar">
      <text class="section-title">时令</text>
      <view class="toolbar-actions">
        <text class="link" bindtap="selectAllSeasonal">全选</text>
        <text class="link" bindtap="clearSeasonal">清空</text>
      </view>
    </view>

    <view class="groups">
      <view wx:for="{{seasonalGroups}}" wx:key="category" class="group">
        <view class="group-label">{{item.label}}</view>
        <view
          wx:for="{{item.list}}"
          wx:for-item="ing"
          wx:key="id"
          class="row"
          data-id="{{ing.id}}"
          catchtap="toggleSeasonal"
        >
          <checkbox checked="{{seasonalChecked[ing.id]}}" color="#07c160" disabled />
          <text class="name">{{ing.name}}</text>
        </view>
      </view>
    </view>

    <view class="year-round">
      <view class="fold-bar" bindtap="toggleYearRoundSection">
        <text>四季常见 · 已计入 {{yearRoundCount}} 样</text>
        <text class="fold-icon">{{yearRoundExpanded ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{yearRoundExpanded}}" class="fold-body">
        <view
          wx:for="{{yearRound}}"
          wx:key="id"
          class="row"
          data-id="{{item.id}}"
          catchtap="toggleYearRound"
        >
          <checkbox checked="{{yearRoundChecked[item.id]}}" color="#07c160" disabled />
          <text class="name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="manual">
      <view class="section-title">补菜</view>
      <view class="manual-row">
        <input
          class="manual-input"
          placeholder="输入菜名"
          value="{{manualInput}}"
          bindinput="onManualInput"
          confirm-type="done"
          bindconfirm="addManual"
        />
        <button size="mini" type="primary" bindtap="addManual">添加</button>
        <button size="mini" loading="{{voiceListening}}" disabled="{{voiceListening}}" bindtap="onVoiceAdd">语音</button>
      </view>
      <view
        wx:for="{{manuals}}"
        wx:key="id"
        class="row manual-item"
      >
        <text class="name">{{item.name}}</text>
        <text class="link" data-id="{{item.id}}" bindtap="removeManual">移除</text>
      </view>
    </view>

    <view class="scene">
      <view class="section-title">场景</view>

      <view class="chip-row">
        <view
          wx:for="{{mealTypeOptions}}"
          wx:key="id"
          class="chip {{mealType === item.id ? 'chip-on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onMealTypeTap"
        >{{item.label}}</view>
      </view>

      <view class="field">
        <text class="field-label">人数</text>
        <input
          class="field-input"
          type="number"
          placeholder="{{isDaily ? '人数' : '填写人数后自动推荐搭配'}}"
          value="{{peopleCountText}}"
          bindinput="onPeopleInput"
        />
      </view>

      <view class="field">
        <text class="field-label">搭配</text>
        <view class="combo-row" wx:if="{{combo}}">
          <view class="combo-item">
            <text>荤 {{combo.meat}}</text>
            <view class="stepper">
              <text class="step-btn" data-field="meat" data-delta="-1" bindtap="bumpCombo">−</text>
              <text class="step-btn" data-field="meat" data-delta="1" bindtap="bumpCombo">+</text>
            </view>
          </view>
          <view class="combo-item">
            <text>素 {{combo.veg}}</text>
            <view class="stepper">
              <text class="step-btn" data-field="veg" data-delta="-1" bindtap="bumpCombo">−</text>
              <text class="step-btn" data-field="veg" data-delta="1" bindtap="bumpCombo">+</text>
            </view>
          </view>
          <view class="combo-item">
            <text>汤 {{combo.soup}}</text>
            <view class="stepper">
              <text class="step-btn" data-field="soup" data-delta="-1" bindtap="bumpCombo">−</text>
              <text class="step-btn" data-field="soup" data-delta="1" bindtap="bumpCombo">+</text>
            </view>
          </view>
        </view>
        <text wx:else class="hint">填写人数后自动推荐</text>
      </view>

      <view class="field" wx:if="{{isDaily}}">
        <text class="field-label">几顿</text>
        <view class="chip-row">
          <view
            wx:for="{{dailySlotPresets}}"
            wx:key="id"
            class="chip {{dailySlotPresetId === item.id ? 'chip-on' : ''}}"
            data-id="{{item.id}}"
            bindtap="onDailySlotPreset"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="field" wx:else>
        <text class="field-label">几顿</text>
        <view class="slot-stepper">
          <text class="step-btn" data-delta="-1" bindtap="bumpPartySlots">−</text>
          <text class="slot-count">{{partySlotCount}}</text>
          <text class="step-btn" data-delta="1" bindtap="bumpPartySlots">+</text>
        </view>
      </view>

      <view class="field" wx:if="{{!isDaily}}">
        <text class="field-label">本场忌口</text>
        <view class="chip-row">
          <view
            wx:for="{{partyAvoidOptions}}"
            wx:key="id"
            class="chip {{partyAvoidChecked[item.id] ? 'chip-on' : ''}}"
            data-id="{{item.id}}"
            bindtap="togglePartyAvoid"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="field" wx:if="{{isHoliday}}">
        <text class="field-label">节日</text>
        <view wx:if="{{!upcomingHolidays.length}}" class="hint">近 30 天暂无节日</view>
        <view
          wx:for="{{upcomingHolidays}}"
          wx:key="id"
          class="holiday-row {{holidayId === item.id ? 'holiday-on' : ''}}"
          data-id="{{item.id}}"
          data-date="{{item.date}}"
          bindtap="onHolidayTap"
        >
          <text class="name">{{item.nameZh}}</text>
          <text class="holiday-date">{{item.date}}</text>
        </view>
      </view>
    </view>

    <view class="footer-spacer"></view>
  </block>

  <view class="footer" wx:if="{{!loading && !error}}">
    <button type="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onConfirm">确认（已选 {{count}}）</button>
  </view>

  <view class="mask" wx:if="{{showVoiceConfirm}}" catchtouchmove="true">
    <view class="sheet">
      <view class="sheet-title">确认补入的菜</view>
      <view class="transcript" wx:if="{{voiceTranscript}}">识别：{{voiceTranscript}}</view>
      <view
        class="voice-row {{voiceSelected[item] ? 'on' : ''}}"
        wx:for="{{voiceCandidates}}"
        wx:key="*this"
        data-name="{{item}}"
        bindtap="onToggleVoiceCandidate"
      >
        <text class="check">{{voiceSelected[item] ? '✓' : ''}}</text>
        <text>{{item}}</text>
      </view>
      <view class="sheet-actions">
        <button size="mini" bindtap="onVoiceSheetCancel">取消</button>
        <button size="mini" type="primary" bindtap="onVoiceSheetConfirm">加入</button>
      </view>
    </view>
  </view>
</view>
