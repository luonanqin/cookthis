<page-meta page-style="{{showMoreMeals || showMealGate || showProfileLite || showMarketScale || seasonalExpanded ? 'overflow: hidden;' : ''}}" />
<view class="page {{typeScaleClass}}">
  <page-header
    title="确认食材"
    subtitle="看看菜场有什么"
    bind:heightchange="onHeaderHeight"
  />

  <view wx:if="{{loading || holdBlank}}" class="state"></view>
  <view wx:elif="{{error}}" class="state">{{error}}</view>

  <block wx:else>
    <view class="page-body confirm-body">
    <view
      class="market-scale-entry"
      hover-class="tap-hover"
      hover-stay-time="80"
      bindtap="onOpenMarketScaleSheet"
    >
      <text class="link market-scale-entry-link">{{marketScaleEntryLabel}} · 切换</text>
    </view>

    <view class="surface-card season-card">
      <view class="toolbar">
        <view class="toolbar-left">
          <image class="ui-icon ui-icon--sm" src="/assets/images/icons/leafy-vegetables.png" mode="aspectFit" aria-hidden="true"/><text class="section-title {{warnSeason ? 'title-warn' : ''}} {{warnSeason && warnPulse ? 'title-pulse' : ''}}">时令菜</text>
          <text class="season-count">已选 {{seasonalCount}} / 共 {{seasonalTotal}}</text>
        </view>
        <text
          wx:if="{{!listEmpty}}"
          class="link season-expand-link"
          hover-class="tap-hover"
          hover-stay-time="80"
          bindtap="onOpenSeasonalDrawer"
        >展开</text>
      </view>
      <view wx:if="{{listEmpty}}" class="empty-tip">暂无食材。请在云开发控制台确认已导入 ingredients，并部署云函数 ingredients。</view>

      <view
        wx:if="{{!listEmpty && !seasonalExpanded}}"
        class="season-preview"
        hover-class="tap-hover"
        hover-stay-time="80"
        bindtap="onOpenSeasonalDrawer"
      >
        <view class="season-preview-row">
          <text
            wx:for="{{seasonalFlat}}"
            wx:key="id"
            class="season-preview-name"
          >{{item.displayName || item.name}}</text>
        </view>
        <view class="season-preview-fade" aria-hidden="true"></view>
      </view>

    </view>

    <view class="year-round">
      <view class="fold-bar" bindtap="toggleYearRoundSection">
        <view class="toolbar-left">
          <image class="ui-icon ui-icon--sm" src="/assets/images/icons/leafy-vegetables.png" mode="aspectFit" aria-hidden="true"/>
          <text class="section-title">常见菜</text>
          <text class="season-count">已选 {{yearRoundCount}} / 共 {{yearRoundTotal}}</text>
        </view>
        <text class="fold-icon">{{yearRoundExpanded ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{yearRoundExpanded}}" class="fold-body">
        <view wx:for="{{yearRoundGroups}}" wx:key="category" class="group">
          <view class="group-label">{{item.label}}</view>
          <view class="chip-row">
            <view
              wx:for="{{item.list}}"
              wx:for-item="ing"
              wx:key="id"
              class="chip {{yearRoundChecked[ing.id] ? 'chip-on' : ''}}"
              data-id="{{ing.id}}"
              catchtap="toggleYearRound"
            >{{ing.displayName || ing.name}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="manual surface-card">
      <view class="section-title confirm-title-row"><view class="plus-mark" aria-hidden="true"><text class="plus-mark-glyph">+</text></view><text>补菜</text></view>
      <view class="manual-row">
        <view class="manual-field">
          <input
            class="manual-input"
            placeholder="菜名或拼音"
            value="{{manualInput}}"
            bindinput="onManualInput"
            confirm-type="done"
            bindconfirm="addManual"
          />
          <view class="manual-suggest" wx:if="{{manualSuggestions.length}}">
            <view
              wx:for="{{manualSuggestions}}"
              wx:key="canonical"
              class="manual-suggest-item"
              hover-class="tap-hover"
              hover-stay-time="80"
              data-canonical="{{item.canonical}}"
              data-surface="{{item.surface}}"
              bindtap="onPickManualSuggest"
            >{{item.label}}</view>
          </view>
        </view>
        <button size="mini" type="primary" bindtap="addManual">添 加</button>
      </view>
      <view wx:if="{{manualDedupeHint}}" class="manual-suggest-empty">{{manualDedupeHint}}</view>
      <view wx:elif="{{manualSuggestEmpty}}" class="manual-suggest-empty">无匹配，可仍添加（可能无法出菜）</view>
      <view class="chip-row manual-chips" wx:if="{{manuals.length}}">
        <view
          wx:for="{{manuals}}"
          wx:key="id"
          class="manual-chip {{item.matched === false ? 'manual-chip--unmatched' : ''}}"
          hover-class="tap-hover"
          hover-stay-time="80"
          data-id="{{item.id}}"
          bindtap="removeManual"
        >
          <text class="manual-chip-text">{{item.displayName || item.name}}</text>
          <text wx:if="{{item.matched === false}}" class="manual-chip-hint">未匹配</text>
          <text class="manual-chip-x" aria-label="移除">×</text>
        </view>
      </view>
    </view>

    <view class="scene surface-card">
      <view class="section-title confirm-title-row"><image class="ui-icon ui-icon--sm" src="/assets/images/icons/utensils-green.png" mode="aspectFit" aria-hidden="true"/><text>场景</text></view>

      <view class="chip-row">
        <view
          wx:for="{{mealTypeOptions}}"
          wx:key="id"
          class="chip {{mealType === item.id ? 'chip-on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onMealTypeTap"
        >{{item.label}}</view>
      </view>

      <view class="field">
        <view class="field-label-row">
          <view class="field-label-with-icon"><image class="ui-icon ui-icon--xs" src="/assets/images/icons/group-people.png" mode="aspectFit" aria-hidden="true"/><text class="field-label {{warnPeople ? 'title-warn' : ''}} {{warnPeople && warnPulse ? 'title-pulse' : ''}}">人数</text></view>
          <text class="field-label-meta">{{householdLabel}}</text>
        </view>
        <view class="combo-row">
          <picker mode="selector" range="{{tierRange}}" value="{{adultIndex}}" data-tier="adult" bindchange="onTierPick">
            <view class="picker-cell">大 {{tierDisplay.adult}}</view>
          </picker>
          <picker mode="selector" range="{{tierRange}}" value="{{childIndex}}" data-tier="child" bindchange="onTierPick">
            <view class="picker-cell">小 {{tierDisplay.child}}</view>
          </picker>
          <picker mode="selector" range="{{tierRange}}" value="{{elderIndex}}" data-tier="elder" bindchange="onTierPick">
            <view class="picker-cell">老 {{tierDisplay.elder}}</view>
          </picker>
        </view>
      </view>

      <view class="field" wx:if="{{isDaily}}">
        <text class="field-label {{warnCombo ? 'title-warn' : ''}} {{warnCombo && warnPulse ? 'title-pulse' : ''}}">搭配</text>
        <view class="combo-row">
          <picker mode="selector" range="{{comboRange}}" value="{{meatIndex}}" data-field="meat" bindchange="onComboPick">
            <view class="picker-cell">荤 {{combo.meat}}</view>
          </picker>
          <picker mode="selector" range="{{comboRange}}" value="{{vegIndex}}" data-field="veg" bindchange="onComboPick">
            <view class="picker-cell">素 {{combo.veg}}</view>
          </picker>
          <picker mode="selector" range="{{comboRange}}" value="{{soupIndex}}" data-field="soup" bindchange="onComboPick">
            <view class="picker-cell">汤 {{combo.soup}}</view>
          </picker>
        </view>
      </view>

      <view class="field" wx:if="{{isDaily}}">
        <text class="field-label {{warnSlots ? 'title-warn' : ''}} {{warnSlots && warnPulse ? 'title-pulse' : ''}}">几餐</text>
        <view class="chip-row chip-row--meal-count">
          <view
            wx:for="{{dailyMealCountPresets}}"
            wx:key="id"
            class="chip chip--meal-count {{dailySlotMode === 'preset' && dailySlotPresetId === item.id ? 'chip-on' : ''}}"
            data-id="{{item.id}}"
            bindtap="onPickDailyMealCount"
          >{{item.label}}</view>
          <view
            id="moreMealChip"
            class="chip chip--meal-count {{dailySlotMode === 'custom' ? 'chip-on' : ''}} {{showMoreMeals ? 'chip--above-mask' : ''}}"
            bindtap="onOpenCustomMealCount"
          >{{showMoreMeals ? '餐数' : customChipLabel}}</view>
        </view>
      </view>

      <view class="field" wx:else>
        <text class="field-label {{warnSlots ? 'title-warn' : ''}} {{warnSlots && warnPulse ? 'title-pulse' : ''}}">几餐</text>
        <view class="chip-row">
          <view
            wx:for="{{partySlotOptions}}"
            wx:key="*this"
            class="chip {{partySlotCount === item ? 'chip-on' : ''}}"
            data-count="{{item}}"
            bindtap="onPartySlotPick"
          >{{item}}</view>
        </view>
      </view>

      <view class="field" wx:if="{{!isDaily}}">
        <text class="field-label">本场忌口</text>
        <view class="chip-row">
          <view
            wx:for="{{partyAvoidOptions}}"
            wx:key="id"
            class="chip {{partyAvoidChecked[item.id] ? 'chip-on' : ''}}"
            data-id="{{item.id}}"
            bindtap="togglePartyAvoid"
          >{{item.label}}</view>
        </view>
      </view>

      <!-- 节日选择暂时隐藏，后续有需要再做 -->
    </view>

    <view class="footer-spacer"></view>
    </view>
  </block>

  <view class="footer" wx:if="{{!loading && !error && !holdBlank}}">
    <button type="primary" disabled="{{submitting || liteBusy}}" bindtap="onConfirm">
      确认（已选 {{count}}）
    </button>
  </view>

  <view
    class="mask mask-season-top"
    wx:if="{{seasonalExpanded}}"
    style="top: {{headerHeight}}px;"
    catchtouchmove="noop"
    bindtap="onCloseSeasonalDrawer"
  >
    <view
      class="sheet season-sheet-top"
      style="max-height: calc(100vh - {{headerHeight}}px - 48px);"
      catchtap="noop"
    >
      <view class="toolbar season-sheet-toolbar">
        <view class="toolbar-left">
          <image class="ui-icon ui-icon--sm" src="/assets/images/icons/leafy-vegetables.png" mode="aspectFit" aria-hidden="true"/>
          <text class="section-title">时令菜</text>
          <text class="season-count">已选 {{seasonalCount}} / 共 {{seasonalTotal}}</text>
        </view>
        <text class="link" bindtap="onCloseSeasonalDrawer">收起</text>
      </view>
      <scroll-view scroll-y class="season-sheet-scroll" enhanced show-scrollbar>
        <view class="groups season-sheet-groups">
          <view wx:for="{{seasonalGroups}}" wx:key="category" class="group">
            <view class="group-label">{{item.label}}</view>
            <view class="chip-row">
              <view
                wx:for="{{item.list}}"
                wx:for-item="ing"
                wx:key="id"
                class="chip {{seasonalChecked[ing.id] ? 'chip-on' : ''}}"
                data-id="{{ing.id}}"
                catchtap="toggleSeasonal"
              >{{ing.displayName || ing.name}}</view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="toolbar-actions season-actions">
        <text class="link" bindtap="selectAllSeasonal">{{seasonalSelectAllLabel}}</text>
        <text class="link" bindtap="clearSeasonal">清空</text>
      </view>
    </view>
  </view>

  <view class="mask mask-center mask-lite" wx:if="{{showProfileLite}}" catchtouchmove="true">
    <view class="lite-dialog" catchtap="noop" catchtouchmove="true">
      <profile-lite-form
        show-none-avoids="{{true}}"
        show-city="{{profileLiteNeedCity}}"
        primary-text="保存"
        secondary-text="跳过"
        bind:save="onProfileLiteSave"
        bind:skip="onProfileLiteSkip"
        bind:noneavoids="onProfileLiteNone"
      />
    </view>
  </view>

  <!-- 对齐购买页菜谱弹层：毛玻璃遮罩 + 锚定「更多」芯片的浮卡 -->
  <view
    class="more-meals-mask"
    wx:if="{{showMoreMeals}}"
    catchtouchmove="true"
    bindtap="onCloseMoreMeals"
  />
  <view
    class="more-meals-pop"
    wx:if="{{showMoreMeals && moreMealsPopStyle}}"
    style="{{moreMealsPopStyle}}"
    catchtap="noop"
    catchtouchmove="true"
  >
    <view class="more-meals-pop-body">
      <view class="chip-row chip-row--meal-count more-meals-row">
        <view
          wx:for="{{moreMealCounts}}"
          wx:key="*this"
          class="chip chip--meal-count {{customMealCount === item ? 'chip-on' : ''}}"
          data-count="{{item}}"
          bindtap="onPickMoreMealCount"
        >{{item}}</view>
      </view>
    </view>
  </view>

  <view
    class="mask mask-center mask-meal-gate"
    wx:if="{{showMealGate}}"
    catchtouchmove="true"
    bindtap="onCloseMealGate"
  >
    <view class="meal-gate-dialog" catchtap="noop">
      <view class="meal-gate-hd">
        <view class="meal-gate-title">解锁更多餐</view>
      </view>
      <view wx:if="{{mealGateActionsReady}}" class="meal-gate-actions">
        <button
          wx:if="{{adRewardEnabled}}"
          type="primary"
          bindtap="onMealGateWatchAd"
        >看广告</button>
        <button
          wx:if="{{membershipEnabled}}"
          class="btn-outline"
          bindtap="onMealGateGoMember"
        >开通会员</button>
        <button class="btn-outline" bindtap="onCloseMealGate">关闭</button>
      </view>
    </view>
  </view>

  <view
    class="mask mask-center"
    wx:if="{{showEmptyDialog}}"
    catchtouchmove="true"
    bindtap="onEmptyDialogOk"
  >
    <view class="dialog" catchtap="noop">
      <view class="dialog-title">食材不够出菜了</view>
      <view class="dialog-actions">
        <button class="dialog-btn" hover-class="button-hover" bindtap="onEmptyDialogOk">好吧</button>
      </view>
    </view>
  </view>

  <!-- 菜场规模半屏（页内切换）：遮罩不关；三卡点选 + 取消/确认 -->
  <view
    class="mask"
    wx:if="{{showMarketScale}}"
    catchtouchmove="true"
    catchtap="noop"
  >
    <view class="sheet-confirm sheet-market-scale">
      <view class="sheet-confirm-hd">
        <view class="sheet-title">{{marketScaleTitle}}</view>
        <view class="sheet-hint">{{marketScaleHint}}</view>
      </view>
      <view class="scale-cards">
        <view
          class="scale-card {{marketScaleHighlight === 'small' ? 'on' : ''}}"
          hover-class="tap-hover"
          hover-stay-time="80"
          data-choice="small"
          bindtap="onMarketScalePick"
        >
          <view class="scale-card-main">
            <view class="scale-card-title">小菜场</view>
            <view class="scale-card-desc">小门面、路边摊位</view>
          </view>
          <image
            class="scale-card-icon scale-card-icon--small"
            src="/assets/images/icons/market-scale-small.png"
            mode="heightFix"
            aria-hidden="true"
          />
        </view>
        <view
          class="scale-card {{marketScaleHighlight === 'medium' ? 'on' : ''}}"
          hover-class="tap-hover"
          hover-stay-time="80"
          data-choice="medium"
          bindtap="onMarketScalePick"
        >
          <view class="scale-card-main">
            <view class="scale-card-title">中菜场</view>
            <view class="scale-card-desc">普通超市、连着几个门面</view>
          </view>
          <image
            class="scale-card-icon scale-card-icon--medium"
            src="/assets/images/icons/market-scale-medium.png"
            mode="heightFix"
            aria-hidden="true"
          />
        </view>
        <view
          class="scale-card {{marketScaleHighlight === 'large' ? 'on' : ''}}"
          hover-class="tap-hover"
          hover-stay-time="80"
          data-choice="large"
          bindtap="onMarketScalePick"
        >
          <view class="scale-card-main">
            <view class="scale-card-title">大菜场</view>
            <view class="scale-card-desc">集贸市场、大超市、很多摊位</view>
          </view>
          <image
            class="scale-card-icon scale-card-icon--large"
            src="/assets/images/icons/market-scale-large.png"
            mode="heightFix"
            aria-hidden="true"
          />
        </view>
      </view>
      <view class="scale-actions">
        <button
          size="mini"
          class="btn-outline"
          disabled="{{marketScaleBusy}}"
          bindtap="onMarketScaleCancel"
        >取 消</button>
        <button
          size="mini"
          type="{{marketScaleHighlight ? 'primary' : 'default'}}"
          class="{{marketScaleHighlight ? '' : 'btn-outline btn-confirm-disabled'}}"
          disabled="{{marketScaleBusy || !marketScaleHighlight}}"
          bindtap="onMarketScaleConfirm"
        >确 认</button>
      </view>
    </view>
  </view>

  <busy-overlay show="{{loading || submitting || liteBusy || marketScaleBusy}}" />
</view>
