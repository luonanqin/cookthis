.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.state {
  padding: 80rpx 0;
  text-align: center;
  color: #888;
  font-size: 28rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
}

.toolbar-actions {
  display: flex;
  gap: 32rpx;
}

.link {
  color: #576b95;
  font-size: 28rpx;
}

.groups {
  margin-bottom: 24rpx;
}

.group {
  margin-bottom: 20rpx;
}

.group-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.row checkbox {
  opacity: 1;
}

.name {
  font-size: 30rpx;
  color: #222;
  flex: 1;
}

.year-round {
  margin: 16rpx 0 32rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.fold-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #fff;
}

.fold-icon {
  color: #576b95;
  font-size: 26rpx;
}

.fold-body {
  padding: 0 24rpx 16rpx;
}

.manual {
  margin-bottom: 24rpx;
}

.manual-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.manual-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.manual-item {
  justify-content: space-between;
}

.footer-spacer {
  height: 160rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #f7f7f7;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
}
