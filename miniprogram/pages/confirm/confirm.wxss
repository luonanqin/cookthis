.page {
  min-height: 100vh;
  padding: 0;
  box-sizing: border-box;
  background: var(--color-bg);
}

.confirm-body {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.season-card {
  margin-bottom: 24rpx;
}

.season-preview {
  position: relative;
  margin-top: 8rpx;
}

.season-preview-row {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: 8rpx 20rpx;
  /* 约一行半：完整一行 + 半行由底部渐隐盖住（对齐建议反馈 .clip / .fade-user） */
  max-height: 66rpx;
  overflow: hidden;
}

.large-text .season-preview-row {
  max-height: 84rpx;
}

.season-preview-name {
  font-size: var(--fs-body);
  line-height: 1.45;
  color: var(--color-text);
}

.season-preview-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 48rpx;
  pointer-events: none;
  background: linear-gradient(
    to bottom,
    rgba(255, 254, 250, 0),
    var(--color-surface)
  );
}

.season-expand-link {
  flex-shrink: 0;
  font-size: var(--fs-sm);
}

/* 高于 page-header，面板用 margin-top 落在页头下方，避开状态栏/胶囊 */
.mask.mask-season-top {
  align-items: flex-start;
  z-index: 120;
}

.season-sheet-top {
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-surface);
  border-radius: 0 0 var(--radius-sheet) var(--radius-sheet);
  padding: 24rpx 28rpx 28rpx;
  box-sizing: border-box;
}

.season-sheet-toolbar {
  flex-shrink: 0;
  margin-bottom: 16rpx;
}

.season-sheet-scroll {
  flex: 1;
  height: 0;
  min-height: 240rpx;
  max-height: 58vh;
}

.season-sheet-groups {
  margin-bottom: 0;
  padding-bottom: 8rpx;
}

.season-sheet-groups .group:last-child {
  margin-bottom: 0;
}

.season-sheet-top .season-actions {
  flex-shrink: 0;
}

.toolbar-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.season-count {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--color-coral-soft);
  color: #c56a55;
  font-size: var(--fs-xs);
  font-weight: var(--fw-medium);
  line-height: 1.4;
}

.season-actions {
  margin: 16rpx 0 0;
  justify-content: flex-end;
}

.state {
  padding: 80rpx 0;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--fs-body);
}

.empty-tip {
  margin: 16rpx 0 24rpx;
  padding: 20rpx;
  background: var(--color-primary-soft);
  border-radius: 12rpx;
  color: var(--color-text-secondary);
  font-size: var(--fs-sm);
  line-height: 1.5;
}

.market-scale-entry {
  display: flex;
  justify-content: flex-end;
  margin: 0 4rpx 12rpx;
}

.market-scale-entry-link {
  font-size: var(--fs-sm);
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: var(--fs-title);
  font-weight: var(--fw-semibold);
  color: var(--color-forest);
}

.title-warn {
  color: #e54d42 !important;
}

.title-pulse {
  display: inline-block;
  animation: title-flash 0.45s ease 2;
}

@keyframes title-flash {
  0%,
  100% {
    transform: scale(1);
  }
  35% {
    transform: scale(0.88);
  }
  65% {
    transform: scale(1.06);
  }
}

.toolbar-actions {
  display: flex;
  gap: 32rpx;
}

.link {
  color: var(--color-primary);
  font-size: var(--fs-body);
}

.groups {
  margin-bottom: 24rpx;
}

.group {
  margin-bottom: 20rpx;
}

.group-label {
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.groups .chip-row {
  margin-top: 0;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.name {
  font-size: var(--fs-btn);
  color: var(--color-text);
  flex: 1;
}

.year-round {
  margin: 16rpx 0 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  overflow: hidden;
  border: 1rpx solid var(--color-border);
}

.fold-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 24rpx 20rpx;
  font-size: var(--fs-body);
  color: var(--color-text);
  background: var(--color-surface);
}

.fold-icon {
  flex-shrink: 0;
  color: var(--color-primary);
  font-size: var(--fs-sm);
  font-weight: var(--fw-medium);
}

.fold-body {
  padding: 0 24rpx 20rpx;
}

.fold-body .group {
  margin-bottom: 16rpx;
}

.fold-body .chip {
  font-size: var(--fs-sm);
  padding: 10rpx 16rpx;
}

.manual {
  margin-bottom: 24rpx;
  padding-top: 24rpx;
}

.manual .section-title {
  margin-bottom: 0;
}

.manual-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
}

.manual-field {
  flex: 1;
  min-width: 240rpx;
}

.manual-input {
  width: 100%;
  height: 64rpx;
  padding: 0 20rpx;
  background: var(--color-surface);
  border-radius: 12rpx;
  font-size: var(--fs-body);
  border: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.manual-suggest {
  margin-top: 8rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.manual-row button {
  flex-shrink: 0;
}

.manual-suggest-item {
  padding: 16rpx 20rpx;
  font-size: var(--fs-body);
  color: var(--color-text);
  line-height: 1.4;
  border-bottom: 1rpx solid var(--color-border);
}

.manual-suggest-item:last-child {
  border-bottom: none;
}

.manual-suggest-empty {
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.manual-chips {
  margin-top: 16rpx;
}

.manual-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  padding: 10rpx 12rpx 10rpx 16rpx;
  background: var(--color-primary-soft);
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-chip);
  box-sizing: border-box;
  line-height: 1.25;
}

.manual-chip--unmatched {
  background: var(--color-surface);
  border-color: var(--color-border);
}

.manual-chip-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--fs-sm);
  color: var(--color-primary);
}

.manual-chip--unmatched .manual-chip-text {
  color: var(--color-text);
}

.manual-chip-hint {
  flex-shrink: 0;
  font-size: var(--fs-xs);
  color: var(--color-text-muted);
}

.manual-chip-x {
  flex-shrink: 0;
  padding: 0 4rpx;
  font-size: 28rpx;
  line-height: 1;
  color: var(--color-primary);
}

.manual-chip--unmatched .manual-chip-x {
  color: var(--color-text-secondary);
}

.scene {
  margin: 0 0 24rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 16rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-chip);
  font-size: var(--fs-sm);
  color: var(--color-text);
  box-sizing: border-box;
  line-height: 1.25;
}

.chip-row--meal-count {
  gap: 16rpx;
}

.chip--meal-count {
  min-width: 72rpx;
  min-height: 72rpx;
  padding: 16rpx 20rpx;
  justify-content: center;
  font-size: var(--fs-md);
  font-weight: var(--fw-semibold);
}

.more-meals-row {
  margin-top: 4rpx;
  flex-wrap: nowrap;
  justify-content: flex-start;
  gap: 12rpx;
}

/* 弹层打开时「更多」浮在遮罩之上，保持可见可点 */
.chip--above-mask {
  position: relative;
  z-index: 20;
}

.chip-on {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.field {
  margin-top: 20rpx;
}

.field-label {
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.field-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.field-label-row .field-label {
  margin-bottom: 0;
  flex-shrink: 0;
}

.field-label-meta {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  text-align: right;
}

.field-input {
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--color-surface);
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  font-size: var(--fs-body);
}

.picker-row,
.picker-cell {
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  background: var(--color-surface);
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  font-size: var(--fs-body);
  color: var(--color-text);
  box-sizing: border-box;
}

.combo-row {
  display: flex;
  gap: 12rpx;
}

.combo-row picker {
  flex: 1;
}

.picker-cell {
  text-align: center;
}

.combo-item {
  flex: 1;
  font-size: var(--fs-md);
  color: var(--color-text);
}

.stepper {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.step-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: var(--fs-title);
  color: var(--color-primary);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 10rpx;
}

.slot-stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 12rpx;
}

.slot-count {
  font-size: var(--fs-btn);
  color: var(--color-text);
  min-width: 40rpx;
  text-align: center;
}

/* 「更多」餐数：对齐购买页 recipe-pop（毛玻璃遮罩 + 锚定浮卡） */
.more-meals-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 18;
  background: rgba(255, 252, 248, 0.1);
  backdrop-filter: blur(16px) saturate(1.15);
  -webkit-backdrop-filter: blur(16px) saturate(1.15);
}

.more-meals-pop {
  position: fixed;
  z-index: 19;
  width: max-content;
  max-width: calc(100vw - 24rpx);
  background: var(--color-surface);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(26, 26, 26, 0.16);
  border: 1rpx solid var(--color-border);
  box-sizing: border-box;
  overflow: hidden;
  animation: more-meals-pop-in 0.16s ease-out;
}

@keyframes more-meals-pop-in {
  from {
    opacity: 0;
    transform: translateY(12rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.more-meals-pop-body {
  padding: 10rpx;
  box-sizing: border-box;
}

.custom-slot-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
}

/* 标签+步进器整体居中；两行同宽对齐，避免名称固定宽导致视觉偏左 */
.custom-slot-cluster {
  display: grid;
  grid-template-columns: 72rpx 48rpx 48rpx 48rpx;
  align-items: center;
  justify-items: center;
  column-gap: 16rpx;
}

.custom-slot-name {
  width: 100%;
  font-size: var(--fs-body);
  color: var(--color-text);
  text-align: center;
  line-height: 1.2;
}

.custom-slot-cluster .step-btn,
.custom-slot-cluster .slot-count {
  justify-self: center;
}

.custom-slots-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  margin-top: 24rpx;
}

/* 大字版：人数/搭配 picker 触发格与步进钮加大触控与字号 */
.large-text .picker-row,
.large-text .picker-cell {
  min-height: 96rpx;
  line-height: 96rpx;
  padding: 0 24rpx;
  font-size: var(--fs-title);
}

.large-text .field-input {
  height: 96rpx;
  font-size: var(--fs-title);
}

.large-text .step-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: var(--fs-lead);
  border-radius: 12rpx;
}

.large-text .slot-count {
  font-size: var(--fs-lead);
  min-width: 56rpx;
}

.large-text .custom-slot-cluster {
  grid-template-columns: 88rpx 72rpx 72rpx 72rpx;
  column-gap: 20rpx;
}

.large-text .slot-stepper {
  gap: 32rpx;
}

.large-text .combo-item {
  font-size: var(--fs-body);
}

.hint {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
}

.linkish {
  color: var(--color-primary);
}

.holiday-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding: 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
}

.holiday-on {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.holiday-date {
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
}

.footer-spacer {
  height: 160rpx;
}

.footer {
  z-index: 12;
}

.footer button[type='primary'] {
  font-weight: var(--fw-semibold) !important;
}

.lite-more {
  margin-top: 8rpx;
  font-size: var(--fs-sm);
}

.lite-love-label {
  margin-top: 24rpx;
  margin-bottom: 8rpx;
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
}

/* 菜场规模：同款贴底半屏（自包含，对齐首页 sheet-confirm） */
.sheet-confirm {
  width: 100%;
  max-height: 60vh;
  background: var(--color-surface);
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sheet-confirm-hd {
  flex-shrink: 0;
  padding: 32rpx 28rpx 0;
}

.sheet-confirm-hd .sheet-hint {
  margin-bottom: 8rpx;
}

.sheet-market-scale {
  max-height: 70vh;
}

.scale-cards {
  padding: 8rpx 28rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.scale-card {
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 10rpx 8rpx 10rpx 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  background: var(--color-bg);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  overflow: visible;
}

.scale-card.on {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.scale-card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.scale-card-title {
  font-size: var(--fs-title);
  font-weight: var(--fw-semibold);
  color: var(--color-text);
  line-height: 1.3;
}

.scale-card.on .scale-card-title {
  color: var(--color-primary);
}

/* heightFix：高度撑满，宽度按比例变宽；margin-left:auto 贴右 */
.scale-card-icon {
  flex-shrink: 0;
  display: block;
  margin-left: auto;
  height: 100rpx;
  width: auto;
}

.scale-card-icon--small {
  height: 100rpx;
}

.scale-card-icon--medium,
.scale-card-icon--large {
  height: 100rpx;
}

.scale-card-desc {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  line-height: 1.35;
}

.sheet-meal-gate {
  max-height: 50vh;
}

.meal-gate-actions {
  flex-shrink: 0;
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meal-gate-actions button {
  margin: 0 !important;
  width: 100% !important;
}

.scale-actions {
  flex-shrink: 0;
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 28rpx;
  border-top: 1rpx solid var(--color-border);
}

.scale-actions button.btn-confirm-disabled[disabled] {
  color: var(--color-text-muted) !important;
  border-color: var(--color-border) !important;
  background: var(--color-surface-soft) !important;
  opacity: 1 !important;
}

/* Icon assets */
.fold-title-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.confirm-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 与常见菜 ui-icon--sm(40rpx) 对齐；+ 单独光学居中 */
.plus-mark {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.plus-mark-glyph {
  font-size: 28rpx;
  font-weight: var(--fw-semibold);
  line-height: 1;
  transform: translateY(-2rpx);
}

.field-label-with-icon {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
