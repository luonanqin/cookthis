.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.state {
  padding: 80rpx 0;
  text-align: center;
  color: #888;
  font-size: 28rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
}

.toolbar-actions {
  display: flex;
  gap: 32rpx;
}

.link {
  color: #576b95;
  font-size: 28rpx;
}

.groups {
  margin-bottom: 24rpx;
}

.group {
  margin-bottom: 20rpx;
}

.group-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.row checkbox {
  opacity: 1;
}

.name {
  font-size: 30rpx;
  color: #222;
  flex: 1;
}

.year-round {
  margin: 16rpx 0 32rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.fold-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #fff;
}

.fold-icon {
  color: #576b95;
  font-size: 26rpx;
}

.fold-body {
  padding: 0 24rpx 16rpx;
}

.manual {
  margin-bottom: 24rpx;
}

.manual-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.manual-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.manual-item {
  justify-content: space-between;
}

.scene {
  margin: 32rpx 0 24rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #eee;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #333;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

.chip-on {
  color: #07c160;
  border-color: #07c160;
  background: #e8f8ef;
}

.field {
  margin-top: 28rpx;
}

.field-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.field-input {
  margin-top: 12rpx;
  height: 64rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.combo-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 12rpx;
}

.combo-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #222;
}

.stepper {
  display: flex;
  gap: 8rpx;
}

.step-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 32rpx;
  color: #576b95;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

.slot-stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 12rpx;
}

.slot-count {
  font-size: 30rpx;
  color: #222;
  min-width: 40rpx;
  text-align: center;
}

.custom-slot-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 0;
}

.custom-slot-name {
  width: 80rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.hint {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #888;
}

.holiday-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
}

.holiday-on {
  border-color: #07c160;
  background: #e8f8ef;
}

.holiday-date {
  font-size: 26rpx;
  color: #888;
}

.footer-spacer {
  height: 160rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #f7f7f7;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 30;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 70vh;
  overflow-y: auto;
}

.sheet-title {
  font-weight: 600;
  font-size: 32rpx;
}

.transcript {
  color: #888;
  font-size: 24rpx;
  margin: 12rpx 0 16rpx;
}

.voice-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 28rpx;
}

.voice-row.on {
  color: #2e7d32;
}

.voice-row .check {
  width: 40rpx;
  margin-right: 12rpx;
}

.sheet-actions {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
  margin-top: 24rpx;
}
