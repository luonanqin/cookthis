.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
  background: var(--color-bg);
}

.state {
  padding: 80rpx 0;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--fs-body);
}

.empty-tip {
  margin: 16rpx 0 24rpx;
  padding: 20rpx;
  background: var(--color-primary-soft);
  border-radius: 12rpx;
  color: var(--color-text-secondary);
  font-size: var(--fs-sm);
  line-height: 1.5;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--color-text);
}

.toolbar-actions {
  display: flex;
  gap: 32rpx;
}

.link {
  color: var(--color-primary);
  font-size: var(--fs-body);
}

.groups {
  margin-bottom: 24rpx;
}

.group {
  margin-bottom: 20rpx;
}

.group-label {
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.groups .chip-row {
  margin-top: 0;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.name {
  font-size: var(--fs-btn);
  color: var(--color-text);
  flex: 1;
}

.year-round {
  margin: 16rpx 0 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  overflow: hidden;
  border: 1rpx solid var(--color-border);
}

.fold-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  font-size: var(--fs-body);
  color: var(--color-text);
  background: var(--color-surface);
}

.fold-icon {
  color: var(--color-primary);
  font-size: var(--fs-md);
}

.fold-body {
  padding: 0 24rpx 20rpx;
}

.fold-body .group {
  margin-bottom: 16rpx;
}

.fold-body .chip {
  font-size: var(--fs-sm);
  padding: 10rpx 18rpx;
}

.manual {
  margin-bottom: 24rpx;
}

.manual-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.manual-input {
  flex: 1;
  min-width: 240rpx;
  height: 64rpx;
  padding: 0 20rpx;
  background: var(--color-surface);
  border-radius: 12rpx;
  font-size: var(--fs-body);
  border: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.manual-item {
  justify-content: space-between;
}

.scene {
  margin: 32rpx 0 24rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.chip {
  padding: 12rpx 22rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: var(--fs-sm);
  color: var(--color-text);
}

.chip-on {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.field {
  margin-top: 20rpx;
}

.field-label {
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.field-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.field-label-row .field-label {
  margin-bottom: 0;
  flex-shrink: 0;
}

.field-label-meta {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  text-align: right;
}

.field-input {
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--color-surface);
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  font-size: var(--fs-body);
}

.picker-row,
.picker-cell {
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  background: var(--color-surface);
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  font-size: var(--fs-body);
  color: var(--color-text);
  box-sizing: border-box;
}

.combo-row {
  display: flex;
  gap: 12rpx;
}

.combo-row picker {
  flex: 1;
}

.picker-cell {
  text-align: center;
}

.combo-item {
  flex: 1;
  font-size: var(--fs-md);
  color: var(--color-text);
}

.stepper {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.step-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: var(--fs-title);
  color: var(--color-primary);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 10rpx;
}

.slot-stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 12rpx;
}

.slot-count {
  font-size: var(--fs-btn);
  color: var(--color-text);
  min-width: 40rpx;
  text-align: center;
}

/* 自定义几顿：下半屏略抬高、水平居中的独立卡片（非贴底 sheet） */
.mask.mask-custom-slots {
  align-items: flex-end;
  justify-content: center;
  padding: 0 48rpx calc(20vh + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.custom-slots-panel {
  width: 100%;
  max-width: 560rpx;
  background: var(--color-surface);
  border-radius: var(--radius-sheet);
  padding: 32rpx 28rpx 28rpx;
  box-sizing: border-box;
  text-align: center;
}

.custom-slots-title {
  font-weight: 600;
  font-size: var(--fs-title);
  color: var(--color-text);
  text-align: center;
}

.custom-slot-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 20rpx 0;
}

.custom-slot-name {
  width: 80rpx;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
}

.custom-slots-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  margin-top: 24rpx;
}

.custom-slots-panel .custom-slots-btn {
  margin: 0 !important;
  min-width: 128rpx !important;
  padding: 0 28rpx !important;
}

/* 大字版：人数/搭配 picker 触发格与步进钮加大触控与字号 */
.large-text .picker-row,
.large-text .picker-cell {
  min-height: 96rpx;
  line-height: 96rpx;
  padding: 0 24rpx;
  font-size: var(--fs-title);
}

.large-text .field-input {
  height: 96rpx;
  font-size: var(--fs-title);
}

.large-text .step-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: var(--fs-lead);
  border-radius: 12rpx;
}

.large-text .slot-count {
  font-size: var(--fs-lead);
  min-width: 56rpx;
}

.large-text .slot-stepper {
  gap: 32rpx;
}

.large-text .combo-item {
  font-size: var(--fs-body);
}

.hint {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
}

.linkish {
  color: var(--color-primary);
}

.holiday-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding: 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
}

.holiday-on {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.holiday-date {
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
}

.footer-spacer {
  height: 160rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 1rpx solid var(--color-border);
}

.lite-more {
  margin-top: 8rpx;
  font-size: var(--fs-sm);
}

.lite-love-label {
  margin-top: 24rpx;
  margin-bottom: 8rpx;
  font-size: var(--fs-md);
  color: var(--color-text-secondary);
}
