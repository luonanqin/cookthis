.page {
  padding: 0 28rpx 80rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--color-bg);
}

.composer {
  position: sticky;
  top: 0;
  z-index: 12;
  margin: 0 -28rpx 20rpx;
  padding: 20rpx 28rpx 16rpx;
  box-sizing: border-box;
  background: var(--color-bg);
  border-bottom: 1rpx solid var(--color-border);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.chip {
  padding: 10rpx 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: var(--fs-sm);
  color: var(--color-text);
}

.chip.on {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.composer-input {
  width: 100%;
  /* 约 100 字完整可见，不裁切 */
  min-height: 280rpx;
  max-height: none;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: var(--fs-body);
  color: var(--color-text);
  line-height: 1.5;
}

.composer-bar {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.composer-bar-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.count {
  flex: none;
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  line-height: 1;
}

/* 小程序 button 默认 width:100%，会把字数顶到左边 */
.composer-bar-right button {
  flex: none !important;
  width: auto !important;
  margin: 0 !important;
}

.empty,
.more {
  padding: 64rpx 24rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--fs-body);
}

.more {
  padding: 24rpx;
  font-size: var(--fs-sm);
}

.more.muted {
  opacity: 0.7;
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 20rpx 24rpx 16rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-border);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-head-left {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  min-width: 0;
}

.cat {
  font-size: var(--fs-sm);
  color: var(--color-primary);
  font-weight: 500;
}

.time {
  font-size: var(--fs-xs);
  color: var(--color-text-secondary);
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e05555;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.block {
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.block:last-child {
  margin-bottom: 0;
}

.user-block {
  background: var(--color-bg);
  color: var(--color-text);
}

.reply-block {
  background: var(--color-primary-soft);
  color: var(--color-text);
  border-left: 6rpx solid var(--color-primary);
}

.reply-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 8rpx;
  min-width: 0;
}

.reply-label {
  font-size: var(--fs-xs);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.clip {
  position: relative;
  font-size: var(--fs-body);
  line-height: 1.5;
  overflow: hidden;
  /* 收起：完整两行 + 第三行半截（由底部渐隐盖住） */
  max-height: 105rpx;
}

.large-text .clip {
  max-height: 135rpx;
}

.clip.expanded {
  max-height: none;
  overflow: visible;
}

.clip-inner {
  font-size: inherit;
  line-height: inherit;
  word-break: break-word;
  white-space: pre-wrap;
}

.fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 48rpx;
  pointer-events: none;
}

.fade-user {
  background: linear-gradient(to bottom, rgba(246, 249, 247, 0), var(--color-bg));
}

.fade-reply {
  background: linear-gradient(to bottom, rgba(234, 244, 238, 0), var(--color-primary-soft));
}

.expand-btn {
  margin-top: 0;
  padding: 24rpx 8rpx 24rpx 32rpx;
  box-sizing: border-box;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: var(--fs-sm);
  color: var(--color-primary);
}
