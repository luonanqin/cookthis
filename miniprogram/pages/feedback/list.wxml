<view class="page {{typeScaleClass}}">
  <page-header title="建议反馈" subtitle="想听听您的想法" bind:heightchange="onHeaderHeight" />
  <view class="page-body">
  <view class="composer" style="top: {{headerHeight}}px;">
    <view class="chips">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="chip {{category === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        hover-class="tap-hover"
        bindtap="onPickCategory"
      >
        <image wx:if="{{item.id === 'recipe'}}" class="ui-icon feedback-chip-icon" src="/assets/images/icons/soup-bowl.png" mode="aspectFit" aria-hidden="true"/>
        <image wx:elif="{{item.id === 'ingredient'}}" class="ui-icon feedback-chip-icon" src="/assets/images/icons/leafy-vegetables.png" mode="aspectFit" aria-hidden="true"/>
        <image wx:elif="{{item.id === 'feature'}}" class="ui-icon feedback-chip-icon" src="/assets/images/icons/feedback-feature.png" mode="aspectFit" aria-hidden="true"/>
        <image wx:else class="ui-icon feedback-chip-icon" src="/assets/images/icons/feedback-other.png" mode="aspectFit" aria-hidden="true"/>
        <text>{{item.label}}</text>
      </view>
    </view>
    <textarea
      class="composer-input"
      maxlength="100"
      value="{{draft}}"
      placeholder="写一条建议（最多100字）"
      bindinput="onDraftInput"
    />
    <view class="composer-bar">
      <view class="composer-bar-right">
        <text class="count">{{draftLen}}/100</text>
        <button size="mini" type="primary" loading="{{submitting}}" bindtap="onSubmit">提交</button>
      </view>
    </view>
  </view>
  <view class="composer-spacer" style="height: {{composerHeight}}px;" aria-hidden="true"></view>

  <view wx:if="{{loading && !items.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!items.length}}" class="empty">还没有反馈，写一条试试</view>

  <block wx:for="{{items}}" wx:key="id">
    <view class="card" data-id="{{item.id}}" hover-class="tap-hover" bindtap="onCardTap">
      <view class="card-head">
        <view class="card-head-left">
          <image wx:if="{{item.category === 'recipe'}}" class="ui-icon feedback-card-icon" src="/assets/images/icons/soup-bowl.png" mode="aspectFit" aria-hidden="true"/>
          <image wx:elif="{{item.category === 'ingredient'}}" class="ui-icon feedback-card-icon" src="/assets/images/icons/leafy-vegetables.png" mode="aspectFit" aria-hidden="true"/>
          <image wx:elif="{{item.category === 'feature'}}" class="ui-icon feedback-card-icon" src="/assets/images/icons/feedback-feature.png" mode="aspectFit" aria-hidden="true"/>
          <image wx:else class="ui-icon feedback-card-icon" src="/assets/images/icons/feedback-other.png" mode="aspectFit" aria-hidden="true"/>
          <text class="cat">{{item.categoryLabel}}</text>
          <text class="time">{{item.timeText}}</text>
        </view>
        <view wx:if="{{item.unread}}" class="dot"></view>
      </view>

      <view class="block user-block">
        <view class="clip {{item.contentExpanded ? 'expanded' : ''}}">
          <view class="clip-inner js-content-inner" data-id="{{item.id}}">{{item.content}}</view>
          <view
            wx:if="{{item.contentOverflow && !item.contentExpanded}}"
            class="fade fade-user"
          ></view>
        </view>
        <view
          wx:if="{{item.contentOverflow}}"
          class="expand-btn"
          data-id="{{item.id}}"
          data-which="content"
          catchtap="onExpand"
        >{{item.contentExpanded ? '收起' : '展开'}}</view>
      </view>

      <view wx:if="{{item.replyText}}" class="block reply-block">
        <view class="reply-head">
          <view class="reply-admin"><image class="ui-icon admin-icon" src="/assets/images/icons/admin-user.png" mode="aspectFit" aria-hidden="true"/><text class="reply-label">管理员</text></view>
          <text wx:if="{{item.replyTimeText}}" class="time">{{item.replyTimeText}}</text>
        </view>
        <view class="clip {{item.replyExpanded ? 'expanded' : ''}}">
          <view class="clip-inner js-reply-inner" data-id="{{item.id}}">{{item.replyText}}</view>
          <view
            wx:if="{{item.replyOverflow && !item.replyExpanded}}"
            class="fade fade-reply"
          ></view>
        </view>
        <view
          wx:if="{{item.replyOverflow}}"
          class="expand-btn"
          data-id="{{item.id}}"
          data-which="reply"
          catchtap="onExpand"
        >{{item.replyExpanded ? '收起' : '展开'}}</view>
      </view>
    </view>
  </block>

  <view wx:if="{{loadingMore}}" class="more">加载中…</view>
  <view wx:elif="{{items.length && !nextCursor && !loading}}" class="more muted">没有更多了</view>
  </view>
</view>
