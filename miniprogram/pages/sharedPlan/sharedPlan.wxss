.page {
  padding: 24rpx 28rpx 220rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--color-bg);
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--fs-body);
}

.empty-text {
  color: var(--color-text-secondary);
  font-size: var(--fs-body);
}

.hero {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  border-radius: var(--radius-card);
  font-size: var(--fs-md);
  font-weight: 600;
  line-height: 1.4;
}

.section {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--color-border);
}

.meal + .meal {
  margin-top: 18rpx;
}

.meal-label {
  color: var(--color-text-secondary);
  font-size: var(--fs-sm);
  margin-bottom: 10rpx;
}

.dish-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240rpx, 1fr));
  column-gap: 8rpx;
  row-gap: 6rpx;
}

.dish {
  display: flex;
  align-items: baseline;
  min-width: 0;
  font-size: var(--fs-body);
  line-height: 1.55;
  color: var(--color-text);
  padding-right: 8rpx;
  box-sizing: border-box;
}

.dish-mark {
  flex-shrink: 0;
  width: 28rpx;
  color: var(--color-primary);
  opacity: 0.55;
  font-weight: 700;
}

.dish-name {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.group {
  margin-bottom: 28rpx;
}

.group-label {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.pair-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.cell {
  flex: 0 0 calc((100% - 12rpx) / 2);
  width: calc((100% - 12rpx) / 2);
  max-width: calc((100% - 12rpx) / 2);
  min-width: 0;
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 20rpx 16rpx;
  border: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.name {
  font-size: var(--fs-body);
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 12;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
}

.save-btn {
  margin: 0;
  width: 100%;
}

.saved-hint {
  text-align: center;
  padding: 20rpx 16rpx;
  color: var(--color-text-secondary);
  font-size: var(--fs-md);
  line-height: 1.4;
}
