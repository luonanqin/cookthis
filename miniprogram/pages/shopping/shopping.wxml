<view class="page {{typeScaleClass}}">
  <page-header title="购买清单" subtitle="把新鲜食材带回家" />
  <view class="page-body shopping-body">
  <view wx:if="{{accepted}}" class="banner">
    <view class="banner-copy"><image class="ui-icon ui-icon--sm" src="/assets/images/icons/leafy-vegetables.png" mode="aspectFit" aria-hidden="true"/><text class="banner-text">已采纳，可按清单采购</text></view>
    <button
      wx:if="{{planShareEnabled && !loading && !empty}}"
      class="banner-share"
      open-type="share"
      data-entry="shopping"
      hover-class="button-hover"
      size="mini"
    ><image class="ui-icon banner-share-icon" src="/assets/images/icons/share-export-green.png" mode="aspectFit" aria-hidden="true"/><text>分享</text></button>
  </view>

  <view wx:if="{{loading}}" class="empty">
    <text>清单加载中…</text>
  </view>

  <view wx:elif="{{empty}}" class="empty">
    <text>{{emptyText}}</text>
  </view>

  <block wx:else>
    <view class="group" wx:for="{{groups}}" wx:key="category">
      <view class="group-label">
        <image wx:if="{{item.category === '肉类' || item.category === '内脏'}}" class="ui-icon shopping-group-icon" src="/assets/images/icons/meat-category.png" mode="aspectFit" aria-hidden="true"/>
        <image wx:elif="{{item.category === '菜叶' || item.category === '瓜果' || item.category === '根茎' || item.category === '水果'}}" class="ui-icon shopping-group-icon" src="/assets/images/icons/vegetable-crate.png" mode="aspectFit" aria-hidden="true"/>
        <image wx:elif="{{item.category === '菌菇'}}" class="ui-icon shopping-group-icon" src="/assets/images/icons/mushroom-category.png" mode="aspectFit" aria-hidden="true"/>
        <image wx:elif="{{item.category === '蛋奶'}}" class="ui-icon shopping-group-icon" src="/assets/images/icons/egg-category.png" mode="aspectFit" aria-hidden="true"/>
        <text>{{item.label}}</text>
      </view>
      <view class="pair-row" wx:for="{{item.rows}}" wx:for-item="row" wx:key="rowKey">
        <view
          class="cell {{cell.bought ? 'bought' : ''}}"
          wx:for="{{row.cells}}"
          wx:for-item="cell"
          wx:key="name"
          data-name="{{cell.name}}"
          hover-class="tap-hover"
          hover-stay-time="80"
          bindtap="onToggle"
        >
          <view class="check">{{cell.bought ? '✓' : ''}}</view>
          <view class="name-line">
            <text class="name">{{cell.displayName || cell.name}}</text>
            <text wx:if="{{cell.secondaryName}}" class="secondary">{{cell.secondaryName}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="ad-slot" wx:for="{{adSlots}}" wx:key="id">
    <ad unit-id="{{item.unitId}}"></ad>
  </view>
  </view>

  <!-- 点空白关闭；从菜谱钮向上弹出 -->
  <view
    class="recipe-pop-mask"
    wx:if="{{showRecipeSheet}}"
    catchtouchmove="true"
    bindtap="onRecipeSheetClose"
  />

  <view
    class="fab-stack {{fabDimmed && !showRecipeSheet ? 'fab-dimmed' : ''}}"
    wx:if="{{!loading && !empty}}"
  >
    <view class="recipe-pop" wx:if="{{showRecipeSheet}}" catchtap="noop">
      <view class="recipe-pop-body">
        <view
          class="recipe-group"
          wx:for="{{recipeGroups}}"
          wx:for-item="group"
          wx:key="type"
        >
          <view class="recipe-group-head">
            <text class="type-badge type-{{group.type}}">{{group.label}}</text>
          </view>
          <view
            class="dish-row"
            wx:for="{{group.dishes}}"
            wx:for-item="dish"
            wx:for-index="dishIdx"
            wx:key="dishIdx"
          >
            <text class="dish-name">{{dish.name}}</text>
            <text class="dish-ings">{{dish.ingredientText}}</text>
          </view>
        </view>
      </view>
    </view>
    <button
      class="fab fab-swap"
      disabled="{{fabDimmed && !showRecipeSheet}}"
      bindtap="onRecipeFabTap"
    >菜 谱</button>
  </view>

  <view class="footer">
    <button class="btn-outline" bindtap="onBack">返回</button>
  </view>
</view>
