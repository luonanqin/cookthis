<page-meta page-style="{{showQuickLite ? 'overflow: hidden;' : ''}}" />
<view class="page {{typeScaleClass}}">
  <page-header title="推荐方案" subtitle="根据食材和要求进行搭配" />
  <view class="page-body recommend-body">
  <view
    wx:if="{{showProfileBanner}}"
    class="profile-banner"
    hover-class="tap-hover"
    hover-stay-time="80"
    bindtap="onOpenQuickLite"
  >
    <text>补充饮食偏好，让推荐更精准 </text>
    <text class="profile-banner-cta">点我</text>
  </view>

  <view wx:if="{{empty}}" class="empty">
    <text class="empty-text">{{emptyText}}</text>
  </view>

  <block wx:else>
    <view wx:if="{{sceneSummary}}" class="scene-bar">
      <image class="ui-icon ui-icon--sm" src="/assets/images/icons/group-people.png" mode="aspectFit" aria-hidden="true"/>
      <text class="scene-bar-text">{{sceneSummary}}</text>
      <text class="scene-bar-edit" hover-class="tap-hover" hover-stay-time="80" bindtap="onBack">修改 ></text>
    </view>
    <view class="plan" wx:for="{{plans}}" wx:key="planIndex">
      <view class="plan-head">
        <view class="plan-title">方案 {{item.planIndex + 1}}</view>
        <view class="plan-actions">
          <button
            class="plan-share"
            size="mini"
            open-type="share"
            data-plan-index="{{item.planIndex}}"
            data-entry="recommend"
            hover-class="tap-hover"
            aria-label="分享"
          ><image class="ui-icon ui-icon--md" src="/assets/images/icons/share-export-green.png" mode="aspectFit" aria-hidden="true"/></button>
          <button
            size="mini"
            type="primary"
            class="plan-accept"
            disabled="{{busy}}"
            data-plan-index="{{item.planIndex}}"
            bindtap="onAccept"
          ><image class="ui-icon ui-icon--xs" src="/assets/images/icons/cart-white.png" mode="aspectFit" aria-hidden="true"/><text>去买菜</text></button>
        </view>
      </view>
      <view class="meal" wx:for="{{item.meals}}" wx:for-item="meal" wx:key="mealKey">
        <view wx:if="{{item.meals.length > 1}}" class="meal-label">{{meal.slot.label || meal.slot.meal}}</view>
        <view class="dish-row" wx:for="{{meal.dishGroups}}" wx:for-item="group" wx:key="type">
          <text class="type-badge type-{{group.type}}">{{group.label}}</text>
          <text class="dish-name">{{group.namesText}}</text>
        </view>
      </view>
      <view wx:if="{{item.ingredientTipText}}" class="plan-ings">
        <image class="plan-ings-icon" src="/assets/images/icons/basket-green-outline.png" mode="aspectFit" aria-hidden="true"/>
        <text class="plan-ings-text">{{item.ingredientTipText}}</text>
      </view>
    </view>
    <view class="scroll-end-pad"></view>
  </block>
  </view>

  <view class="fab-stack {{fabDimmed ? 'fab-dimmed' : ''}}" wx:if="{{!empty}}">
    <button
      class="fab fab-swap"
      disabled="{{busy || fabDimmed}}"
      bindtap="onSwap"
    >换一批</button>
    <button
      class="fab fab-reject"
      disabled="{{busy || fabDimmed}}"
      bindtap="onRejectOpen"
    >不行</button>
  </view>

  <view class="footer">
    <button class="btn-outline" bindtap="onBack">返回</button>
  </view>

  <view
    class="mask"
    wx:if="{{showReject}}"
    catchtouchmove="true"
    bindtap="onRejectClose"
  >
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">不太合适的原因（可选）</view>
      <view
        class="reason"
        wx:for="{{rejectReasons}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onRejectReason"
      >{{item.label}}</view>
      <view class="sheet-actions">
        <button size="mini" class="btn-outline" bindtap="onRejectSkip">跳过</button>
        <button size="mini" class="btn-outline" bindtap="onRejectClose">取消</button>
      </view>
    </view>
  </view>

  <view
    class="mask mask-center mask-lite"
    wx:if="{{showQuickLite}}"
    catchtouchmove="true"
    bindtap="onQuickLiteClose"
  >
    <view class="lite-dialog" catchtap="noop" catchtouchmove="true">
      <profile-lite-form
        show-none-avoids="{{true}}"
        show-city="{{quickLiteNeedCity}}"
        primary-text="保存"
        secondary-text="取消"
        bind:save="onQuickLiteSave"
        bind:skip="onQuickLiteClose"
        bind:noneavoids="onQuickLiteNone"
      />
    </view>
  </view>

  <view
    class="mask mask-center"
    wx:if="{{showEmptyDialog}}"
    catchtouchmove="true"
    bindtap="onEmptyDialogOk"
  >
    <view class="dialog" catchtap="noop">
      <view class="dialog-title">食材不够出菜了</view>
      <view class="dialog-actions">
        <button class="dialog-btn" hover-class="button-hover" bindtap="onEmptyDialogOk">好吧</button>
      </view>
    </view>
  </view>
</view>
