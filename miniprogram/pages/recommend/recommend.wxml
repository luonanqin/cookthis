<view class="page {{typeScaleClass}}">
  <view
    wx:if="{{showProfileBanner}}"
    class="profile-banner"
    bindtap="onOpenQuickLite"
  >补一下家庭忌口，少推不能吃的</view>

  <view wx:if="{{empty}}" class="empty">
    <text class="empty-text">{{emptyText}}</text>
  </view>

  <block wx:else>
    <view wx:if="{{sceneSummary}}" class="scene-bar">{{sceneSummary}}</view>
    <view class="plan" wx:for="{{plans}}" wx:key="planIndex">
      <view class="plan-head">
        <view class="plan-title">方案 {{item.planIndex + 1}}<text wx:if="{{item.planKind && item.planKind !== 'home'}}" class="kind"> · {{item.planKind}}</text></view>
        <button
          size="mini"
          type="primary"
          class="plan-accept"
          disabled="{{busy}}"
          data-plan-index="{{item.planIndex}}"
          bindtap="onAccept"
        >去买菜</button>
      </view>
      <view class="meal" wx:for="{{item.meals}}" wx:for-item="meal" wx:key="slot">
        <view class="meal-label">{{meal.slot.label || meal.slot.meal}}</view>
        <view class="dish-group" wx:for="{{meal.dishGroups}}" wx:for-item="group" wx:key="type">
          <view class="group-label">{{group.label}}</view>
          <view class="dish-grid">
            <view class="dish" wx:for="{{group.dishes}}" wx:for-item="dish" wx:key="recipeId">
              <text class="dish-mark">·</text><text class="dish-name">{{dish.name}}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{item.ingredientTipText}}" class="plan-ings">{{item.ingredientTipText}}</view>
    </view>
    <!-- 滚到底时把末卡「去买菜 / 食材」顶到悬浮钮上方 -->
    <view class="scroll-end-pad"></view>
  </block>

  <view class="fab-stack {{fabDimmed ? 'fab-dimmed' : ''}}" wx:if="{{!empty}}">
    <button
      class="fab fab-swap"
      disabled="{{busy}}"
      bindtap="onSwap"
    >换一批</button>
    <button
      class="fab fab-reject"
      disabled="{{busy}}"
      bindtap="onRejectOpen"
    >不行</button>
  </view>

  <view class="footer">
    <button class="btn-outline" bindtap="onBack">返回改场景</button>
  </view>

  <view class="mask" wx:if="{{showReject}}" catchtouchmove="true">
    <view class="sheet">
      <view class="sheet-title">不太合适的原因（可选）</view>
      <view
        class="reason"
        wx:for="{{rejectReasons}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onRejectReason"
      >{{item.label}}</view>
      <view class="sheet-actions">
        <button size="mini" class="btn-outline" bindtap="onRejectSkip">跳过</button>
        <button size="mini" class="btn-outline" bindtap="onRejectClose">取消</button>
      </view>
    </view>
  </view>

  <view class="mask" wx:if="{{showQuickLite}}" catchtouchmove="true">
    <view class="sheet">
      <profile-lite-form
        show-none-avoids="{{true}}"
        primary-text="保存并刷新方案"
        secondary-text="取消"
        bind:save="onQuickLiteSave"
        bind:skip="onQuickLiteClose"
        bind:noneavoids="onQuickLiteNone"
      />
    </view>
  </view>

  <view class="mask mask-center" wx:if="{{showEmptyDialog}}" catchtouchmove="true">
    <view class="dialog">
      <view class="dialog-title">食材不够出菜了</view>
      <view class="dialog-actions">
        <button class="dialog-btn" hover-class="button-hover" bindtap="onEmptyDialogOk">好吧</button>
      </view>
    </view>
  </view>
</view>
