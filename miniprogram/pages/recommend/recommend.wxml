<page-meta page-style="{{showQuickLite ? 'overflow: hidden;' : ''}}" />
<view class="page {{typeScaleClass}}">
  <page-header title="推荐方案" subtitle="根据食材和要求进行搭配" />
  <view class="page-body recommend-body">
  <view
    wx:if="{{showProfileBanner}}"
    class="profile-banner"
    hover-class="tap-hover"
    hover-stay-time="80"
    bindtap="onOpenQuickLite"
  >
    <text>补充饮食偏好，让推荐更精准 </text>
    <text class="profile-banner-cta">点我</text>
  </view>

  <view wx:if="{{empty}}" class="empty">
    <text class="empty-text">{{emptyText}}</text>
  </view>

  <block wx:else>
    <view wx:if="{{sceneSummaryLine1}}" class="scene-bar">
      <image class="ui-icon ui-icon--sm" src="/assets/images/icons/group-people.png" mode="aspectFit" aria-hidden="true"/>
      <view class="scene-bar-text">
        <text class="scene-bar-line">{{sceneSummaryLine1}}</text>
        <text wx:if="{{sceneSummaryLine2}}" class="scene-bar-line">{{sceneSummaryLine2}}</text>
      </view>
      <text class="scene-bar-edit" hover-class="tap-hover" hover-stay-time="80" bindtap="onBack">修改 ></text>
    </view>
    <view class="plan" wx:for="{{plans}}" wx:key="planIndex">
      <view class="plan-head">
        <view class="plan-title">方案 {{item.planIndex + 1}}</view>
        <view class="plan-actions">
          <button
            wx:if="{{planShareEnabled}}"
            class="plan-share"
            size="mini"
            open-type="share"
            data-plan-index="{{item.planIndex}}"
            data-entry="recommend"
            hover-class="tap-hover"
            aria-label="分享"
          ><image class="ui-icon ui-icon--md" src="/assets/images/icons/share-export-green.png" mode="aspectFit" aria-hidden="true"/></button>
          <button
            size="mini"
            type="primary"
            class="plan-accept"
            disabled="{{busy}}"
            data-plan-index="{{item.planIndex}}"
            bindtap="onAccept"
          ><image class="ui-icon ui-icon--xs" src="/assets/images/icons/cart-white.png" mode="aspectFit" aria-hidden="true"/><text>去买菜</text></button>
        </view>
      </view>
      <view class="plan-body">
        <view class="meal" wx:for="{{item.meals}}" wx:for-item="meal" wx:key="mealKey">
          <view wx:if="{{item.meals.length > 1}}" class="meal-label">{{meal.slot.label || meal.slot.meal}}</view>
          <view class="dish-row" wx:for="{{meal.dishGroups}}" wx:for-item="group" wx:key="type">
            <text class="type-badge type-{{group.type}}">{{group.label}}</text>
            <view class="dish-names">
              <text
                class="dish-name"
                wx:for="{{group.dishes}}"
                wx:for-item="dish"
                wx:key="name"
              >{{dish.name}}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{item.ingredientTipText}}" class="plan-ings">
        <image class="plan-ings-icon" src="/assets/images/icons/basket-green-outline.png" mode="aspectFit" aria-hidden="true"/>
        <text class="plan-ings-text">{{item.ingredientTipText}}</text>
      </view>
    </view>
    <view class="scroll-end-tip" wx:if="{{plans.length}}">— 已经到底了 —</view>
  </block>
  </view>

  <view class="fab-stack {{fabDimmed ? 'fab-dimmed' : ''}}" wx:if="{{!empty}}">
    <button
      class="fab fab-reject"
      disabled="{{busy || fabDimmed}}"
      bindtap="onRejectOpen"
    >换 菜</button>
  </view>

  <view class="footer">
    <button class="btn-outline" bindtap="onBack">返回</button>
  </view>

  <view
    class="mask"
    wx:if="{{showReject}}"
    catchtouchmove="true"
    bindtap="onRejectClose"
  >
    <view class="sheet sheet-reject" catchtap="noop">
      <view class="reject-reason-row">
        <view
          class="reject-reason-chip {{rejectActiveReason === item.id ? 'on' : ''}}"
          wx:for="{{rejectReasons}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onRejectReasonTab"
        >{{item.label}}</view>
      </view>
      <scroll-view scroll-y class="reject-dish-scroll" wx:if="{{rejectDishGroups.length}}">
        <view
          class="reject-dish-row"
          wx:for="{{rejectDishGroups}}"
          wx:for-item="group"
          wx:key="type"
        >
          <text class="type-badge type-{{group.type}}">{{group.label}}</text>
          <view class="reject-dish-names">
            <view
              class="reject-dish-item {{dish.checked ? 'on' : ''}}"
              wx:for="{{group.dishes}}"
              wx:for-item="dish"
              wx:key="key"
              data-key="{{dish.key}}"
              bindtap="onRejectDishToggle"
            >
              <text class="reject-dish-name">{{dish.name}}</text>
              <text wx:if="{{dish.checked}}" class="reject-dish-x" aria-hidden="true">×</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view wx:else class="reject-dish-empty">当前方案暂无可标菜，可直接完成或跳过</view>
      <view class="sheet-actions">
        <button size="mini" class="btn-outline" bindtap="onRejectSkip">跳 过</button>
        <button size="mini" class="btn-outline" bindtap="onRejectDone">完 成</button>
        <button size="mini" class="btn-outline" bindtap="onRejectClose">取 消</button>
      </view>
    </view>
  </view>

  <view
    class="mask mask-center mask-lite"
    wx:if="{{showQuickLite}}"
    catchtouchmove="true"
    bindtap="onQuickLiteClose"
  >
    <view class="lite-dialog" catchtap="noop" catchtouchmove="true">
      <profile-lite-form
        show-none-avoids="{{true}}"
        show-city="{{quickLiteNeedCity}}"
        primary-text="保存"
        secondary-text="取消"
        bind:save="onQuickLiteSave"
        bind:skip="onQuickLiteClose"
        bind:noneavoids="onQuickLiteNone"
      />
    </view>
  </view>

  <view
    wx:if="{{showSwapCap}}"
    class="swap-cap-mask"
    catchtouchmove="true"
    bindtap="onSwapCapClose"
  >
    <view class="swap-cap-sheet" catchtap="noop">
      <view class="swap-cap-title">今日免费换菜已用完</view>
      <view class="swap-cap-desc">当前方案仍可去买菜</view>
      <button class="btn-main" bindtap="onSwapCapGoShopping">去买菜</button>
      <button class="btn-outline" bindtap="onSwapCapGoMember">开通会员，换菜不限次</button>
      <button class="btn-outline" bindtap="onSwapCapClose">关闭</button>
    </view>
  </view>

  <view
    class="mask mask-center"
    wx:if="{{showEmptyDialog}}"
    catchtouchmove="true"
    bindtap="onEmptyDialogOk"
  >
    <view class="dialog" catchtap="noop">
      <view class="dialog-title">食材不够出菜了</view>
      <view class="dialog-actions">
        <button class="dialog-btn" hover-class="button-hover" bindtap="onEmptyDialogOk">好吧</button>
      </view>
    </view>
  </view>

  <busy-overlay show="{{busy}}" />
</view>
