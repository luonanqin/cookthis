.page {
  padding: 24rpx 24rpx 200rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: #f7f7f7;
}
.hint {
  color: #888;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}
.empty {
  padding: 80rpx 24rpx;
  text-align: center;
}
.empty-text {
  color: #666;
  font-size: 28rpx;
}
.plan {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.plan-title {
  font-weight: 600;
  margin-bottom: 12rpx;
}
.meal {
  margin-top: 12rpx;
}
.meal-label {
  color: #666;
  font-size: 24rpx;
  margin-bottom: 6rpx;
}
.dish {
  font-size: 28rpx;
  line-height: 1.6;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-title {
  font-weight: 600;
  margin-bottom: 16rpx;
}
.reason {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 28rpx;
}
