.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.state {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #888;
  font-size: 28rpx;
  line-height: 1.6;
}

.plan {
  margin-bottom: 28rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
}

.plan-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 16rpx;
}

.meal {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #eee;
}

.meal:first-of-type {
  border-top: none;
  padding-top: 0;
}

.meal-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.dish {
  padding: 10rpx 0;
}

.dish-name {
  font-size: 30rpx;
  color: #222;
}

.footer-spacer {
  height: 200rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #f7f7f7;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.next-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 12rpx;
}
