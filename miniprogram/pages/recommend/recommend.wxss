.page {
  padding: 0;
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--color-bg);
}

.recommend-body {
  /* 底栏 + 右侧悬浮钮滚动余量 */
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.scroll-end-pad {
  height: 260rpx;
}

.scene-bar {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--color-primary-soft);
  border-radius: var(--radius-card);
  color: var(--color-text);
  font-size: var(--fs-md);
  line-height: 1.4;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.scene-bar-text {
  flex: 1;
  min-width: 0;
}

.scene-bar-edit {
  flex-shrink: 0;
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--color-primary);
}

.profile-banner {
  margin-bottom: 16rpx;
  padding: 8rpx 4rpx;
  color: var(--color-text-secondary, #888);
  font-size: var(--fs-sm);
  line-height: 1.4;
  text-align: center;
}

.profile-banner-cta {
  color: #e54d42;
  text-decoration: underline;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-text {
  color: var(--color-text-secondary);
  font-size: var(--fs-body);
}

.plan {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: 0 4rpx 20rpx rgba(39, 51, 46, 0.05);
}

.plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.plan-title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-lead);
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.3;
}

.plan-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.plan-share {
  margin: 0 !important;
  width: 56rpx !important;
  min-width: 56rpx !important;
  height: 56rpx !important;
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  box-sizing: border-box !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  line-height: 1 !important;
}

.plan-accept {
  margin: 0 !important;
  width: auto !important;
  min-width: 0 !important;
  height: 56rpx !important;
  padding: 0 16rpx !important;
  box-sizing: border-box !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  line-height: 1.2 !important;
  font-size: var(--fs-sm) !important;
  font-weight: 600 !important;
  border-radius: var(--radius-btn) !important;
}

.plan-share::after,
.plan-accept::after {
  border: none !important;
}

.meal + .meal {
  margin-top: 20rpx;
}

.meal-label {
  display: inline-block;
  margin-bottom: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--color-primary-soft);
  color: var(--color-forest);
  font-size: var(--fs-sm);
  font-weight: 600;
  line-height: 1.4;
}

.dish-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 52rpx;
  margin-bottom: 10rpx;
}

.dish-row:last-child {
  margin-bottom: 0;
}

.type-badge {
  flex-shrink: 0;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-xs);
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.type-meat {
  background: #fbe6e1;
  color: #c56a55;
}

.type-veg {
  background: #edf5e3;
  color: #527f55;
}

.type-soup {
  background: #f8efd8;
  color: #b8893a;
}

.type-other {
  background: var(--color-surface-soft, #f3f1ea);
  color: var(--color-text-secondary);
}

.dish-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--color-text);
  font-weight: 500;
  line-height: 1.45;
  word-break: break-word;
}

.plan-ings {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--color-border);
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.plan-ings-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.plan-ings-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.fab-stack {
  position: fixed;
  right: 56rpx;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  z-index: 15;
  width: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: flex-start;
  transition: opacity 0.18s ease;
}

.fab-stack.fab-dimmed {
  opacity: 0.32;
  pointer-events: none;
}

.fab {
  margin: 0 !important;
  width: 96rpx !important;
  height: 96rpx !important;
  min-width: 0 !important;
  padding: 0 !important;
  font-size: var(--fs-xs) !important;
  line-height: 1.15 !important;
  border-radius: 50% !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  white-space: normal;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(26, 26, 26, 0.12);
  box-sizing: border-box;
}

.fab::after {
  border: none !important;
}

.fab-swap {
  background: var(--color-primary) !important;
  color: #fff !important;
  border: none !important;
}

.fab-reject {
  background: #fff7f0 !important;
  color: #b35c2e !important;
  border: 2rpx solid #d4835a !important;
}

.fab-swap.button-hover {
  background: var(--color-primary-pressed) !important;
}

.fab-reject.button-hover {
  background: #f0e0d4 !important;
}

.fab[disabled] {
  opacity: 0.45;
}

.large-text .fab {
  width: 112rpx !important;
  height: 112rpx !important;
  font-size: var(--fs-sm) !important;
}

.large-text .fab-stack {
  width: 132rpx;
}

.footer {
  z-index: 12;
}

.reason {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: var(--fs-body);
  color: var(--color-text);
}
